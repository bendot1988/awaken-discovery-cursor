# Local / Netlify environment variables for Mailchimp + Resend.
# Copy into Netlify → Site configuration → Environment variables.
# Never commit real secrets.

# --- Mailchimp (subscriber list + PDF automations) ---
# API key: Mailchimp → Account → Extras → API keys
# Looks like: xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
MAILCHIMP_API_KEY=

# Audience ID: Audience → Settings → Audience name and defaults → Audience ID
MAILCHIMP_AUDIENCE_ID=

# Optional separate audience for the teachers guide (falls back to MAILCHIMP_AUDIENCE_ID)
# MAILCHIMP_AUDIENCE_TEACHERS=

# Optional separate audience for the anxiety guide (falls back to MAILCHIMP_AUDIENCE_ID)
# MAILCHIMP_AUDIENCE_ANXIETY=

# Optional — usually auto-detected from the end of the API key (us21, us6, etc.)
# MAILCHIMP_SERVER_PREFIX=us21

# Optional — "subscribed" (default, immediate) or "pending" (double opt-in)
# MAILCHIMP_STATUS=subscribed

# --- Resend (emails the free PDF to the subscriber + notifies Ally) ---
# Required for sending the guide to the person who signed up.
# API key: https://resend.com/api-keys — mark as secret in Netlify
RESEND_API_KEY=

# IMPORTANT: onboarding@resend.dev can only send to your Resend account email.
# To email real subscribers, verify awakendiscovery.co.uk in Resend, then set e.g.:
#   Awaken Discovery <hello@awakendiscovery.co.uk>
RESEND_FROM=Awaken Discovery <onboarding@resend.dev>

# Where Ally gets notified (defaults to awakendiscoverytherapy@gmail.com if unset)
SIGNUP_NOTIFY_TO=awakendiscoverytherapy@gmail.com

# Optional site origin for PDF links (Netlify sets URL automatically on deploy)
# SITE_URL=https://awakendiscovery.co.uk
