# Local / Netlify environment variables for Sender newsletter signups.
# Copy values into Netlify → Site configuration → Environment variables.
# Never commit real secrets.

# API access token from Sender → Settings → API access tokens
SENDER_API_TOKEN=

# Group ID for "When You've Been Holding Too Much for Too Long"
# Find it in Sender → Subscribers → Groups → open the group → ID in the URL / settings
SENDER_GROUP_HOLDING_TOO_MUCH=
