# Local / Netlify environment variables for Sender + Resend.
# Copy into Netlify → Site configuration → Environment variables.
# Never commit real secrets.

# --- Sender (subscriber list + PDF automations) ---
# API access token: Sender → Settings → API access tokens
SENDER_API_TOKEN=

# Group ID for "When You've Been Holding Too Much for Too Long"
SENDER_GROUP_HOLDING_TOO_MUCH=

# --- Resend (admin notification email to Ally on each signup) ---
# API key: https://resend.com/api-keys — mark as secret in Netlify
RESEND_API_KEY=

# Where Ally gets notified (defaults to awakendiscoverytherapy@gmail.com if unset)
SIGNUP_NOTIFY_TO=awakendiscoverytherapy@gmail.com

# From address. Until your domain is verified in Resend, use:
#   Awaken Discovery <onboarding@resend.dev>
# (onboarding@resend.dev can only send to the email on your Resend account)
# After verifying awakendiscovery.co.uk, use e.g.:
#   Awaken Discovery <hello@awakendiscovery.co.uk>
RESEND_FROM=Awaken Discovery <onboarding@resend.dev>
