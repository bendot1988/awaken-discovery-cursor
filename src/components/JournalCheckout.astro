---
import type { DigitalProduct } from "../data/products";

interface Props {
	product: DigitalProduct;
	buttonClass?: string;
	buttonLabel?: string;
	fallbackHref?: string;
	fallbackLabel?: string;
	/** Kept for call-site compatibility; unused now that checkout is a single link. */
	dialogId?: string;
}

const {
	product,
	buttonClass = "cta cta-solid",
	buttonLabel = "Buy now",
	fallbackHref = "/contact",
	fallbackLabel = "Request access",
} = Astro.props;

const checkoutUrl = product.checkoutUrl || null;
---

{
	checkoutUrl ? (
		<a
			class={buttonClass}
			href={checkoutUrl}
			target="_blank"
			rel="noopener noreferrer"
		>
			{buttonLabel}
		</a>
	) : (
		<a class={buttonClass} href={fallbackHref}>
			{fallbackLabel}
		</a>
	)
}
