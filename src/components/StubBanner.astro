---
interface Props {
	message?: string;
}

const {
	message = "This page is being built. The full version is coming in the next session.",
} = Astro.props;
---

<aside class="stub-banner" role="note">
	<div class="container">
		<span class="stub-tag">In progress</span>
		<p>{message}</p>
	</div>
</aside>

<style>
	.stub-banner {
		background: rgb(0 94 71 / 8%);
		border-top: 1px solid rgb(0 94 71 / 18%);
		border-bottom: 1px solid rgb(0 94 71 / 18%);
		padding-block: 0.7rem;
	}

	.stub-banner .container {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1rem;
	}

	.stub-tag {
		display: inline-block;
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		background: var(--color-dark-slate-gray);
		color: var(--color-white);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.stub-banner p {
		margin: 0;
		font-size: 0.88rem;
	}
</style>
