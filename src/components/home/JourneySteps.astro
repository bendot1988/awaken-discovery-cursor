---
import type { JourneyStep } from "../../data/site";

interface Props {
	steps: JourneyStep[];
}

const { steps } = Astro.props;
---

<section class="journey section" id="journey">
	<div class="container">
		<header class="journey-header">
			<p class="section-kicker">The Journey</p>
			<h2>Your Path Towards Healing &amp; Emotional Clarity</h2>
		</header>

		<ol class="journey-grid">
			{
				steps.map((step) => (
					<li class="journey-step">
						<span class="step-num" aria-hidden="true">{step.number}</span>
						<h3>{step.title}</h3>
						<p>{step.body}</p>
					</li>
				))
			}
		</ol>

		<div class="journey-cta">
			<a class="cta cta-solid" href="/contact">Begin Your Journey</a>
		</div>
	</div>

	<figure class="journey-divider" aria-hidden="true">
		<img
			src="/assets/images/fern-divider.jpg"
			alt=""
			width="2048"
			height="408"
			loading="lazy"
			decoding="async"
		/>
	</figure>
</section>

<style>
	.journey {
		background: var(--color-white);
	}

	.journey-header {
		max-width: 60ch;
		margin-bottom: 2rem;
	}

	.section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--color-dark-slate-gray);
	}

	h2 {
		margin: 0.6rem 0 0;
		font-family: var(--font-serif);
		font-size: clamp(1.7rem, 3.3vw, 2.4rem);
		font-weight: 500;
	}

	.journey-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.2rem;
	}

	.journey-step {
		position: relative;
		background: linear-gradient(160deg, #f6f8f6 0%, #eaf0ea 100%);
		border: 1px solid rgb(0 94 71 / 14%);
		border-radius: 1rem;
		padding: 1.6rem 1.4rem 1.4rem;
	}

	.step-num {
		display: inline-block;
		font-family: var(--font-serif);
		font-size: 1.6rem;
		font-weight: 500;
		color: var(--color-dark-slate-gray);
		letter-spacing: 0.05em;
	}

	.journey-step h3 {
		margin: 0.45rem 0 0.6rem;
		font-family: var(--font-serif);
		font-size: 1.25rem;
		font-weight: 500;
	}

	.journey-step p {
		margin: 0;
		line-height: 1.75;
		font-size: 0.95rem;
	}

	.journey-cta {
		margin-top: 1.8rem;
	}

	.journey-divider {
		margin: 3rem 0 -4rem;
		padding: 0;
		overflow: hidden;
	}

	.journey-divider img {
		width: 100%;
		height: clamp(120px, 18vw, 220px);
		object-fit: cover;
		display: block;
	}

	@media (max-width: 900px) {
		.journey-grid {
			grid-template-columns: 1fr;
		}

		.journey-divider {
			margin-bottom: -3rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.journey-divider img {
			height: clamp(100px, 14vw, 180px);
		}
	}
</style>
