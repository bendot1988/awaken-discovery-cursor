---
interface Props {
	kicker?: string;
	heading?: string;
	subtitle?: string;
	body?: string;
	guideName?: string;
	guideDescription?: string;
	whatsInside?: string[];
	whatsInsideHeading?: string;
	filloutId: string;
	filloutHeight?: string;
	privacyText?: string;
	guideImage?: string;
	guideImageAlt?: string;
}

const {
	kicker = "Free Resource",
	heading = "Begin With Gentle Support",
	subtitle,
	body = "Download a free calming guide designed to help you better understand emotional overwhelm, reconnect with yourself and begin creating space to breathe again. You'll also receive gentle wellbeing insights, supportive resources and updates from Awaken Discovery.",
	guideName = "When You've Been Holding Too Much for Too Long",
	guideDescription = "A gentle guide to emotional overwhelm, self-reconnection and support.",
	whatsInside,
	whatsInsideHeading = "What's inside",
	filloutId,
	filloutHeight = "560px",
	privacyText,
	guideImage,
	guideImageAlt = "When You've Been Holding Too Much for Too Long — free gentle reflection guide",
} = Astro.props;

const showGuideCard = !whatsInside || whatsInside.length === 0;
const hasImage = Boolean(guideImage);
---

<section class="signup section section-soft" id="signup">
	<div class={`container signup-inner ${hasImage ? "signup-inner-visual" : ""}`}>
		{
			hasImage && (
				<figure class="signup-guide-media">
					<img
						src={guideImage}
						alt={guideImageAlt}
						loading="lazy"
						decoding="async"
					/>
				</figure>
			)
		}

		<div class="signup-content">
			<div class="signup-copy">
				<p class="section-kicker">{kicker}</p>
				<h2>{heading}</h2>
				{subtitle && <p class="signup-subtitle">{subtitle}</p>}
				<p>{body}</p>
				{
					whatsInside && whatsInside.length > 0 && (
						<div class="signup-whats-inside">
							<p class="whats-inside-heading">{whatsInsideHeading}</p>
							<ul class="whats-inside-list">
								{whatsInside.map((item) => (
									<li>
										<svg
											class="whats-inside-check"
											viewBox="0 0 24 24"
											aria-hidden="true"
											focusable="false"
										>
											<path
												d="M5 12.5l4.5 4.5L19 7.5"
												fill="none"
												stroke="currentColor"
												stroke-width="2.4"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
										<span>{item}</span>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</div>

			<div class="signup-form-slot">
				{
					showGuideCard && (
						<div class="signup-guide">
							<p class="guide-name">{guideName}</p>
							<p class="guide-desc">{guideDescription}</p>
						</div>
					)
				}
				<div
					class="fillout-embed"
					style={`width:100%;height:${filloutHeight};`}
					data-fillout-id={filloutId}
					data-fillout-embed-type="standard"
					data-fillout-inherit-parameters
					data-fillout-dynamic-resize
				>
				</div>
				{
					privacyText ? (
						<p class="signup-privacy">{privacyText}</p>
					) : (
						<p class="signup-privacy">
							Your details are handled with care. See our{" "}
							<a href="/privacy">Privacy Policy</a>.
						</p>
					)
				}
			</div>
		</div>
	</div>
</section>

<script is:inline async src="https://server.fillout.com/embed/v1/"></script>

<style>
	.signup {
		background: linear-gradient(180deg, var(--color-white-smoke) 0%, #eaf0ea 100%);
	}

	.signup-inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(1.6rem, 3vw, 2.4rem);
		align-items: start;
	}

	.signup-inner-visual {
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(2rem, 4vw, 3.5rem);
		align-items: stretch;
	}

	.signup-guide-media {
		margin: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		align-self: stretch;
		width: min(100%, 22rem);
		justify-self: center;
		min-height: 100%;
	}

	.signup-guide-media img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
		filter: drop-shadow(0 18px 32px rgb(29 35 39 / 14%));
	}

	.signup-content {
		display: grid;
		gap: 1.25rem;
		min-width: 0;
	}

	.signup-copy {
		max-width: 54ch;
	}

	.section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--color-dark-slate-gray);
	}

	h2 {
		margin: 0.55rem 0 0.4rem;
		font-family: var(--font-serif);
		font-size: clamp(1.7rem, 3.3vw, 2.35rem);
		font-weight: 500;
		line-height: 1.18;
		text-wrap: balance;
	}

	.signup-subtitle {
		margin: 0 0 0.85rem;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		color: var(--color-dark-slate-gray);
		opacity: 0.92;
		line-height: 1.4;
	}

	.signup-copy > p {
		margin: 0;
		line-height: 1.75;
	}

	.signup-whats-inside {
		margin-top: 1.1rem;
		padding: 1.1rem 1.2rem 1.2rem;
		background: var(--color-white);
		border-radius: 0.85rem;
		border: 1px solid rgb(0 94 71 / 18%);
	}

	.whats-inside-heading {
		margin: 0 0 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--color-dark-slate-gray);
		line-height: 1.2;
	}

	.whats-inside-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.5rem;
	}

	.whats-inside-list li {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: start;
		gap: 0.55rem;
		line-height: 1.55;
		color: var(--ink-soft);
	}

	.whats-inside-check {
		width: 1.1rem;
		height: 1.1rem;
		flex-shrink: 0;
		color: var(--brand);
		margin-top: 0.18rem;
	}

	.signup-form-slot {
		display: grid;
		gap: 0.85rem;
	}

	.signup-guide {
		margin: 0;
		padding: 1rem 1.15rem;
		background: var(--color-white);
		border-radius: 0.75rem;
		border: 1px solid rgb(0 94 71 / 18%);
		box-shadow: 0 8px 20px rgb(29 35 39 / 6%);
	}

	.guide-name {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.08rem;
		font-weight: 500;
		color: var(--color-dark-slate-gray);
		line-height: 1.3;
	}

	.guide-desc {
		margin: 0.3rem 0 0;
		font-size: 0.92rem;
		line-height: 1.55;
		opacity: 0.85;
	}

	.fillout-embed {
		background: var(--color-white);
		border-radius: 1rem;
		border: 1px solid rgb(0 94 71 / 18%);
		box-shadow: 0 10px 28px rgb(29 35 39 / 8%);
		overflow: hidden;
	}

	.signup-privacy {
		margin: 0;
		font-size: 0.8rem;
		line-height: 1.5;
		opacity: 0.78;
	}

	.signup-privacy a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (max-width: 900px) {
		.signup-inner-visual {
			grid-template-columns: 1fr;
			justify-items: center;
		}

		.signup-guide-media {
			width: min(100%, 16rem);
			order: -1;
		}

		.signup-content {
			width: 100%;
		}

		.signup-copy {
			max-width: none;
			text-align: center;
		}

		.signup-whats-inside {
			text-align: left;
		}
	}
</style>
