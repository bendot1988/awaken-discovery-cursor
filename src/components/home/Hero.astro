---
import { freeResources, freeResourcesPath } from "../../data/site";
import { calendlyLinks } from "../../data/calendly";

interface Props {
	videoSrc?: string;
	posterSrc?: string;
}

const { videoSrc, posterSrc = "/assets/images/hero-ally.png" } = Astro.props;
---

<section class="hero section">
	<div class="container hero-grid">
		<div class="hero-shell">
			<p class="eyebrow">Awaken Discovery — Counselling &amp; Psychotherapy</p>
			<h1>Counselling For When Life Feels Heavy — You Do Not Have to Carry It Alone</h1>
			<p class="subheadline">
				Compassionate counselling and emotional wellbeing support for anxiety, burnout,
				overwhelm and life's emotional challenges.
			</p>
			<p class="secondary-heading">
				Rediscover balance through compassionate emotional support
			</p>
			<p class="supporting">
				You do not have to keep carrying everything alone. Therapy can help you reconnect
				with yourself beneath the stress, anxiety and emotional pressure life can bring.
				When overwhelm begins to feel heavy, it can become difficult to find space to
				simply breathe. Awaken Discovery offers compassionate counselling and practical
				resources to help you reconnect with calm, clarity and support.
			</p>

			<div class="cta-row">
				<a
					class="cta cta-solid"
					href={calendlyLinks.individual.sixtyFaceToFace}
					target="_blank"
					rel="noopener noreferrer"
				>
					Begin Therapy — Book a Session
				</a>
				<a
					class="cta cta-outline"
					href={calendlyLinks.tasterSession}
					target="_blank"
					rel="noopener noreferrer"
				>
					Book a Free Consultation
				</a>
				<div class="cta-dropdown">
					<a
						class="cta cta-ghost cta-dropdown-trigger"
						href={freeResourcesPath}
						aria-haspopup="menu"
					>
						Free Resources
						<svg
							class="cta-dropdown-caret"
							viewBox="0 0 12 12"
							width="12"
							height="12"
							aria-hidden="true"
							focusable="false"
						>
							<path
								d="M2 4l4 4 4-4"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								stroke-linejoin="round"
							></path>
						</svg>
					</a>
					<div class="cta-dropdown-menu" role="menu">
						{freeResources.map((resource) => (
							<a
								class="cta-dropdown-item"
								href={resource.href}
								role="menuitem"
							>
								<span class="cta-dropdown-eyebrow">{resource.audience}</span>
								<span class="cta-dropdown-title">{resource.title}</span>
							</a>
						))}
						<a
							class="cta-dropdown-item cta-dropdown-item-all"
							href={freeResourcesPath}
							role="menuitem"
						>
							View all free resources →
						</a>
					</div>
				</div>
			</div>

			<ul class="trust-strip" aria-label="Credentials">
				<li>✔ Online &amp; In-Person Sessions</li>
				<li>✔ Individuals · Couples · Young People</li>
				<li>✔ Integrative Humanistic Counselling</li>
			</ul>
			<ul class="trust-logos" aria-label="Accreditations">
				<li>
					<img
						src="/assets/logos/accredited-bacp.png"
						alt="BACP Registered Member 392865 — MBACP, Professional Standards Authority accredited register"
						loading="lazy"
						decoding="async"
					/>
				</li>
				<li>
					<img
						src="/assets/logos/accredited-ncps.png"
						alt="NCPS Accredited Registrant MNCPS (Acc.) — Professional Standards Authority accredited register"
						loading="lazy"
						decoding="async"
					/>
				</li>
				<li>
					<img
						src="/assets/logos/accredited-online-counselling.png"
						alt="Online & Telephone Counselling Certified Counsellor"
						loading="lazy"
						decoding="async"
					/>
				</li>
			</ul>
		</div>

		<div class="hero-media">
			<div class="hero-video-frame" aria-hidden={videoSrc ? undefined : "true"}>
				{videoSrc ? (
					<video
						class="hero-video"
						src={videoSrc}
						poster={posterSrc}
						autoplay
						muted
						loop
						playsinline
					></video>
				) : (
					<img
						src={posterSrc}
						alt="Ally — counsellor and psychotherapist, smiling in a calm sage-green office"
						width="682"
						height="1024"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
				)}
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		--brand-green: var(--color-dark-slate-gray);
		--brand-green-deep: #004836;
		padding-block: clamp(4rem, 9vh, 7rem);
		background: linear-gradient(180deg, var(--color-white) 0%, #f6f8f6 100%);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: clamp(2rem, 4vw, 4rem);
		align-items: center;
	}

	.hero-shell {
		max-width: 690px;
	}

	.eyebrow {
		margin: 0;
		color: var(--brand-green);
		font-weight: 500;
		letter-spacing: 0.08em;
		font-size: 0.82rem;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.7rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 4.6vw, 3.4rem);
		font-weight: 500;
		line-height: 1.14;
		text-wrap: balance;
	}

	.subheadline {
		margin: 0;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.7;
		max-width: 60ch;
	}

	.secondary-heading {
		margin: 1.4rem 0 0;
		font-family: var(--font-serif);
		font-size: clamp(1.15rem, 2vw, 1.5rem);
		font-style: italic;
		color: var(--brand-green);
	}

	.supporting {
		margin: 0.7rem 0 0;
		max-width: 62ch;
		line-height: 1.85;
		font-size: 0.98rem;
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.7rem;
		margin-top: 1.8rem;
	}

	.cta-ghost {
		background: transparent;
		color: var(--brand-green);
		border: 1px solid transparent;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* ---------- Free Resources hover dropdown ---------- */
	.cta-dropdown {
		position: relative;
	}

	.cta-dropdown-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.cta-dropdown-caret {
		transition: transform 0.2s ease;
		flex-shrink: 0;
	}

	.cta-dropdown:hover .cta-dropdown-caret,
	.cta-dropdown:focus-within .cta-dropdown-caret {
		transform: rotate(180deg);
	}

	.cta-dropdown-menu {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 0;
		min-width: 280px;
		padding: 0.5rem;
		background: var(--color-white);
		border-radius: 0.85rem;
		box-shadow: 0 14px 40px rgb(29 35 39 / 16%), 0 1px 0 rgb(0 0 0 / 4%);
		opacity: 0;
		visibility: hidden;
		transform: translateY(6px);
		transition:
			opacity 0.18s ease,
			transform 0.18s ease,
			visibility 0.18s ease;
		z-index: 20;
	}

	.cta-dropdown:hover .cta-dropdown-menu,
	.cta-dropdown:focus-within .cta-dropdown-menu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	/* Invisible bridge so the menu doesn't snap shut between trigger and menu */
	.cta-dropdown::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		height: 0.5rem;
	}

	.cta-dropdown-item {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.65rem 0.85rem;
		border-radius: 0.6rem;
		color: var(--color-dark-gray);
		text-decoration: none;
		transition: background-color 0.15s ease;
	}

	.cta-dropdown-item:hover,
	.cta-dropdown-item:focus-visible {
		background: #f6f8f6;
		outline: none;
	}

	.cta-dropdown-eyebrow {
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--brand-green);
	}

	.cta-dropdown-title {
		font-family: var(--font-serif);
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.3;
	}

	.cta-dropdown-item-all {
		margin-top: 0.25rem;
		padding-top: 0.75rem;
		border-top: 1px solid #e5ebe6;
		border-radius: 0.4rem 0.4rem 0.6rem 0.6rem;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--brand-green);
	}

	.trust-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		margin: 1.8rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.85rem;
		color: rgb(29 35 39 / 78%);
	}

	.trust-logos {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0.65rem;
		margin: 1.6rem 0 0;
		padding: 0;
		list-style: none;
	}

	.trust-logos li {
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-white);
		border-radius: 0.7rem;
		padding: 0.55rem 0.75rem;
		box-shadow: 0 4px 12px rgb(29 35 39 / 6%);
		min-width: 0;
	}

	.trust-logos img {
		height: 58px;
		width: auto;
		max-width: 100%;
		object-fit: contain;
		display: block;
	}

	@media (max-width: 640px) {
		.trust-logos {
			flex-wrap: wrap;
			gap: 0.6rem;
		}

		.trust-logos li {
			padding: 0.5rem 0.7rem;
		}

		.trust-logos img {
			height: 54px;
		}
	}

	.hero-media {
		position: relative;
	}

	.hero-video-frame {
		position: relative;
		border-radius: 1rem;
		overflow: hidden;
		box-shadow: 0 14px 35px rgb(29 35 39 / 14%);
		aspect-ratio: 4 / 5;
		background: var(--color-white-smoke);
	}

	.hero-video,
	.hero-video-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 28%;
	}

	@media (max-width: 1024px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}

		.hero-media {
			order: -1;
		}

		.hero-video-frame {
			aspect-ratio: 16 / 11;
		}
	}
</style>
