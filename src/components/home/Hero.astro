---
interface Props {
	videoSrc?: string;
	posterSrc?: string;
}

const { videoSrc, posterSrc = "/assets/images/hero-ally.png" } = Astro.props;
---

<section class="hero section">
	<div class="container hero-grid">
		<div class="hero-shell">
			<p class="eyebrow">Awaken Discovery — Counselling &amp; Psychotherapy</p>
			<h1>When Life Feels Heavy, You Do Not Have to Carry It Alone</h1>
			<p class="subheadline">
				Compassionate counselling and emotional wellbeing support for anxiety, burnout,
				overwhelm and life's emotional challenges.
			</p>
			<p class="secondary-heading">
				Rediscover balance through compassionate emotional support
			</p>
			<p class="supporting">
				You do not have to keep carrying everything alone. Therapy can help you reconnect
				with yourself beneath the stress, anxiety and emotional pressure life can bring.
				When overwhelm begins to feel heavy, it can become difficult to find space to
				simply breathe. Awaken Discovery offers compassionate counselling and practical
				resources to help you reconnect with calm, clarity and support.
			</p>

			<div class="cta-row">
				<a class="cta cta-solid" href="/contact">Book a Free Consultation</a>
				<a class="cta cta-outline" href="/contact">Begin Therapy — Book a Session</a>
				<a class="cta cta-ghost" href="/teachers">Support for Teachers</a>
				<a class="cta cta-ghost" href="/anxiety">Anxiety Support</a>
			</div>

			<ul class="trust-strip" aria-label="Credentials">
				<li>✔ MBACP Registered</li>
				<li>✔ Online &amp; In-Person Sessions</li>
				<li>✔ Individuals · Couples · Young People</li>
				<li>✔ Integrative Humanistic Counselling</li>
			</ul>
			<p class="trust-todo">{`{{TODO: accreditation logos}}`}</p>
		</div>

		<div class="hero-media">
			<div class="hero-video-frame" aria-hidden={videoSrc ? undefined : "true"}>
				{videoSrc ? (
					<video
						class="hero-video"
						src={videoSrc}
						poster={posterSrc}
						autoplay
						muted
						loop
						playsinline
					></video>
				) : (
					<>
						<img
							src={posterSrc}
							alt="Ally — counsellor and psychotherapist, smiling in a calm sage-green office"
							width="682"
							height="1024"
							loading="eager"
							decoding="async"
							fetchpriority="high"
						/>
						<p class="video-placeholder-label">
							{`{{TODO: calming hero video — stock or client supplied}}`}
						</p>
					</>
				)}
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		--brand-green: var(--color-dark-slate-gray);
		--brand-green-deep: #004836;
		padding-block: clamp(4rem, 9vh, 7rem);
		background: linear-gradient(180deg, var(--color-white) 0%, #f6f8f6 100%);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.05fr 0.95fr;
		gap: clamp(2rem, 4vw, 4rem);
		align-items: center;
	}

	.hero-shell {
		max-width: 690px;
	}

	.eyebrow {
		margin: 0;
		color: var(--brand-green);
		font-weight: 500;
		letter-spacing: 0.08em;
		font-size: 0.82rem;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.7rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 4.6vw, 3.4rem);
		font-weight: 500;
		line-height: 1.14;
		text-wrap: balance;
	}

	.subheadline {
		margin: 0;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.7;
		max-width: 60ch;
	}

	.secondary-heading {
		margin: 1.4rem 0 0;
		font-family: var(--font-serif);
		font-size: clamp(1.15rem, 2vw, 1.5rem);
		font-style: italic;
		color: var(--brand-green);
	}

	.supporting {
		margin: 0.7rem 0 0;
		max-width: 62ch;
		line-height: 1.85;
		font-size: 0.98rem;
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.7rem;
		margin-top: 1.8rem;
	}

	.cta-ghost {
		background: transparent;
		color: var(--brand-green);
		border: 1px solid transparent;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.trust-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		margin: 1.8rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.85rem;
		color: rgb(29 35 39 / 78%);
	}

	.trust-todo {
		margin: 0.6rem 0 0;
		font-size: 0.75rem;
		font-style: italic;
		opacity: 0.55;
	}

	.hero-media {
		position: relative;
	}

	.hero-video-frame {
		position: relative;
		border-radius: 1rem;
		overflow: hidden;
		box-shadow: 0 14px 35px rgb(29 35 39 / 14%);
		aspect-ratio: 4 / 5;
		background: var(--color-white-smoke);
	}

	.hero-video,
	.hero-video-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 28%;
	}

	.video-placeholder-label {
		position: absolute;
		left: 0.75rem;
		bottom: 0.75rem;
		margin: 0;
		padding: 0.35rem 0.7rem;
		background: rgb(0 0 0 / 55%);
		color: var(--color-white);
		font-size: 0.72rem;
		border-radius: 999px;
	}

	@media (max-width: 1024px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}

		.hero-media {
			order: -1;
		}

		.hero-video-frame {
			aspect-ratio: 16 / 11;
		}
	}
</style>
