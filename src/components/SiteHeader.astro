---
import type { NavItem } from "../data/site";
import { calendlyLinks } from "../data/calendly";

interface Props {
	navItems: NavItem[];
}

const { navItems } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href: string) => {
	const normalized = href.replace(/\/$/, "") || "/";
	return normalized === currentPath;
};

const isBranchActive = (item: NavItem) => {
	if (isActive(item.href)) return true;
	return item.children?.some((c) => isActive(c.href)) ?? false;
};
---

<header class="site-header">
	<div class="container header-inner">
	<a href="/" class="brand" aria-label="Awaken Discovery home">
		<img
			src="/assets/logos/awaken-discovery-wordmark.png"
			alt="Awaken Discovery"
			width="1020"
			height="247"
		/>
	</a>

		<nav class="desktop-nav" aria-label="Primary">
			<ul class="nav-list">
				{
					navItems.map((item) =>
						item.children && item.children.length > 0 ? (
							<li class="nav-item has-submenu">
								<a
									href={item.href}
									class="nav-link nav-link-trigger"
									aria-haspopup="menu"
									aria-current={isBranchActive(item) ? "page" : undefined}
								>
									{item.label}
									<svg
										class="nav-caret"
										viewBox="0 0 12 12"
										width="12"
										height="12"
										aria-hidden="true"
										focusable="false"
									>
										<path
											d="M2.5 4.5l3.5 3.5 3.5-3.5"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</a>
								<ul class="nav-submenu" role="menu">
									{item.children.map((child) => (
										<>
											<li role="none">
												<a
													href={child.href}
													role="menuitem"
													class="nav-submenu-link"
													aria-current={
														isActive(child.href) ? "page" : undefined
													}
												>
													{child.label}
												</a>
											</li>
											{child.dividerAfter && (
												<li
													class="nav-submenu-divider"
													role="separator"
													aria-hidden="true"
												/>
											)}
										</>
									))}
								</ul>
							</li>
						) : (
							<li class="nav-item">
								<a
									href={item.href}
									class="nav-link"
									aria-current={isActive(item.href) ? "page" : undefined}
								>
									{item.label}
								</a>
							</li>
						)
					)
				}
			</ul>
		</nav>

		<div class="header-actions">
			<a class="cta cta-outline header-cta header-cta-secondary" href="/free-resources">
				Free Resources
			</a>
			<a
				class="cta cta-solid header-cta"
				href={calendlyLinks.individual.sixtyFaceToFace}
				target="_blank"
				rel="noopener noreferrer"
			>
				Book a Session
			</a>
		</div>

		<details class="mobile-menu">
			<summary aria-label="Toggle menu">Menu</summary>
			<nav aria-label="Mobile">
				<ul>
					{
						navItems.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={isActive(item.href) ? "page" : undefined}
								>
									{item.label}
								</a>
								{item.children && item.children.length > 0 && (
									<ul class="mobile-submenu">
										{item.children.map((child) => (
											<>
												<li>
													<a
														href={child.href}
														aria-current={
															isActive(child.href) ? "page" : undefined
														}
													>
														{child.label}
													</a>
												</li>
												{child.dividerAfter && (
													<li
														class="mobile-submenu-divider"
														role="separator"
														aria-hidden="true"
													/>
												)}
											</>
										))}
									</ul>
								)}
							</li>
						))
					}
					<li>
						<a class="mobile-cta mobile-cta-secondary" href="/free-resources">
							Free Resources
						</a>
					</li>
					<li>
						<a
							class="mobile-cta"
							href={calendlyLinks.individual.sixtyFaceToFace}
							target="_blank"
							rel="noopener noreferrer"
						>
							Book a Session
						</a>
					</li>
				</ul>
			</nav>
		</details>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgb(255 255 255 / 95%);
		border-bottom: 1px solid var(--color-gainsboro);
		backdrop-filter: blur(8px);
	}

	.header-inner {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 1rem;
		align-items: center;
		padding-block: 0.7rem;
	}

	.brand img {
		width: min(220px, 40vw);
	}

	.desktop-nav {
		justify-self: center;
	}

	.nav-list {
		display: flex;
		gap: 1rem;
		align-items: center;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.84rem;
		font-weight: 400;
		text-transform: capitalize;
	}

	.nav-item {
		position: relative;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--color-dark-gray);
		padding-block: 0.3rem;
		border-bottom: 1px solid transparent;
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.nav-link:hover,
	.nav-link:focus-visible {
		color: var(--color-dark-slate-gray);
	}

	.nav-link[aria-current="page"] {
		color: var(--color-dark-slate-gray);
		border-bottom-color: var(--color-dark-slate-gray);
	}

	.nav-caret {
		width: 0.7rem;
		height: 0.7rem;
		transition: transform 0.2s ease;
	}

	.has-submenu:hover .nav-caret,
	.has-submenu:focus-within .nav-caret {
		transform: rotate(-180deg);
	}

	/* ---------- DROPDOWN ---------- */
	.nav-submenu {
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%) translateY(0.4rem);
		min-width: 240px;
		margin: 0;
		padding: 0.4rem;
		list-style: none;
		background: var(--color-white);
		border: 1px solid rgb(0 94 71 / 16%);
		border-radius: 0.7rem;
		box-shadow: 0 18px 36px rgb(0 94 71 / 14%);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
		z-index: 21;
	}

	.nav-submenu-divider {
		height: 1px;
		margin: 0.35rem 0.55rem;
		background: rgb(0 94 71 / 14%);
	}

	.has-submenu:hover .nav-submenu,
	.has-submenu:focus-within .nav-submenu {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateX(-50%) translateY(0);
	}

	/* Invisible bridge so the dropdown doesn't close when crossing the gap */
	.has-submenu::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		height: 0.6rem;
	}

	.nav-submenu-link {
		display: block;
		padding: 0.55rem 0.85rem;
		border-radius: 0.45rem;
		font-size: 0.88rem;
		color: var(--color-dark-gray);
		white-space: nowrap;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.nav-submenu-link:hover,
	.nav-submenu-link:focus-visible {
		background: rgb(0 94 71 / 8%);
		color: var(--color-dark-slate-gray);
		outline: none;
	}

	.nav-submenu-link[aria-current="page"] {
		background: rgb(0 94 71 / 12%);
		color: var(--color-dark-slate-gray);
		font-weight: 500;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		justify-self: end;
	}

	.header-cta {
		padding: 0.6rem 1.05rem;
		font-size: 0.82rem;
		white-space: nowrap;
	}

	.header-cta-secondary:hover,
	.header-cta-secondary:focus-visible {
		background: var(--brand-tint, rgb(0 94 71 / 8%));
	}

	.mobile-menu {
		display: none;
		position: relative;
	}

	.mobile-menu summary {
		list-style: none;
		cursor: pointer;
		font-size: 0.85rem;
		font-weight: 500;
		text-transform: uppercase;
	}

	.mobile-menu nav {
		position: absolute;
		right: 0;
		top: calc(100% + 0.5rem);
		width: min(280px, 90vw);
		padding: 1rem;
		background: var(--color-white);
		border: 1px solid var(--color-gainsboro);
		border-radius: 0.7rem;
		box-shadow: 0 10px 26px rgb(0 0 0 / 12%);
	}

	.mobile-menu ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.mobile-menu li + li {
		margin-top: 0.7rem;
	}

	.mobile-submenu {
		margin-top: 0.5rem !important;
		padding-left: 0.9rem !important;
		border-left: 2px solid rgb(0 94 71 / 18%);
	}

	.mobile-submenu li + li {
		margin-top: 0.5rem;
	}

	.mobile-submenu a {
		font-size: 0.9rem;
		color: rgb(29 35 39 / 78%);
	}

	.mobile-submenu-divider {
		height: 1px;
		margin: 0.5rem 0 !important;
		background: rgb(0 94 71 / 18%);
		list-style: none;
	}

	.mobile-menu a[aria-current="page"] {
		color: var(--color-dark-slate-gray);
		font-weight: 600;
	}

	.mobile-cta {
		display: inline-block;
		margin-top: 0.5rem;
		padding: 0.5rem 0.9rem;
		border-radius: 999px;
		background: var(--color-dark-slate-gray);
		color: var(--color-white);
		font-size: 0.85rem;
		border: 1px solid var(--color-dark-slate-gray);
	}

	.mobile-cta-secondary {
		background: transparent;
		color: var(--color-dark-slate-gray);
	}

	@media (max-width: 1024px) {
		.desktop-nav,
		.header-actions {
			display: none;
		}

		.mobile-menu {
			display: block;
			justify-self: end;
		}

		.header-inner {
			grid-template-columns: auto 1fr;
		}
	}
</style>
