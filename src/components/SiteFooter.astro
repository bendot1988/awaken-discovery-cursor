---
import { footerNavItems, freeResources, freeResourcesPath } from "../data/site";

interface Props {
	locations: string[];
	tagline?: string;
}

const {
	locations,
	tagline = "Compassionate support for anxiety, overwhelm and emotional healing.",
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-brand-stripe">
		<div class="container footer-brand-inner">
			<a href="/" class="footer-brand" aria-label="Awaken Discovery home">
				<img src="/assets/logos/awaken-discovery-logo.png" alt="Awaken Discovery logo" />
			</a>
			<p class="footer-tagline">{tagline}</p>
		</div>
	</div>

	<div class="container footer-main">
		<section class="footer-resources" aria-labelledby="footer-resources-heading">
			<h2 id="footer-resources-heading">
				<span>Free resources</span>
				<a class="footer-resources-link" href={freeResourcesPath}>
					See all →
				</a>
			</h2>
			<ul>
				{
					freeResources.map((resource) => (
						<li>
							<a class="footer-guide" href={resource.href}>
								<span class="footer-guide-tag">Free</span>
								<span class="footer-guide-text">
									<span class="footer-guide-title">{resource.title}</span>
									<span class="footer-guide-sub">{resource.footerSubtitle}</span>
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<nav class="footer-nav-wrap" aria-label="Footer">
			<ul class="footer-nav">
				{
					footerNavItems.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))
				}
			</ul>
		</nav>

		<section class="locations" aria-labelledby="locations-heading">
			<h2 id="locations-heading">Locations we cover</h2>
			<ul>
				{
					locations.map((location) => (
						<li>{location}</li>
					))
				}
			</ul>
		</section>
	</div>

	<div class="footer-legal">
		<div class="container legal-row">
			<p>
				<a href="/privacy">Privacy Policy</a> · <a href="/terms">Terms &amp; Conditions</a>
			</p>
			<p>© {year} Awaken Discovery · Web design by dotwall</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--color-dark-gray);
		color: var(--color-white);
	}

	.footer-main {
		padding: 2.5rem 0 2rem;
	}

	.footer-brand-stripe {
		background: var(--color-white);
		color: var(--color-dark-gray);
		padding: 2rem 0 1.6rem;
	}

	.footer-brand-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
	}

	.footer-brand {
		display: inline-flex;
	}

	.footer-brand img {
		width: min(260px, 55vw);
		display: block;
	}

	.footer-tagline {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.2rem, 2.2vw, 1.65rem);
		font-style: italic;
		line-height: 1.35;
		color: var(--color-dark-gray);
		white-space: nowrap;
	}

	.footer-resources {
		margin-top: 0;
	}

	.footer-resources h2 {
		margin: 0 0 0.85rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.85;
		display: flex;
		align-items: baseline;
		gap: 1rem;
	}

	.footer-resources-link {
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: none;
		text-decoration: underline;
		text-underline-offset: 3px;
		opacity: 0.85;
	}

	.footer-resources-link:hover,
	.footer-resources-link:focus-visible {
		opacity: 1;
	}

	.footer-resources ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.6rem;
	}

	.footer-guide {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.6rem 1rem 0.6rem 0.55rem;
		border-radius: 0.9rem;
		background: rgb(255 255 255 / 8%);
		border: 1px solid rgb(255 255 255 / 25%);
		font-size: 0.88rem;
		width: 100%;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.footer-guide:hover,
	.footer-guide:focus-visible {
		background: rgb(255 255 255 / 14%);
		border-color: rgb(255 255 255 / 55%);
	}

	.footer-guide-tag {
		display: inline-block;
		padding: 0.18rem 0.55rem;
		border-radius: 999px;
		background: var(--color-white);
		color: var(--color-dark-slate-gray);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		flex-shrink: 0;
	}

	.footer-guide-text {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		line-height: 1.35;
	}

	.footer-guide-title {
		font-family: var(--font-serif);
		font-size: 0.98rem;
		font-weight: 500;
	}

	.footer-guide-sub {
		font-size: 0.8rem;
		opacity: 0.82;
	}

	.footer-nav-wrap {
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid rgb(255 255 255 / 22%);
	}

	.footer-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 1.2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer-nav a {
		font-size: 0.88rem;
		opacity: 0.94;
		text-decoration: none;
	}

	.footer-nav a:hover,
	.footer-nav a:focus-visible {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.locations {
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(255 255 255 / 25%);
	}

	.locations h2 {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.85;
	}

	.locations ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1.1rem;
		margin: 0.85rem 0 0;
		padding: 0;
		list-style: none;
	}

	.locations li {
		font-size: 0.86rem;
	}

	.footer-legal {
		border-top: 1px solid rgb(255 255 255 / 20%);
		padding-block: 0.75rem;
	}

	.legal-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		justify-content: space-between;
	}

	.legal-row p {
		margin: 0;
		font-size: 0.78rem;
		opacity: 0.92;
	}

	.legal-row a:hover,
	.legal-row a:focus-visible {
		text-decoration: underline;
	}

	@media (max-width: 700px) {
		.footer-brand-stripe {
			padding: 1.6rem 0 1.3rem;
		}

		.footer-tagline {
			white-space: normal;
			max-width: 40ch;
			text-wrap: balance;
		}
	}
</style>
