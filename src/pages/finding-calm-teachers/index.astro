---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { locations, navItems } from "../../data/site";

const faqs = [
	{
		q: "Is the guide really free?",
		a: "Yes — completely free. No card, no trial, no catch. Pop your email in, the guide lands in your inbox, and you can read it whenever you have a quiet five minutes.",
	},
	{
		q: "How long does the guide take to read?",
		a: "About 15 minutes if you read it in one go. It's built to dip in and out of, and each technique inside takes under 60 seconds to actually do.",
	},
	{
		q: "I've tried mindfulness apps and they didn't work. Why is this different?",
		a: "Most apps assume you've got time and headspace to spare. You don't. This guide is built around what you can actually do between lessons, in the car, or in the staff toilet — when you're already running on empty.",
	},
	{
		q: "Do I need to be in therapy already?",
		a: "Not at all. The guide is for any teacher feeling overwhelmed. If you decide later you'd like one-to-one support, that option is there — but there's zero pressure.",
	},
	{
		q: "What if I'm thinking of leaving teaching — is this still for me?",
		a: "Especially for you. The guide isn't trying to keep you in the profession or push you out. It's about getting your nervous system steady enough that you can make that decision from clarity, not crisis.",
	},
	{
		q: "Will I get spammed with daily emails?",
		a: "No. After the guide arrives you'll get the occasional gentle, supportive email — written by a human, not a marketing funnel. Unsubscribe with one click any time.",
	},
];
---

<Layout
	title="Finding Calm in the Chaos · Free Guide for Teachers · Awaken Discovery"
	description="A free guide for overwhelmed teachers — gentle, body-aware tools to ground yourself in under 60 seconds when you're already running on empty."
>
	<SiteHeader navItems={navItems} />
	<main class="sl">
		<!-- ============== HERO ============== -->
		<section class="sl-hero section">
			<div class="container sl-hero-grid">
				<div class="sl-hero-copy">
					<p class="section-kicker">Free guide for overwhelmed teachers</p>
					<h1>
						If You're Lying Awake at 3 AM Dreading Monday… Crying in Your Car Before
						School… Or Quietly Fantasising About Quitting Teaching for Good —
					</h1>
					<p class="sl-promise">
						This free guide will show you how to survive the rest of this term
						without completely falling apart.
					</p>
					<div class="sl-hero-cta-row">
						<a class="cta cta-solid sl-cta" href="#claim">
							Yes — Send Me the Free Guide
						</a>
						<span class="sl-cta-note">Free PDF · arrives in 2 minutes</span>
					</div>
					<ul class="sl-hero-trust" aria-label="Credentials">
						<li>Ex-teacher</li>
						<li>MBACP Registered Counsellor</li>
						<li>20+ years in education</li>
						<li>Online · phone · in-person</li>
					</ul>
				</div>
				<figure class="sl-hero-figure">
					<img
						src="/assets/images/finding-calm-hero-ally.png"
						alt="Ally — ex-teacher, counsellor and psychotherapist — sitting calmly at her desk"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
					<figcaption class="sl-img-todo">
						{`{{IMAGE PROMPT: Warm, candid portrait of Ally — ex-teacher, now counsellor. Sage-toned therapy room, soft natural light, warm mug nearby. Friendly, not clinical.}}`}
					</figcaption>
				</figure>
			</div>
		</section>

		<!-- ============== STAT BAR ============== -->
		<aside class="sl-stats" aria-label="At a glance">
			<div class="container sl-stats-row">
				<div><strong>20+</strong><span>years in education</span></div>
				<div><strong>MBACP</strong><span>Registered Counsellor</span></div>
				<div><strong>Nervous-system</strong><span>aware therapy</span></div>
				<div><strong>UK-wide</strong><span>online &amp; in-person</span></div>
			</div>
		</aside>

		<!-- ============== EMPATHY CHECKLIST (image LEFT) ============== -->
		<section class="sl-check section section-soft">
			<div class="container sl-check-grid">
				<figure class="sl-check-figure">
					<img
						src="/assets/images/staff-room-truth-section.png"
						alt="A quiet, weary moment in an empty staffroom"
						loading="lazy"
						decoding="async"
					/>
					<figcaption class="sl-img-todo">
						{`{{IMAGE PROMPT: Teacher alone after hours — empty classroom or staffroom, pile of exercise books, lukewarm mug, low warm light. Exhausted, not despairing.}}`}
					</figcaption>
				</figure>
				<div class="sl-check-copy">
					<p class="section-kicker">Sound familiar?</p>
					<h2>If you're nodding along to any of these…</h2>
					<ul class="sl-check-list">
						<li>The Sunday-night dread that starts mid-Saturday.</li>
						<li>Panic rising in the stationery cupboard before period 4.</li>
						<li>Crying in the car park before you've even walked in.</li>
						<li>Working until 9pm and still feeling behind.</li>
						<li>Snapping at people you love because there's nothing left.</li>
						<li>Counting down the days to half-term, again.</li>
						<li>Pretending you're fine when colleagues ask.</li>
					</ul>
					<p class="sl-check-foot">
						You're not broken. You're not weak. And you're not the only one.
					</p>
				</div>
			</div>
		</section>

		<!-- ============== WHY DIFFERENT ============== -->
		<section class="sl-band section">
			<div class="container sl-prose">
				<p class="section-kicker">Here's the thing nobody in the staffroom says</p>
				<h2>Most "teacher wellbeing" programs are designed by people who've never taught.</h2>
				<p>They tell you to do yoga. To "practice self-care." To "set boundaries." To "just say no."</p>
				<p>
					Which is lovely advice — if you have a spare hour, a quiet room, and a
					nervous system that isn't already in the red.
				</p>
				<p class="sl-lead">You don't. So we're going to do this differently.</p>
				<p>
					I'm going to show you how to actually survive a difficult day — between
					lessons, in the car park, in the loo — without anyone noticing, without
					changing your timetable, and without adding one more thing to your to-do
					list.
				</p>
				<blockquote class="sl-quote">
					<p>
						Your anxiety isn't a sign that something is wrong with you. It's your
						body trying to protect you from a system that's broken.
					</p>
				</blockquote>
			</div>
		</section>

		<!-- ============== I WAS YOU (image RIGHT) ============== -->
		<section class="sl-band section section-soft">
			<div class="container sl-iwasyou-grid">
				<div class="sl-iwasyou-copy">
					<p class="section-kicker">I know — because I lived it</p>
					<h2>I was you.</h2>
					<p>
						The exhausted teacher who loved the kids but couldn't take one more data
						meeting, one more observation, one more initiative that added work
						without ever taking anything away.
					</p>
					<p>
						I left teaching because it was destroying my health. Honestly, probably
						worse than that.
					</p>
					<p>
						In the years since, I trained as a Counsellor and Psychotherapist
						specialising in anxiety — and I've worked with dozens of teachers who
						feel exactly the way you do right now:
					</p>
					<ul class="sl-bullets">
						<li>Teachers desperately trying to hold it together.</li>
						<li>Teachers who feel guilty for struggling when they "should" be grateful for a job.</li>
						<li>Teachers terrified they're going to have a breakdown in front of their Year 9s.</li>
					</ul>
					<p class="sl-lead">That's exactly who I built this guide for.</p>
				</div>
				<figure class="sl-iwasyou-figure">
					<img
						src="/assets/images/hero-ally.png"
						alt="Ally — counsellor and psychotherapist in her Market Weighton therapy room"
						loading="lazy"
						decoding="async"
					/>
					<figcaption class="sl-img-todo">
						{`{{IMAGE PROMPT: Second portrait of Ally — softer, slightly more "professional." In her Market Weighton therapy room, books and plants in soft focus behind. Could be writing in a notebook. Warm and trustworthy.}}`}
					</figcaption>
				</figure>
			</div>
		</section>

		<!-- ============== THE OFFER (content LEFT, mockup RIGHT) ============== -->
		<section class="sl-offer section" id="offer">
			<div class="container sl-offer-grid">
				<div class="sl-offer-copy">
					<p class="section-kicker">Your free guide</p>
					<h2>Finding Calm in the Chaos</h2>
					<p class="sl-sub">
						A teacher's guide to grounding yourself — even when you're already
						overwhelmed.
					</p>
					<ul class="sl-inside">
						<li>
							<strong>Ground yourself in under 60 seconds</strong> — between lessons,
							with 47 books to mark and a parent email churning in your stomach.
						</li>
						<li>
							<strong>Body-aware techniques nobody can see you doing</strong> — in
							the classroom, the staffroom, the car park.
						</li>
						<li>
							<strong>Why your anxiety gets WORSE in the holidays</strong> — and the
							quiet reason it happens.
						</li>
						<li>
							<strong>Spot burnout coming weeks before it lands</strong> — so you
							can act on the warning signs instead of being floored by them.
						</li>
						<li>
							<strong>Personal "anchors" you can return to mid-lesson</strong> —
							when a difficult conversation or pointless meeting has tipped you over.
						</li>
					</ul>
					<p class="sl-promise-small">
						Not about "fixing" you or making you a "better teacher." About surviving
						the system without sacrificing your mental health.
					</p>
					<a class="cta cta-solid sl-cta" href="#claim">
						Yes — Send Me the Free Guide
					</a>
				</div>

				<figure class="sl-mockup-wrap">
					<img
						class="sl-mockup-photo"
						src="/assets/images/finding-calm-guide-mockup.png"
						alt="Finding Calm in the Chaos — free guide for teachers, shown on a desk with a notebook and mug"
						width="768"
						height="1024"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			</div>
		</section>

		<!-- ============== TESTIMONIALS ============== -->
		<section class="sl-testimonials section section-soft">
			<div class="container">
				<header class="sl-section-head">
					<p class="section-kicker">What clients say</p>
					<h2>You're not the first to feel this way — and you're not alone in finding your feet again.</h2>
				</header>
				<div class="sl-test-grid">
					<blockquote class="sl-testimonial">
						<p>
							The counselling sessions have helped me untangle some of the emotions
							I've been carrying.
						</p>
						<footer>
							<span class="sl-test-name">Current client</span>
							<span class="sl-test-meta">Anonymised at client's request</span>
						</footer>
					</blockquote>
					<blockquote class="sl-testimonial">
						<p>
							I couldn't recommend Ally more highly. She has a kind, caring nature
							that makes it easy to talk to her. What makes her great is her
							ability to help me really clarify my thoughts — so I can express what
							I'm thinking and feeling.
						</p>
						<footer>
							<span class="sl-test-name">Current client</span>
							<span class="sl-test-meta">Anonymised at client's request</span>
						</footer>
					</blockquote>
				</div>
				<p class="sl-test-todo">
					{`{{TODO: lift teacher-specific testimonials when available. Current quotes are general counselling clients from the live site.}}`}
				</p>
			</div>
		</section>

		<!-- ============== IS THIS FOR YOU? ============== -->
		<section class="sl-band section">
			<div class="container">
				<header class="sl-section-head">
					<p class="section-kicker">Honest check</p>
					<h2>Is this guide for you?</h2>
				</header>
				<div class="sl-fit-grid">
					<article class="sl-fit-card sl-fit-yes">
						<h3>Yes — if you're…</h3>
						<ul>
							<li>A teacher (any phase, any subject) feeling close to the edge.</li>
							<li>Already trying "all the things" and quietly drowning anyway.</li>
							<li>Worried about looking weak if you ask for help.</li>
							<li>Not sure whether to stay, go, or just survive this term.</li>
							<li>Open to gentle, body-aware tools rather than rigid advice.</li>
						</ul>
					</article>
					<article class="sl-fit-card sl-fit-no">
						<h3>Probably not — if you…</h3>
						<ul>
							<li>Want a quick-fix productivity hack.</li>
							<li>Are looking for medical or clinical diagnosis.</li>
							<li>Need urgent crisis support right now (please call <a href="tel:116123">116 123</a> — Samaritans).</li>
							<li>Don't like the idea of slowing down, even for 60 seconds.</li>
						</ul>
					</article>
				</div>
			</div>
		</section>

		<!-- ============== NEXT STEPS ============== -->
		<section class="sl-band section section-soft">
			<div class="container">
				<header class="sl-section-head">
					<p class="section-kicker">Here's what happens next</p>
					<h2>Three steps. Less than five minutes.</h2>
				</header>
				<ol class="sl-steps">
					<li>
						<span class="sl-step-num">01</span>
						<h3>Drop your email</h3>
						<p>The guide lands in your inbox in the next two minutes.</p>
					</li>
					<li>
						<span class="sl-step-num">02</span>
						<h3>Try one technique</h3>
						<p>On your next hard day. Each one takes under 60 seconds.</p>
					</li>
					<li>
						<span class="sl-step-num">03</span>
						<h3>Notice the shift</h3>
						<p>What it feels like when you stop fighting your own nervous system.</p>
					</li>
				</ol>
			</div>
		</section>

		<!-- ============== CLAIM FORM (Ally photo LEFT, form RIGHT) ============== -->
		<section class="sl-claim section" id="claim">
			<div class="container sl-claim-grid">
				<figure class="sl-claim-figure">
					<img
						src="/assets/images/finding-calm-hero-ally.png"
						alt="Ally — counsellor and psychotherapist"
						loading="lazy"
						decoding="async"
					/>
					<figcaption class="sl-img-todo">
						{`{{IMAGE PROMPT: A small, warm portrait of Ally with a gentle, encouraging smile. Could reuse the hero portrait or a softer companion shot.}}`}
					</figcaption>
				</figure>

				<div class="sl-claim-copy">
					<p class="section-kicker">Yes — send me the guide</p>
					<h2>Finding Calm in the Chaos</h2>
					<p>
						Pop your email below. The PDF lands in your inbox in the next couple of
						minutes — read it whenever you next have a quiet five.
					</p>

					<form
						class="sl-form"
						method="post"
						action="#"
						aria-describedby="sl-form-todo"
						novalidate
					>
						<label class="sl-field">
							<span>Your email</span>
							<input
								type="email"
								name="email"
								autocomplete="email"
								required
								placeholder="you@school.com"
							/>
						</label>
						<label class="sl-consent">
							<input type="checkbox" name="consent" required />
							<span>
								Send me the guide and supportive wellbeing emails. I can
								unsubscribe any time.
							</span>
						</label>
						<button class="cta cta-solid sl-submit" type="submit">
							Send Me the Free Guide Now
						</button>
						<p class="sl-privacy">
							Your details are handled with care. See our
							<a href="/privacy">Privacy Policy</a>.
						</p>
						<p id="sl-form-todo" class="sl-img-todo">
							{`{{TODO: wire to ESP — auto-send PDF, trigger nurture sequence, redirect to /finding-calm-teachers/thank-you}}`}
						</p>
					</form>
				</div>
			</div>
		</section>

		<!-- ============== FAQ ============== -->
		<section class="sl-faq section section-soft">
			<div class="container">
				<header class="sl-section-head">
					<p class="section-kicker">FAQ</p>
					<h2>Questions teachers ask first</h2>
				</header>
				<div class="sl-faq-list">
					{
						faqs.map((item) => (
							<details class="sl-faq-item">
								<summary>
									<span>{item.q}</span>
									<span class="sl-faq-icon" aria-hidden="true">+</span>
								</summary>
								<div class="sl-faq-body">
									<p>{item.a}</p>
								</div>
							</details>
						))
					}
				</div>
			</div>
		</section>

		<!-- ============== CLOSING ============== -->
		<section class="sl-close section">
			<div class="container sl-close-inner">
				<p class="sl-close-line">You don't need to keep white-knuckling every term.</p>
				<p class="sl-close-line">You don't need to wait until half-term to breathe.</p>
				<p class="sl-close-line">You don't need to choose between your career and your sanity.</p>
				<p class="sl-close-signoff">
					Download the guide. Give yourself this moment. You deserve to feel calm
					again — even in the middle of the chaos.
				</p>
				<p class="sl-signature">— Ally</p>
				<a class="cta cta-solid sl-cta" href="#claim">
					Yes — Send Me the Free Guide
				</a>
			</div>
		</section>

		<!-- ============== P.S. ============== -->
		<section class="sl-ps-band section section-soft">
			<div class="container">
				<aside class="sl-ps">
					<p class="sl-ps-label">P.S.</p>
					<p>
						You became a teacher because you wanted to make a difference. But you
						can't pour from an empty cup. Let me help you find your way back to
						yourself — so you can keep doing the work you love without it destroying
						you.
					</p>
					<a class="cta cta-outline" href="#claim">Send Me the Free Guide</a>
				</aside>
			</div>
		</section>
	</main>
	<SiteFooter
		locations={locations}
		tagline="Helping overwhelmed teachers reconnect with themselves beyond survival mode."
	/>
</Layout>

<style>
	.sl {
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		--ink: var(--color-dark-gray);
		--ink-soft: rgb(29 35 39 / 78%);
	}

	.sl section.section {
		padding-block: clamp(3.5rem, 7vh, 5.5rem);
	}

	.sl :global(.section-soft) {
		background: linear-gradient(180deg, #f6f8f6 0%, var(--color-white-smoke) 100%);
	}

	.sl .section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--brand);
	}

	.sl h2 {
		margin: 0.55rem 0 1.1rem;
		font-family: var(--font-serif);
		font-size: clamp(1.8rem, 3.6vw, 2.6rem);
		font-weight: 500;
		line-height: 1.18;
		letter-spacing: -0.005em;
		text-wrap: balance;
		color: var(--ink);
	}

	.sl .sl-section-head {
		max-width: 60ch;
		margin-bottom: 1.8rem;
	}

	.sl p {
		line-height: 1.85;
	}

	.sl .sl-lead {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.2rem;
		color: var(--brand-deep);
		margin: 1.2rem 0;
	}

	.sl-img-todo {
		font-size: 0.7rem;
		font-style: italic;
		opacity: 0.55;
		line-height: 1.45;
		margin-top: 0.4rem;
	}

	.sl-cta {
		font-size: 1rem;
		padding: 0.95rem 1.5rem;
		box-shadow: 0 10px 22px rgb(0 94 71 / 24%);
		transition: transform 0.15s ease, background-color 0.2s ease, box-shadow 0.2s ease;
	}

	.sl-cta:hover,
	.sl-cta:focus-visible {
		background: var(--brand-deep);
		border-color: var(--brand-deep);
		transform: translateY(-1px);
		box-shadow: 0 14px 28px rgb(0 94 71 / 32%);
	}

	/* ---------- HERO ---------- */
	.sl-hero {
		background: linear-gradient(180deg, var(--color-white) 0%, #f6f8f6 100%);
	}

	.sl-hero-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	.sl-hero h1 {
		margin: 0.55rem 0 1.1rem;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 4.8vw, 3.3rem);
		font-weight: 500;
		line-height: 1.12;
		text-wrap: balance;
		letter-spacing: -0.005em;
	}

	.sl-promise {
		margin: 0 0 1.6rem;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(1.1rem, 2vw, 1.4rem);
		color: var(--brand-deep);
		max-width: 56ch;
		line-height: 1.5;
	}

	.sl-hero-cta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem 1.1rem;
	}

	.sl-cta-note {
		font-size: 0.88rem;
		color: var(--ink-soft);
		font-style: italic;
	}

	.sl-hero-trust {
		margin: 1.8rem 0 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.4rem;
		font-size: 0.85rem;
		color: var(--ink-soft);
	}

	.sl-hero-trust li {
		position: relative;
		padding-left: 1.1rem;
	}

	.sl-hero-trust li::before {
		content: "✓";
		position: absolute;
		left: 0;
		top: 0;
		color: var(--brand);
		font-weight: 700;
	}

	.sl-hero-figure {
		margin: 0;
	}

	.sl-hero-figure img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 50% 30%;
		border-radius: 1rem;
		box-shadow: 0 14px 35px rgb(29 35 39 / 14%);
	}

	/* ---------- STAT BAR ---------- */
	.sl-stats {
		background: var(--brand);
		color: var(--color-white);
		padding-block: 1.3rem;
	}

	.sl-stats-row {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		text-align: center;
	}

	.sl-stats-row div {
		display: grid;
		gap: 0.15rem;
	}

	.sl-stats-row strong {
		font-family: var(--font-serif);
		font-size: clamp(1.15rem, 1.8vw, 1.5rem);
		font-weight: 500;
	}

	.sl-stats-row span {
		font-size: 0.82rem;
		opacity: 0.85;
		letter-spacing: 0.04em;
	}

	/* ---------- EMPATHY CHECK ---------- */
	.sl-check-grid {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	.sl-check-figure {
		margin: 0;
	}

	.sl-check-figure img {
		width: 100%;
