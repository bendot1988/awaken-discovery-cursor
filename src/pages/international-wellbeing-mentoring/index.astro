---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import {
	locations,
	navItems,
	internationalWellbeingAgreementPath,
	internationalWellbeingBookingUrl,
	internationalWellbeingEnquiryUrl,
} from "../../data/site";

const exploreThemes = [
	{
		title: "Understanding yourself",
		body: "Self-awareness, patterns and behaviours, your needs, values and what matters to you, feeling disconnected from yourself.",
	},
	{
		title: "Everyday wellbeing",
		body: "Stress, overwhelm, feeling constantly 'on', rest and recovery, balance, habits and routines, self-care that actually works for you.",
	},
	{
		title: "Life and relationships",
		body: "Boundaries, confidence, communication, relationships, life transitions, change, feeling stuck, finding direction.",
	},
	{
		title: "Mind–body connection",
		body: "Becoming more aware of your body, grounding, reconnecting with yourself, and exploring the relationship between thoughts, emotions and physical experience.",
	},
];

const rightForYou = [
	"you're feeling overwhelmed by everyday life",
	"you're constantly looking after everyone else",
	"you've lost touch with yourself",
	"you're going through a life transition",
	"you're questioning what you really want",
	"you're struggling to create space for yourself",
	"you want to understand yourself better",
	"you want to develop greater self-awareness",
	"you're looking for practical ways to support your wellbeing",
	"you feel stuck but don't necessarily need therapy",
	"you want someone to help you think things through",
	"you simply want to invest in yourself",
];

const notIncluded = [
	"Counselling",
	"Psychotherapy",
	"Diagnosis",
	"Psychological treatment",
	"Medical treatment",
	"Medication advice",
	"Healthcare",
	"Crisis intervention",
];

const faqs = [
	{
		q: "What is international wellbeing mentoring?",
		a: "International wellbeing mentoring is a non-clinical online service that provides adults living outside the UK with a supportive space to explore wellbeing, self-awareness, personal development and meaningful life changes.",
	},
	{
		q: "Is wellbeing mentoring the same as counselling?",
		a: "No. Wellbeing mentoring is not counselling or psychotherapy. It is a non-clinical service focused on reflection, education, self-awareness and practical wellbeing.",
	},
	{
		q: "Can wellbeing mentoring help with stress and overwhelm?",
		a: "It can provide space to explore stress and overwhelm and consider practical approaches that may support your wellbeing. It does not diagnose or treat a mental-health condition.",
	},
	{
		q: "Is international wellbeing mentoring suitable if I have a mental-health condition?",
		a: "Wellbeing mentoring is not a replacement for clinical or specialist mental-health support. If you require treatment or specialist support, you should seek an appropriately qualified professional or healthcare service in your own country.",
	},
	{
		q: "Do I need to know what I want to work on?",
		a: "No. You can begin by talking about where you are and what you would like to be different. Together we can explore whether wellbeing mentoring is appropriate for you.",
	},
	{
		q: "Where do you provide international wellbeing mentoring?",
		a: "Sessions are provided online from the UK for adults who are physically located outside the UK. Your location matters because legal and professional requirements can differ between countries.",
	},
];
---

<Layout
	title="International Wellbeing Mentoring | Online Wellbeing Support | Awaken Discovery"
	description="International wellbeing mentoring for adults outside the UK. Online support for self-awareness, stress, overwhelm, confidence, life changes and whole-person wellbeing with Ally Donoghue."
>
	<SiteHeader navItems={navItems} />
	<main>
		<section class="iw-hero section">
			<div class="container hero-grid">
				<div class="hero-shell">
					<p class="eyebrow">International · Online</p>
					<h1>International Wellbeing Mentoring</h1>
					<p class="hero-title">
						Come Home to Yourself — wherever you are in the world.
					</p>
					<p class="subheadline">
						A space to pause, understand yourself and explore what wellbeing
						means for you.
					</p>
					<p class="subheadline">
						Online wellbeing mentoring for adults around the world who want to
						develop greater self-awareness, reconnect with themselves and make
						meaningful changes in their lives.
					</p>
					<ul class="trust-strip" aria-label="Service qualities">
						<li>Non-clinical</li>
						<li>Reflective</li>
						<li>Educational</li>
						<li>Whole-person wellbeing</li>
					</ul>
					<div class="cta-row">
						<a class="cta cta-solid" href={internationalWellbeingBookingUrl}>
							Book now
						</a>
						<a class="cta cta-outline" href="#what-is">
							Explore international wellbeing mentoring
						</a>
					</div>
					<p class="hero-note">
						Please note: International Wellbeing Mentoring is not counselling,
						psychotherapy, medical care, psychological treatment or crisis
						support.
					</p>
				</div>
				<figure class="hero-media">
					<img
						src="/assets/images/ally-writing-journal.jpg"
						alt="Ally Donoghue — counsellor, educator and wellbeing mentor — writing reflectively"
						width="682"
						height="1024"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
				</figure>
			</div>
		</section>

		<section class="iw-section section" id="what-is">
			<div class="container iw-narrow">
				<p class="section-kicker">A different kind of space</p>
				<h2>Maybe you don't need fixing. Maybe you need space.</h2>
				<p>
					Life can become so busy that we lose touch with ourselves. You may be
					functioning, working, caring for others and getting through the days —
					but underneath it all, you might feel overwhelmed, disconnected, stuck
					or simply unsure about what you need.
				</p>
				<p>
					Perhaps you're going through a change. Perhaps you've reached a point
					where you want something to be different. Or perhaps there isn't
					anything particularly 'wrong' — you simply want to understand yourself
					better.
				</p>
				<p class="iw-lede">
					International Wellbeing Mentoring gives you space to stop, listen and
					explore.
				</p>
				<p>
					No diagnosis. No judgement. No one telling you what you should do. Just
					a thoughtful, supportive space to explore you.
				</p>
				<p>
					<a class="text-link" href="#right-for-you">
						Is wellbeing mentoring right for me?
					</a>
				</p>
			</div>
		</section>

		<section class="iw-section section section-soft" id="approach">
			<div class="container">
				<header class="iw-head">
					<p class="section-kicker">How I work</p>
					<h2>A whole-person approach</h2>
					<p>
						My approach brings together the different strands of my professional
						experience. I am a Counsellor, Psychotherapist, Educator and
						Wellbeing Mentor, with a background that includes counselling and
						psychotherapy, education and science.
					</p>
				</header>
				<div class="iw-pillars">
					<article>
						<h3>Science</h3>
						<p>
							My science background encourages curiosity about the relationship
							between our bodies, minds and wider environment.
						</p>
					</article>
					<article>
						<h3>Education</h3>
						<p>
							As an educator, I can help you understand things — not simply talk
							about them. We can explore information, ideas and practical
							approaches that may help you make sense of your own experience.
						</p>
					</article>
					<article>
						<h3>Counselling &amp; psychotherapy experience</h3>
						<p>
							My counselling and psychotherapy training informs how I listen,
							communicate, ask questions and create a space where you can
							reflect safely. But this is not counselling or psychotherapy.
						</p>
					</article>
					<article>
						<h3>Human experience</h3>
						<p>
							Alongside qualifications comes the wisdom gained from working with
							people, listening to their stories and understanding that
							wellbeing isn't one-size-fits-all.
						</p>
					</article>
				</div>
				<p class="iw-close">
					Together, these create a way of working that considers the whole
					person — mind, body, relationships, environment, experiences and
					everyday life.
				</p>
			</div>
		</section>

		<section class="iw-section section" id="explore">
			<div class="container">
				<header class="iw-head">
					<p class="section-kicker">Themes</p>
					<h2>What might we explore?</h2>
					<p>There doesn't have to be one particular problem.</p>
				</header>
				<div class="iw-themes">
					{
						exploreThemes.map((item) => (
							<article>
								<h3>{item.title}</h3>
								<p>{item.body}</p>
							</article>
						))
					}
				</div>
				<p class="iw-close">
					You don't have to know exactly what you need before you begin. We can
					start there.
				</p>
			</div>
		</section>

		<section class="iw-section section section-soft" id="session">
			<div class="container iw-split">
				<figure class="iw-media">
					<img
						src="/assets/images/therapy-forest.png"
						alt="Sunlight filtering through a quiet forest — a calm space for reflection"
						width="1024"
						height="1024"
						loading="lazy"
						decoding="async"
					/>
				</figure>
				<div>
					<p class="section-kicker">In session</p>
					<h2>What is a wellbeing mentoring session like?</h2>
					<p>
						A session is a conversation — but it isn't simply about talking. You
						might bring something that has been on your mind. We might explore
						what's happening in your life and how you are experiencing it.
					</p>
					<p>
						I may ask questions, offer a different perspective, share
						information or introduce an idea or practical approach.
					</p>
					<p>
						Sometimes you may need space to think. Sometimes you may want to
						learn. Sometimes you may want to understand why you keep finding
						yourself in the same place. And sometimes you may simply need
						someone to help you slow down enough to hear yourself.
					</p>
				</div>
			</div>
		</section>

		<section class="iw-section section" id="not-therapy">
			<div class="container iw-narrow">
				<p class="section-kicker">Important boundary</p>
				<h2>Wellbeing mentoring is not counselling or psychotherapy</h2>
				<p>
					My professional background includes UK training in counselling and
					psychotherapy. However, when I work with international clients through
					Awaken Discovery, I am working as a Wellbeing Mentor, not as a
					counsellor or psychotherapist.
				</p>
				<p>
					International Wellbeing Mentoring is a non-clinical wellbeing service.
					It does not provide:
				</p>
				<ul class="iw-grid-list">
					{notIncluded.map((item) => <li>{item}</li>)}
				</ul>
				<p>
					If it becomes clear that you need a level of support beyond wellbeing
					mentoring, I will be honest about this. I may recommend that you seek
					appropriate counselling, psychotherapy, psychological, medical or
					specialist support in the country where you are located.
				</p>
				<p class="iw-emphasis">
					This isn't a failure of the mentoring relationship. It is part of
					working responsibly.
				</p>
			</div>
		</section>

		<section class="iw-section section section-soft" id="international">
			<div class="container iw-narrow">
				<p class="section-kicker">Worldwide</p>
				<h2>Wellbeing support wherever you are in the world</h2>
				<p>
					International Wellbeing Mentoring is delivered online from the UK to
					adults located outside the United Kingdom.
				</p>
				<p>
					Because you may be joining from another country, your location
					matters. Different countries have different laws and requirements
					relating to wellbeing services, coaching, mentoring, counselling,
					psychotherapy and healthcare.
				</p>
				<p>
					For this reason, you will be asked to tell me the country in which you
					are physically located when receiving the service. If you travel or
					move country, you need to tell me.
				</p>
			</div>
		</section>

		<section class="iw-section section" id="ally">
			<div class="container iw-split">
				<figure class="iw-media">
					<img
						src="/assets/images/ally-portrait-sofa.jpg"
						alt="Ally Donoghue, founder of Awaken Discovery"
						width="800"
						height="1000"
						loading="lazy"
						decoding="async"
					/>
				</figure>
				<div>
					<p class="section-kicker">About Ally</p>
					<h2>I'm Ally</h2>
					<p class="iw-roles">
						Counsellor · Psychotherapist · Educator · Wellbeing Mentor
					</p>
					<p>
						I'm Ally Donoghue, founder of Awaken Discovery. My professional life
						has moved across different worlds — science, education, counselling,
						psychotherapy and wellbeing. Rather than seeing these as separate
						parts of me, I bring them together.
					</p>
					<p>
						I believe that understanding ourselves isn't simply about what
						happens inside our heads. We are whole people. Our bodies, thoughts,
						emotions, relationships, experiences, environments, beliefs, habits
						and circumstances can all influence how we experience life.
					</p>
					<p>
						My role isn't to tell you who you should become. It is to help you
						pause, become curious about yourself and discover what might help
						you feel more connected to the person you already are.
					</p>
					<a class="cta cta-outline" href="/about">Meet Ally</a>
				</div>
			</div>
		</section>

		<section class="iw-section section section-soft" id="right-for-you">
			<div class="container">
				<header class="iw-head">
					<p class="section-kicker">Fit</p>
					<h2>Could international wellbeing mentoring be right for you?</h2>
					<p>It may be right for you if:</p>
				</header>
				<ul class="iw-check-list">
					{rightForYou.map((item) => <li>{item}</li>)}
				</ul>
				<p class="iw-close">
					You don't need to have everything figured out before you come.
				</p>
			</div>
		</section>

		<section class="iw-section section" id="before-booking">
			<div class="container iw-narrow iw-before">
				<p class="section-kicker">Before booking</p>
				<h2>Read the agreement first</h2>
				<p>
					International Wellbeing Mentoring is provided under the Awaken
					Discovery International Wellbeing Mentoring Agreement.
				</p>
				<p>
					Please read the agreement before booking. It explains the nature and
					boundaries of the service, confidentiality, international working,
					cancellations, payments and what happens if your needs fall outside
					the scope of wellbeing mentoring.
				</p>
				<a class="cta cta-outline" href={internationalWellbeingAgreementPath}>
					Read the International Wellbeing Mentoring Agreement
				</a>
			</div>
		</section>

		<section class="iw-cta section">
			<div class="container iw-cta-inner">
				<p class="section-kicker">Next step</p>
				<h2>Ready to make some space for yourself?</h2>
				<p>
					You don't have to know exactly what you need. We can start with a
					conversation about where you are now and what you would like from
					wellbeing mentoring.
				</p>
				<div class="cta-row">
					<a class="cta cta-solid" href={internationalWellbeingBookingUrl}>
						Book now
					</a>
					<a class="cta cta-outline" href={internationalWellbeingEnquiryUrl}>
						Arrange an initial conversation
					</a>
				</div>
				<p class="hero-note">
					Booking links will point to Ally's confirmed appointment system once
					ready. For now, use the contact form and mention international
					wellbeing mentoring.
				</p>
			</div>
		</section>

		<section class="iw-section section section-soft" id="disclaimer">
			<div class="container iw-narrow">
				<p class="section-kicker">Important information</p>
				<h2>Disclaimer</h2>
				<p>
					International Wellbeing Mentoring is a non-clinical wellbeing service.
					It is not counselling, psychotherapy, psychological treatment, medical
					care or crisis support.
				</p>
				<p>
					Although Allyson Donoghue is trained in counselling and psychotherapy,
					these qualifications form part of her wider professional background
					and do not mean that counselling or psychotherapy is being provided
					through this international service.
				</p>
				<p>
					The service may draw on reflective, educational, relational and
					wellbeing approaches, but does not involve diagnosis or treatment of
					mental or physical health conditions.
				</p>
				<p>
					If you require clinical, medical or specialist mental-health support,
					you should seek an appropriately qualified professional or healthcare
					service in the country where you are located.
				</p>
				<p>
					If you are in immediate danger or experiencing a medical or
					mental-health emergency, contact the appropriate emergency or crisis
					service in your country.
				</p>
			</div>
		</section>

		<section class="iw-section section" id="faq">
			<div class="container iw-narrow">
				<header class="iw-head">
					<p class="section-kicker">FAQ</p>
					<h2>Common questions</h2>
				</header>
				<div class="iw-faq">
					{
						faqs.map((item) => (
							<details>
								<summary>{item.q}</summary>
								<p>{item.a}</p>
							</details>
						))
					}
				</div>
			</div>
		</section>
	</main>
	<SiteFooter locations={locations} />
</Layout>

<style>
	.iw-hero {
		padding-block: clamp(2.5rem, 7vh, 4.5rem) clamp(3rem, 8vh, 5rem);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(1.8rem, 4vw, 3.5rem);
		align-items: center;
	}

	.eyebrow {
		margin: 0 0 0.7rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-dark-slate-gray);
	}

	h1 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 4.2vw, 3rem);
		font-weight: 500;
		line-height: 1.15;
		color: var(--brand-deep, #004836);
		text-wrap: balance;
	}

	.hero-title {
		margin: 0.85rem 0 0;
		font-family: var(--font-serif);
		font-size: clamp(1.25rem, 2.4vw, 1.6rem);
		font-weight: 500;
		line-height: 1.35;
		color: var(--brand-deep, #004836);
	}

	.subheadline {
		margin: 0.9rem 0 0;
		font-size: 1.02rem;
		line-height: 1.7;
		color: var(--ink-soft, rgb(29 35 39 / 78%));
		max-width: 40rem;
	}

	.trust-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 1.1rem;
		margin: 1.35rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.86rem;
		color: var(--color-dark-slate-gray);
	}

	.trust-strip li {
		position: relative;
		padding-left: 0.9rem;
	}

	.trust-strip li::before {
		content: "·";
		position: absolute;
		left: 0;
		color: var(--brand, #005e47);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.5rem;
	}

	.hero-note,
	.iw-cta .hero-note {
		margin: 1.1rem 0 0;
		max-width: 40rem;
		font-size: 0.9rem;
		line-height: 1.6;
		color: rgb(29 35 39 / 72%);
	}

	.hero-media {
		margin: 0;
	}

	.hero-media img,
	.iw-media img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 50% 25%;
		border-radius: 1rem;
		box-shadow: 0 14px 35px rgb(29 35 39 / 14%);
	}

	.iw-section {
		padding-block: clamp(2.8rem, 7vh, 4.8rem);
		scroll-margin-top: 5.5rem;
	}

	.iw-narrow {
		max-width: 44rem;
	}

	.iw-head {
		max-width: 40rem;
		margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
	}

	h2 {
		margin: 0.55rem 0 0.9rem;
		font-family: var(--font-serif);
		font-size: clamp(1.65rem, 3.2vw, 2.35rem);
		font-weight: 500;
		color: var(--brand-deep, #004836);
		text-wrap: balance;
	}

	h3 {
		margin: 0 0 0.55rem;
		font-family: var(--font-serif);
		font-size: 1.2rem;
		font-weight: 500;
		color: var(--brand-deep, #004836);
	}

	.iw-section p,
	.iw-cta p {
		margin: 0 0 1rem;
		font-size: 1.02rem;
		line-height: 1.75;
		color: var(--ink-soft, rgb(29 35 39 / 78%));
	}

	.iw-lede {
		font-family: var(--font-serif);
		font-size: 1.2rem !important;
		font-weight: 500;
		color: var(--brand-deep, #004836) !important;
	}

	.iw-emphasis {
		font-weight: 500;
		color: var(--color-dark-gray) !important;
	}

	.iw-close {
		margin-top: 1.4rem !important;
		font-family: var(--font-serif);
		font-style: italic;
	}

	.text-link {
		color: var(--brand-deep, #004836);
		font-weight: 600;
		text-underline-offset: 0.18em;
	}

	.iw-pillars,
	.iw-themes {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem 1.5rem;
	}

	.iw-pillars article,
	.iw-themes article {
		padding: 1.2rem 1.25rem;
		border-radius: 0.9rem;
		background: rgb(0 94 71 / 5%);
		border: 1px solid rgb(0 94 71 / 12%);
	}

	.iw-pillars p,
	.iw-themes p {
		margin: 0;
		font-size: 0.98rem;
	}

	.iw-split {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(1.6rem, 4vw, 3.2rem);
		align-items: center;
	}

	.iw-media {
		margin: 0;
	}

	.iw-roles {
		font-size: 0.92rem !important;
		letter-spacing: 0.02em;
		color: var(--color-dark-slate-gray) !important;
	}

	.iw-grid-list,
	.iw-check-list {
		margin: 0 0 1.2rem;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.7rem;
	}

	.iw-grid-list {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.iw-grid-list li,
	.iw-check-list li {
		position: relative;
		padding-left: 1.35rem;
		line-height: 1.55;
		color: var(--ink-soft, rgb(29 35 39 / 78%));
	}

	.iw-grid-list li::before,
	.iw-check-list li::before {
		content: "–";
		position: absolute;
		left: 0;
		color: var(--brand, #005e47);
	}

	.iw-check-list {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.iw-check-list li::before {
		content: "✓";
	}

	.iw-before {
		padding: 1.6rem 1.5rem;
		border-radius: 1rem;
		border: 1px solid rgb(0 94 71 / 16%);
		background: rgb(0 94 71 / 4%);
	}

	.iw-cta {
		padding-block: clamp(3rem, 8vh, 5rem);
		background: linear-gradient(160deg, #004836 0%, #005e47 100%);
		color: white;
	}

	.iw-cta .section-kicker,
	.iw-cta h2,
	.iw-cta p {
