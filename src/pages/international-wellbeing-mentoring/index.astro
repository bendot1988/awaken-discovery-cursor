<script>
	function initIwmEnquiryForm() {
		const form = document.querySelector(
			"[data-iwm-enquiry-form]",
		) as HTMLFormElement | null;
		if (!form || form.dataset.bound === "true") return;
		form.dataset.bound = "true";
		const formStartedAt = Date.now();

		const status = form.querySelector(
			"[data-iwm-enquiry-status]",
		) as HTMLParagraphElement | null;
		const submit = form.querySelector(
			'button[type="submit"]',
		) as HTMLButtonElement | null;

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			if (!status || !submit) return;
			if (!form.reportValidity()) return;

			const fd = new FormData(form);
			const topics = fd
				.getAll("topics")
				.map((v) => String(v))
				.filter(Boolean);

			const payload = {
				firstName: String(fd.get("firstName") || "").trim(),
				lastName: String(fd.get("lastName") || "").trim(),
				diallingCode: String(fd.get("diallingCode") || "").trim(),
				phone: String(fd.get("phone") || "").trim(),
				email: String(fd.get("email") || "").trim(),
				message: String(fd.get("message") || "").trim(),
				topics,
				source: String(fd.get("source") || "").trim(),
				newsletter: false,
				privacy: fd.get("privacy") === "yes",
				company: String(fd.get("company") || "").trim(),
				formStartedAt,
			};

			status.hidden = false;
			status.dataset.state = "pending";
			status.textContent = "Sending…";
			submit.disabled = true;

			try {
				const response = await fetch("/api/contact", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(payload),
				});
				const data = await response.json().catch(() => ({}));

				if (!response.ok || !data.success) {
					status.dataset.state = "error";
					status.textContent =
						(typeof data.error === "string" && data.error) ||
						"Something went wrong. Please try again.";
					submit.disabled = false;
					return;
				}

				status.dataset.state = "ok";
				status.textContent =
					"Thank you — your message has been sent. Ally aims to reply within one working day.";
				form.reset();
				submit.disabled = false;
			} catch {
				status.dataset.state = "error";
				status.textContent =
					"Network error — please check your connection and try again.";
				submit.disabled = false;
			}
		});
	}

	initIwmEnquiryForm();
	document.addEventListener("astro:page-load", initIwmEnquiryForm);
</script>
