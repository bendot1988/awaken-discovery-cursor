---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import GuideSignupForm from "../../components/home/GuideSignupForm.astro";
import { locations, navItems } from "../../data/site";

const insideBullets = [
	"How to gently slow things down and begin listening to what your body is trying to communicate — without judgment or pressure.",
	"Simple body-aware techniques to help you pause, breathe and find your way back to yourself when anxiety rises.",
	"A gentle reflection space to notice what's present for you right now — patterns in your body, thoughts and emotions.",
	"Personal \u201canchors\u201d you can return to — something solid, something moving, something breathing — that help you feel steadier even in the middle of an overwhelming day.",
	"Why simply noticing the contact between your hand and your body can remind you that you're here, in this moment, supported.",
];

const symptoms = [
	"The racing heart.",
	"The 3 AM panic.",
	"The constant feeling that something bad is about to happen — even when everything's technically \u201cfine.\u201d",
];

const steps = [
	{
		num: "01",
		title: "Drop your email",
		body: "The guide lands in your inbox in the next couple of minutes.",
	},
	{
		num: "02",
		title: "Take a few moments for yourself",
		body: "No rush, no pressure to do everything at once.",
	},
	{
		num: "03",
		title: "Notice what feels different",
		body: "What it's like when you gently return attention to your body.",
	},
];

const faqs = [
	{
		q: "I've tried therapy / meditation / breathing apps before and they didn't help. Will this be different?",
		a: "Honestly — it depends on whether you try it. This guide isn't trying to replace therapy or medication. It's an invitation to notice what's already happening in your body rather than push it away. Most people who say \u201cnothing has worked\u201d have been told for years to manage or fight their anxiety. This is a different door in.",
	},
	{
		q: "I'm not in crisis — is this still for me?",
		a: "Yes. The guide is for anyone whose nervous system has been carrying too much for too long — whether that shows up as 3 AM panic, low-grade dread, overthinking, or just being permanently tired. You don't have to be at breaking point to deserve relief.",
	},
	{
		q: "How long does it take to read?",
		a: "About twenty minutes. The techniques inside take under sixty seconds each. You can read it on your phone in the car park, on a tea break, or curled up on the sofa.",
	},
	{
		q: "What if I'm in crisis right now?",
		a: "This guide isn't a substitute for urgent support. If you need to speak to someone tonight, please call the Samaritans on 116 123 — they're there, free, any time. The guide will still be here tomorrow.",
	},
	{
		q: "Is my email safe? Will I get spammed?",
		a: "Your email is handled with care. You'll get the guide, then occasional supportive notes from me. You can unsubscribe in one click at any time.",
	},
];
---

<Layout
	title="Finding Calm · Free Anxiety Grounding Guide · Awaken Discovery"
	description="A free guide for anyone tired of fighting their nervous system. Body-aware techniques to pause, breathe and find your way back to yourself when anxiety rises."
>
	<SiteHeader navItems={navItems} />
	<main class="anx-page">
		<!-- ============== HERO ============== -->
		<section class="anx-hero section">
			<div class="container anx-hero-grid">
				<div class="anx-hero-copy">
					<p class="anx-listen">Listen…</p>
					<h1>
						If You're Tired of Waking Up Every Morning <em>Already</em> Exhausted
						by the Weight of Your Own Thoughts…
					</h1>
					<p class="anx-subhead">
						And you're sick of pretending you're <em>"fine"</em> when you're
						barely holding it together…
					</p>
					<p class="anx-promise">
						Then this free guide will show you how to finally quiet the noise in
						your head <span>— without years of therapy or expensive medication.</span>
					</p>
					<div class="anx-cta-row">
						<a class="cta cta-solid anx-cta" href="#claim">
							Yes — Send Me the Free Guide
						</a>
						<a class="cta cta-outline" href="#inside">See what's inside</a>
					</div>
					<ul class="anx-trust" aria-label="Credentials">
						<li>✔ Teacher · Counsellor &amp; Psychotherapist</li>
						<li>✔ Body-aware, nervous-system informed</li>
						<li>✔ Gentle, no-pressure approach</li>
					</ul>
				</div>

				<figure class="anx-hero-media">
					<video
						class="anx-hero-video"
						src="/assets/videos/awaken.mp4"
						autoplay
						muted
						loop
						playsinline
						preload="metadata"
						aria-label="Calm, atmospheric video introducing Awaken Discovery"
					></video>
				</figure>
			</div>
		</section>

		<!-- ============== TRUTH ============== -->
		<section class="anx-truth section section-soft">
			<div class="container anx-prose">
				<p class="section-kicker">Here's the truth nobody's telling you</p>
				<h2>
					You're not "too sensitive." You're not "overthinking it." And you're
					definitely not broken.
				</h2>
				<p>
					What you <em>are</em> is carrying an invisible load that's gotten
					heavier every single day… and your nervous system is screaming for
					relief.
				</p>
				<ul class="anx-symptoms">
					{
						symptoms.map((s) => (
							<li>{s}</li>
						))
					}
				</ul>
				<p class="anx-recognise">Sound familiar?</p>
			</div>
		</section>

		<!-- ============== DIFFERENTIATOR (Ally portrait + copy) ============== -->
		<section class="anx-different section">
			<div class="container anx-different-grid">
				<figure class="anx-different-figure">
					<img
						src="/assets/images/hero-ally.png"
						alt="Ally — counsellor and psychotherapist, founder of Awaken Discovery"
						loading="lazy"
						decoding="async"
					/>
				</figure>
				<div class="anx-different-copy">
					<p class="section-kicker">Here's what makes this different</p>
					<h2>Most therapists will tell you to "manage" your anxiety. I'd like to show you something else.</h2>
					<p>
						Most therapists will tell you to manage it. To cope with it. To
						learn to live with it.
					</p>
					<p class="anx-emphasis">
						I'd like to show you how to actually <em>listen</em> to what your
						body is trying to tell you.
					</p>
					<p>
						Because here's what I've discovered after years of working with
						people just like you: anxiety isn't something to fight. It's your
						body's way of communicating.
					</p>
					<p>
						And until you learn to gently notice what's happening in your
						body, no amount of positive thinking will give you lasting relief.
					</p>
					<p class="anx-emphasis">That's why I created this free guide.</p>
				</div>
			</div>
		</section>

		<!-- ============== THE OFFER (copy LEFT, mockup RIGHT) ============== -->
		<section class="anx-offer section section-soft" id="inside">
			<div class="container anx-offer-grid">
				<div class="anx-offer-copy">
					<p class="section-kicker">Your free guide</p>
					<h2>Finding Calm — A Simple Guide to Grounding Yourself During Anxiety</h2>
					<p class="anx-sub">
						An invitation to gently slow things down. To notice. To return
						to yourself.
					</p>
					<ul class="anx-inside">
						{
							insideBullets.map((b) => (
								<li>{b}</li>
							))
						}
					</ul>
					<p class="anx-promise-small">
						This isn't about fixing you or getting rid of anxiety completely.
						It's about gently coming home to your body.
					</p>
					<a class="cta cta-solid anx-cta" href="#claim">
						Yes — Send Me the Free Guide
					</a>
				</div>

				<figure class="anx-mockup-wrap">
					<div class="anx-mockup">
						<div class="anx-mockup-pages" aria-hidden="true"></div>
						<div class="anx-mockup-spine" aria-hidden="true"></div>
						<img
							class="anx-mockup-cover"
							src="/assets/images/finding-calm-anxiety-cover.png"
							alt="Finding Calm — A Simple Guide to Grounding Yourself During Anxiety, by Ally at Awaken Discovery"
							width="517"
							height="730"
							loading="lazy"
							decoding="async"
						/>
					</div>
				</figure>
			</div>
		</section>

		<!-- ============== MEET ALLY ============== -->
		<section class="anx-meet section">
			<div class="container anx-meet-grid">
				<div class="anx-meet-copy">
					<p class="section-kicker">Who am I and why should you listen?</p>
					<h2>Hi — I'm Ally.</h2>
					<p>
						I'm a teacher, counsellor, psychotherapist and wellbeing educator
						based in Market Weighton, East Yorkshire. But more importantly,
						I've spent years helping people just like you understand their
						anxiety and reconnect with themselves — so they can feel more
						emotionally balanced in everyday life.
					</p>
					<p>
						Over time I've developed a gentle, body-aware approach that helps
						you notice what's happening without trying to change it all at
						once.
					</p>
					<p class="anx-emphasis">
						Because you don't need to do this perfectly. You don't need to do
						everything at once. Simply being here, taking a moment for
						yourself, is already enough.
					</p>
					<a class="cta cta-outline" href="/about">Read more about Ally</a>
				</div>
				<figure class="anx-meet-figure">
					<img
						src="/assets/images/ally-in-session.png"
						alt="Ally in session with a client in her Market Weighton therapy room"
						loading="lazy"
						decoding="async"
					/>
				</figure>
			</div>
		</section>

		<!-- ============== TESTIMONIALS ============== -->
		<section class="anx-testimonials section section-soft">
			<div class="container">
				<header class="anx-section-head">
					<p class="section-kicker">What clients say</p>
					<h2>You're not the first to feel this way — and you don't have to figure it out alone.</h2>
				</header>
				<div class="anx-test-grid">
					<blockquote class="anx-testimonial">
						<p>
							The counselling sessions have helped me untangle some of the
							emotions I've been carrying.
						</p>
						<footer>
							<span class="anx-test-name">Current client</span>
							<span class="anx-test-meta">Anonymised at client's request</span>
						</footer>
					</blockquote>
					<blockquote class="anx-testimonial">
						<p>
							What makes Ally great is her ability to help me really clarify
							my thoughts — so I can express what I'm thinking and feeling.
						</p>
						<footer>
							<span class="anx-test-name">Current client</span>
							<span class="anx-test-meta">Anonymised at client's request</span>
						</footer>
					</blockquote>
				</div>
			</div>
		</section>

		<!-- ============== STEPS ============== -->
		<section class="anx-steps-band section">
			<div class="container">
				<header class="anx-section-head">
					<p class="section-kicker">Here's what happens next</p>
					<h2>Three steps. No rush. No pressure to do everything at once.</h2>
				</header>
				<ol class="anx-steps">
					{
						steps.map((s) => (
							<li>
								<span class="anx-step-num">{s.num}</span>
								<h3>{s.title}</h3>
								<p>{s.body}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<!-- ============== CLAIM FORM ============== -->
		<section class="anx-claim section" id="claim">
			<div class="container anx-claim-grid">
				<figure class="anx-claim-figure">
					<img
						src="/assets/images/ally-therapy-room.png"
						alt="Ally — counsellor and psychotherapist"
						loading="lazy"
						decoding="async"
					/>
				</figure>

				<div class="anx-claim-copy">
					<p class="section-kicker">Yes — send me the guide</p>
					<h2>Finding Calm — A Simple Guide to Grounding Yourself During Anxiety</h2>
					<p>
						Pop your email below. The PDF lands in your inbox in the next
						couple of minutes — read it whenever you next have a quiet five.
					</p>

					<div class="anx-form-slot">
						<GuideSignupForm
							list="anxiety-guide"
							buttonLabel="Send Me the Free Guide"
							pageLocation="Finding Calm anxiety landing · Free Guide (#claim)"
						/>
						<p class="anx-privacy">
							Your details are handled with care. See our <a href="/privacy">Privacy Policy</a>.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ============== FAQ ============== -->
		<section class="anx-faq section section-soft">
			<div class="container">
				<header class="anx-section-head">
					<p class="section-kicker">FAQ</p>
					<h2>Questions people often ask first</h2>
				</header>
				<div class="anx-faq-list">
					{
						faqs.map((item) => (
							<details class="anx-faq-item">
								<summary>
									<span>{item.q}</span>
									<span class="anx-faq-icon" aria-hidden="true">+</span>
								</summary>
								<div class="anx-faq-body">
									<p>{item.a}</p>
								</div>
							</details>
						))
					}
				</div>
			</div>
		</section>

		<!-- ============== CLOSING ============== -->
		<section class="anx-close section">
			<div class="container anx-close-inner">
				<p class="anx-close-line">
					You don't need to keep struggling alone.
				</p>
				<p class="anx-close-line">
					You don't need to white-knuckle your way through every day.
				</p>
				<p class="anx-close-line">
					You don't need to wait until it gets worse to take a breath.
				</p>
				<p class="anx-close-signoff">
					Download the guide. Give yourself this moment. You deserve to feel
					calm again.
				</p>
				<p class="anx-signature">— Ally</p>
				<a class="cta cta-solid anx-cta" href="#claim">
					Yes — Send Me the Free Guide
				</a>
			</div>
		</section>
	</main>
	<SiteFooter
		locations={locations}
		tagline="Gentle, body-aware support for anxiety, overthinking and emotional overwhelm."
	/>
</Layout>

<style>
	.anx-page {
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		--ink: var(--color-dark-gray);
		--ink-soft: rgb(29 35 39 / 78%);
		font-size: 1.05rem;
		line-height: 1.75;
		color: var(--ink);
	}

	.anx-page .section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--brand);
	}

	.anx-page h2 {
		margin: 0.6rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(1.7rem, 3.3vw, 2.4rem);
		line-height: 1.2;
		font-weight: 500;
		text-wrap: balance;
	}

	.anx-page h3 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.2rem;
		font-weight: 500;
		color: var(--brand-deep);
	}

	.anx-section-head {
		max-width: 60ch;
		margin-bottom: 2rem;
	}

	/* ---------- HERO ---------- */
	.anx-hero {
		padding-block: clamp(4rem, 9vh, 6.5rem);
		background:
			radial-gradient(ellipse at 80% 20%, rgb(0 94 71 / 14%), transparent 60%),
			linear-gradient(160deg, #eaf0ea 0%, #f6f8f6 60%, #f4ecea 100%);
	}

	.anx-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(2rem, 4vw, 3.5rem);
		align-items: center;
	}

	.anx-hero-copy {
		max-width: 780px;
	}

	.anx-hero-media {
		margin: 0;
		justify-self: end;
		width: min(100%, 28rem);
		border-radius: 1.1rem;
		overflow: hidden;
		background: #e8efea;
		border: 1px solid rgb(0 94 71 / 14%);
		box-shadow: 0 18px 42px rgb(0 94 71 / 12%);
	}

	.anx-hero-video {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}

	.anx-listen {
		margin: 0 0 0.4rem;
		font-family: var(--font-script);
		font-size: clamp(1.7rem, 3vw, 2.4rem);
		line-height: 1;
		color: var(--brand);
	}

	.anx-hero h1 {
		margin: 0.4rem 0 1.1rem;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 4.6vw, 3.3rem);
		font-weight: 500;
		line-height: 1.14;
		color: var(--brand-deep);
		text-wrap: balance;
	}

	.anx-hero h1 em {
		font-style: italic;
		color: var(--brand);
	}

	.anx-subhead {
		margin: 0 0 1.4rem;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.6;
		max-width: 60ch;
	}

	.anx-subhead em {
		font-style: italic;
		color: var(--brand-deep);
	}

	.anx-promise {
		margin: 0 0 1.6rem;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(1.2rem, 2.4vw, 1.55rem);
		line-height: 1.45;
		color: var(--brand-deep);
		max-width: 56ch;
	}

	.anx-promise span {
		display: inline;
		opacity: 0.85;
	}

	.anx-cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-bottom: 1.6rem;
	}

	.anx-cta {
		padding: 0.9rem 1.4rem;
		font-size: 1rem;
	}

	.anx-trust {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.88rem;
		color: var(--ink-soft);
	}

	/* ---------- TRUTH ---------- */
	.anx-truth {
		padding-block: clamp(3rem, 7vh, 5rem);
	}

	.anx-prose {
		max-width: 64ch;
	}

	.anx-prose p {
		margin: 0 0 1rem;
	}

	.anx-symptoms {
		list-style: none;
		margin: 1.4rem 0;
		padding: 0;
		display: grid;
		gap: 0.65rem;
	}

	.anx-symptoms li {
		position: relative;
		padding-left: 1.4rem;
		font-style: italic;
		line-height: 1.6;
	}

	.anx-symptoms li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.65em;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: var(--brand);
		opacity: 0.55;
	}

	.anx-recognise {
		margin: 1.2rem 0 0;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.3rem;
		color: var(--brand);
	}

	/* ---------- DIFFERENTIATOR ---------- */
	.anx-different-grid {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: clamp(1.6rem, 4vw, 3.5rem);
		align-items: center;
	}

	.anx-different-figure {
		margin: 0;
	}

	.anx-different-figure img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 50% 25%;
		border-radius: 1rem;
		box-shadow: 0 18px 36px rgb(0 94 71 / 18%);
	}

	.anx-different-copy p {
		margin: 0 0 1rem;
		max-width: 58ch;
	}

	.anx-emphasis {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.15rem;
		color: var(--brand-deep);
	}

	.anx-emphasis em {
		font-style: italic;
		color: var(--brand);
		font-weight: 600;
	}

	/* ---------- OFFER ---------- */
	.anx-offer-grid {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: clamp(1.6rem, 4vw, 3.5rem);
		align-items: center;
	}

	.anx-offer-copy h2 {
		margin: 0.5rem 0 0.8rem;
	}

	.anx-sub {
		font-family: var(--font-serif);
		font-style: italic;
		color: var(--brand-deep);
		font-size: 1.1rem;
		margin-bottom: 1.3rem;
	}

	.anx-inside {
		list-style: none;
		padding: 0;
		margin: 0 0 1.5rem;
		display: grid;
		gap: 0.85rem;
	}

	.anx-inside li {
		position: relative;
		padding-left: 2rem;
		line-height: 1.65;
	}

	.anx-inside li::before {
		content: "✓";
		position: absolute;
		left: 0;
		top: 0;
		width: 1.4rem;
		height: 1.4rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: var(--brand);
		color: var(--color-white);
		font-size: 0.78rem;
		font-weight: 700;
	}

	.anx-promise-small {
		font-family: var(--font-serif);
		font-style: italic;
		color: var(--brand-deep);
		margin-bottom: 1.3rem;
		font-size: 1.05rem;
	}

	/* ---------- BOOK MOCKUP ---------- */
	.anx-mockup-wrap {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
	}

	.anx-mockup {
		position: relative;
		width: 100%;
		max-width: 360px;
		aspect-ratio: 517 / 730;
		transform: perspective(1400px) rotateY(-9deg) rotateX(2deg);
		transform-origin: left center;
		filter: drop-shadow(0 24px 40px rgb(0 94 71 / 28%));
	}

	.anx-mockup-cover {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0.35rem 0.7rem 0.7rem 0.35rem;
		box-shadow:
			inset 14px 0 18px -10px rgb(0 0 0 / 25%),
			inset -2px 0 0 0 rgb(255 255 255 / 35%),
			0 1px 0 0 rgb(0 0 0 / 18%);
		z-index: 2;
	}

	.anx-mockup-spine {
		position: absolute;
		top: 1.5%;
		bottom: 1.5%;
		left: 0;
		width: 14px;
		border-radius: 0.35rem 0 0 0.35rem;
		background: linear-gradient(
			90deg,
