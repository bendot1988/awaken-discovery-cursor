---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ComingSoon from "../components/ComingSoon.astro";
import { locations, navItems } from "../data/site";
---

<Layout
	title="Blog · Awaken Discovery"
	description="Gentle wellbeing insights, reflections and supportive resources from Awaken Discovery."
>
	<SiteHeader navItems={navItems} />
	<main>
		<ComingSoon
			eyebrow="Blog"
			title="Blog — Coming Soon"
			body="Gentle wellbeing insights, reflections and supportive resources for navigating anxiety, burnout and emotional overwhelm."
			notes={[
				"Articles on anxiety and the nervous system",
				"Reflections for teachers in survival mode",
				"Gentle grounding practices and reflection prompts",
				"Notes from Ally's therapeutic work",
			]}
		/>
	</main>
	<SiteFooter locations={locations} />
</Layout>
