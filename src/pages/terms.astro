---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { locations, navItems } from "../data/site";

const lastUpdated = "June 2026";

const toc = [
	{ id: "scope", label: "Introduction & Scope" },
	{ id: "counselling-disclaimer", label: "General Information & Counselling Disclaimer" },
	{ id: "safeguarding", label: "Safeguarding & Crisis Limitation" },
	{ id: "products", label: "Books, Products, Courses & Affiliate Links" },
	{ id: "social-media", label: "Social Media & Online Groups" },
	{ id: "intellectual-property", label: "Intellectual Property" },
	{ id: "user-content", label: "User Comments & Contributions" },
	{ id: "cookies", label: "Cookies & Tracking" },
	{ id: "external-links", label: "External Links & Third-Party Content" },
	{ id: "liability", label: "Limitation of Liability & Legal Compliance" },
	{ id: "governing-law", label: "Governing Law & Jurisdiction" },
	{ id: "amendments", label: "Reservation of Rights & Amendments" },
	{ id: "bulk-buying", label: "Bulk Buying Payments" },
];
---

<Layout
	title="Terms & Conditions · Awaken Discovery"
	description="Terms and Conditions for Awaken Discovery — covering use of the website, content, products, online groups, intellectual property and the website disclaimer."
>
	<SiteHeader navItems={navItems} />
	<main class="legal-page">
		<!-- ============== HERO ============== -->
		<section class="legal-hero section">
			<div class="container legal-hero-inner">
				<p class="section-kicker">Legal</p>
				<h1>Terms &amp; Conditions</h1>
				<p class="legal-subtitle">Awaken Discovery Counselling &amp; Psychotherapy</p>
				<p class="legal-meta">
					<span>Last updated</span>
					<time datetime="2026-06">{lastUpdated}</time>
				</p>
			</div>
		</section>

		<!-- ============== BODY ============== -->
		<section class="legal-body section">
			<div class="container legal-body-inner">
				<!-- TOC -->
				<aside class="legal-toc" aria-label="Terms and conditions sections">
					<p class="legal-toc-title">Contents</p>
					<ol class="legal-toc-list">
						{
							toc.map((item, i) => (
								<li>
									<a href={`#${item.id}`}>
										<span class="legal-toc-num">
											{String(i).padStart(2, "0")}
										</span>
										<span>{item.label}</span>
									</a>
								</li>
							))
						}
					</ol>
				</aside>

				<!-- Article -->
				<article class="legal-article">
					<blockquote class="legal-epigraph">
						<p>
							"This website is also subject to our Website Disclaimer, which
							forms part of these Terms and Conditions."
						</p>
					</blockquote>

					<section aria-labelledby="scope" id="scope">
						<h2><span class="legal-section-num">00</span>Introduction &amp; Scope</h2>
						<p>
							These Terms and Conditions and Disclaimer apply to all content,
							services, products and online platforms associated with Awaken
							Discovery, including but not limited to:
						</p>
						<ul>
							<li>The websites: <strong>awakendiscovery.co.uk</strong> and <strong>awakendiscovery.com</strong></li>
							<li>Blogs, articles, reflections and other written or educational content</li>
							<li>Books (digital or physical), courses, downloads and other products</li>
							<li>Affiliate links and recommendations</li>
							<li>Social media channels, including Facebook, Instagram and other platforms</li>
							<li>
								Private or public online groups, including the Awaken Discovery
								Holistic Health &amp; Wellbeing Facebook Group
							</li>
						</ul>
						<div class="legal-callout">
							<p>
								By accessing, using, purchasing from or participating in any of
								the above, you confirm that you have read, understood and agree
								to these Terms and Conditions. <strong>If you do not agree,
								you must not use the website, products, services or online spaces.</strong>
							</p>
						</div>
					</section>

					<section aria-labelledby="counselling-disclaimer" id="counselling-disclaimer">
						<h2>
							<span class="legal-section-num">01</span>
							General Information &amp; Counselling Disclaimer
						</h2>
						<p>
							All content provided by Awaken Discovery is offered for
							<strong>general informational, educational and reflective purposes only</strong>.
							It is not intended to constitute, and must not be relied upon as:
						</p>
						<ul>
							<li>Counselling or psychotherapy</li>
							<li>Psychological, psychiatric or medical advice</li>
							<li>Diagnosis, treatment or crisis intervention</li>
						</ul>
						<p>
							Accessing or engaging with any content does not create a
							counselling or therapeutic relationship. A therapeutic
							relationship is formed only following:
						</p>
						<ul>
							<li>A formal assessment and intake details</li>
							<li>Mutual agreement</li>
							<li>A signed counselling contract</li>
						</ul>
						<p>
							Counselling and psychotherapy services are provided in accordance
							with the <strong>BACP and NCPS Ethical Frameworks</strong>,
							including confidentiality, professional boundaries, safeguarding
							responsibilities, competence and informed consent.
						</p>
					</section>

					<section aria-labelledby="safeguarding" id="safeguarding">
						<h2>
							<span class="legal-section-num">02</span>
							Safeguarding &amp; Crisis Limitation
						</h2>
						<div class="legal-callout legal-callout--warning">
							<p class="legal-callout-title">Important — crisis support</p>
							<p>
								Awaken Discovery's website, content, social media platforms and
								online groups are <strong>not suitable for crisis support</strong>.
							</p>
							<p>
								If you are experiencing significant distress, risk of harm to
								yourself or others, or a mental health emergency, you must seek
								appropriate professional or emergency support through local services.
							</p>
							<p>
								Awaken Discovery is not responsible for responding to crisis
								disclosures made via website content, comments, emails, social
								media or online groups.
							</p>
						</div>
					</section>

					<section aria-labelledby="products" id="products">
						<h2>
							<span class="legal-section-num">03</span>
							Books, Products, Courses &amp; Affiliate Links
						</h2>
						<p>
							Any books, products, courses, downloads or resources offered or
							promoted through Awaken Discovery are provided for informational
							and educational purposes only.
						</p>
						<p>
							No guarantees are made regarding outcomes, results or benefits.
							You are solely responsible for how you use or apply any
							information or products purchased or accessed.
						</p>
						<p>
							Some links may be <strong>affiliate links</strong>, meaning
							Awaken Discovery may receive a small commission at no additional
							cost to you. This does not constitute endorsement, professional
							recommendation or guarantee.
						</p>
					</section>

					<section aria-labelledby="social-media" id="social-media">
						<h2>
							<span class="legal-section-num">04</span>
							Social Media &amp; Online Groups
						</h2>
						<p>
							Participation in social media channels or private or public online
							groups does not create a counselling or therapeutic relationship.
						</p>
						<p>Discussions within groups or comment sections are:</p>
						<ul>
							<li>General, supportive and informational</li>
							<li>Not therapeutic interventions</li>
							<li>Not a substitute for professional support</li>
						</ul>
						<p>
							Awaken Discovery does not monitor all user-generated content and
							is not responsible for content posted by users, except where
							required by law or where content is removed for breaching these
							Terms.
						</p>
						<p>Users agree not to post content that is:</p>
						<ul>
							<li>Unlawful or defamatory</li>
							<li>Offensive, abusive or sexually explicit</li>
							<li>Promotional or commercial</li>
							<li>Misleading or presented as professional advice</li>
						</ul>
						<p>
							Awaken Discovery reserves the right to remove content or restrict
							access at its discretion.
						</p>
					</section>

					<section aria-labelledby="intellectual-property" id="intellectual-property">
						<h2>
							<span class="legal-section-num">05</span>
							Intellectual Property
						</h2>
						<p>
							All content across the website, blogs, social media platforms and
							online groups (including text, images, logos, graphics, videos,
							downloads and branding) is owned by Awaken Discovery or its
							licensors.
						</p>
						<p>
							You may view and use content for <strong>personal, non-commercial
							purposes only</strong>.
						</p>
						<p>You must not:</p>
						<ul>
							<li>Republish, duplicate, copy, sell or redistribute content</li>
							<li>Frame, manipulate or alter content without written permission</li>
							<li>Misrepresent or imply endorsement, partnership or affiliation</li>
						</ul>
					</section>

					<section aria-labelledby="user-content" id="user-content">
						<h2>
							<span class="legal-section-num">06</span>
							User Comments &amp; Contributions
						</h2>
						<p>Where users are permitted to post comments or content, you confirm that:</p>
						<ul>
							<li>You have the legal right and necessary consent to post the content</li>
							<li>The content does not infringe third-party rights</li>
							<li>The content is lawful and appropriate</li>
						</ul>
						<p>
							By posting, you grant Awaken Discovery a non-exclusive,
							royalty-free licence to use, reproduce, edit and publish such
							content across its platforms.
						</p>
						<p>
							Awaken Discovery may remove comments or contributions at its sole
							discretion.
						</p>
					</section>

					<section aria-labelledby="cookies" id="cookies">
						<h2><span class="legal-section-num">07</span>Cookies &amp; Tracking</h2>
						<p>
							Awaken Discovery uses cookies to enhance website functionality and
							user experience. Third-party services, analytics providers and
							affiliates may also use cookies or similar tracking technologies.
						</p>
						<p>
							By using the website, you consent to the use of cookies in
							accordance with the <a href="/privacy">Privacy Policy</a>.
						</p>
						<p>
							<button
								type="button"
								class="legal-inline-btn"
								data-cookie-action="open"
							>
								Manage your cookie preferences
							</button>
						</p>
					</section>

					<section aria-labelledby="external-links" id="external-links">
						<h2>
							<span class="legal-section-num">08</span>
							External Links &amp; Third-Party Content
						</h2>
						<p>
							External links may be provided for convenience and information only.
						</p>
						<p>
							Awaken Discovery does not control, endorse or accept
							responsibility for the content, accuracy, availability or
							reliability of third-party websites, products or services.
						</p>
						<p>You access third-party resources entirely at your own risk.</p>
					</section>

					<section aria-labelledby="liability" id="liability">
						<h2>
							<span class="legal-section-num">09</span>
							Limitation of Liability &amp; Legal Compliance
						</h2>
						<p>
							While reasonable care is taken to ensure accuracy, no
							representations or warranties are made that content will always
							be complete, accurate, current or suitable for your purposes.
						</p>
						<p>
							To the maximum extent permitted by UK law, Awaken Discovery
							excludes all warranties, representations and conditions relating
							to its website, content, products, services, social media
							platforms and online groups.
						</p>
						<p>Nothing in these Terms will:</p>
						<ul>
							<li>Limit or exclude liability for death or personal injury caused by negligence</li>
							<li>Limit or exclude liability for fraud or fraudulent misrepresentation</li>
							<li>Limit any liability that cannot be lawfully excluded</li>
						</ul>
						<p>Awaken Discovery will not be liable for:</p>
						<ul>
							<li>Loss or damage arising from reliance on content or products</li>
							<li>User actions, interpretations or decisions</li>
							<li>User-generated content</li>
							<li>Third-party platforms, links or services</li>
						</ul>
						<p>
							These Terms do not affect your rights or responsibilities under a
							formal counselling contract once therapy has commenced.
						</p>
					</section>

					<section aria-labelledby="governing-law" id="governing-law">
						<h2>
							<span class="legal-section-num">10</span>
							Governing Law &amp; Jurisdiction
						</h2>
						<p>
							These Terms and Conditions are governed by and construed in
							accordance with the laws of <strong>England and Wales</strong>.
						</p>
						<p>
							Any disputes arising in connection with these Terms shall be
							subject to the exclusive jurisdiction of the courts of England
							and Wales.
						</p>
					</section>

					<section aria-labelledby="amendments" id="amendments">
						<h2>
							<span class="legal-section-num">11</span>
							Reservation of Rights &amp; Amendments
						</h2>
						<p>Awaken Discovery reserves the right to:</p>
						<ul>
							<li>Modify, update or remove content, products or services at any time</li>
							<li>Remove user content or links deemed inappropriate or in breach of these Terms</li>
							<li>Amend these Terms and Conditions at any time</li>
						</ul>
						<p>
							Continued use of the website, products, services, social media
							platforms or online groups constitutes acceptance of the revised
							Terms.
						</p>
					</section>

					<section aria-labelledby="bulk-buying" id="bulk-buying">
						<h2>
							<span class="legal-section-num">12</span>
							Bulk Buying Payments
						</h2>
						<p>
							Bulk-buying packages are intended to support ongoing therapeutic
							work, fix dates and offer a reduced session rate in exchange for
							payment in advance. The terms below apply to anyone purchasing a
							bulk package of counselling sessions from Awaken Discovery and
							sit alongside the standard counselling agreement.
						</p>

						<h3 class="legal-subhead">
							<span class="legal-subhead-num">12.1</span>
							Payment Policy
						</h3>
						<p>
							Payment for bulk-buying sessions at Awaken Discovery must be
							made in full before the first session begins.
						</p>
						<p>
							Bulk-buying rates apply only to the specific package purchased
							and are non-transferable to other services or individuals.
						</p>

						<h3 class="legal-subhead">
							<span class="legal-subhead-num">12.2</span>
							Cooling-Off Period
						</h3>
						<p>
							A <strong>14-day cooling-off period</strong> applies from the
							date of purchase. During this period, the buyer may request a
							full refund provided no sessions have commenced. If a session is
							requested and delivered during the cooling-off period, the right
							to cancel and receive a full refund will end once the service
							has begun with the client's agreement.
						</p>
						<p>
							To cancel within this period, please contact
							<a href="mailto:awakendiscoverytherapy@gmail.com"
								>awakendiscoverytherapy@gmail.com</a
							> with proof of purchase.
						</p>

						<h3 class="legal-subhead">
							<span class="legal-subhead-num">12.3</span>
							Non-Refundable Policy After Sessions Begin
						</h3>
						<p>
							Once the first session has been delivered, all bulk package
							payments are <strong>non-refundable</strong>.
						</p>
						<p>
							Unused sessions cannot be refunded, exchanged or credited toward
							other services, except under specific, exceptional circumstances
							which remain at the discretion of Awaken Discovery.
						</p>
						<p>
							No partial refunds will be provided for unused sessions once
							counselling services have commenced.
						</p>

						<h3 class="legal-subhead">
							<span class="legal-subhead-num">12.4</span>
							Session Expiration
						</h3>
						<p>
							All sessions purchased in a bulk package must be used within
							<strong>6 months</strong> of the most recent session attended.
						</p>
						<p>
							Any sessions not used within this period will expire and cannot
							be refunded or extended.
						</p>

						<h3 class="legal-subhead">
							<span class="legal-subhead-num">12.5</span>
							Rescheduling Policy
						</h3>
						<p>
							Clients may reschedule individual sessions with a minimum of
							<strong>48 hours' notice</strong>.
						</p>
						<p>
							Cancellations made with less than 24 hours' notice, or
							non-attendance, will incur the standard cancellation fee as
							outlined in the counselling agreement:
						</p>
						<ul>
							<li>£30 for 60-minute individual sessions</li>
							<li>£45 for 90-minute individual sessions</li>
							<li>£60 for 60-minute couples' sessions</li>
							<li>£70 for 90-minute couples' sessions</li>
						</ul>
						<p>
							While the session is considered missed, it can still be
							rescheduled.
						</p>
						<p>
							Clients also reserve the right to use a session from their bulk
							package to cover the missed session. However, they acknowledge
							that the bulk session's value will typically exceed the incurred
							cancellation fee.
						</p>
						<p>
							If a bulk-purchased session is missed and no contact is made
							within 48 hours after the session, it will be considered used
							and cannot be rescheduled, refunded or reinstated.
						</p>

						<h3 class="legal-subhead">
							<span class="legal-subhead-num">12.6</span>
							Exceptional Circumstances
						</h3>
						<p>
							Awaken Discovery reserves the right to consider extensions,
							credits or alternative arrangements in exceptional
							circumstances, including serious illness, bereavement or other
							significant life events. Any such arrangements are made solely
							at the discretion of Awaken Discovery and do not create an
							ongoing entitlement.
						</p>
						<p>
							Any discretion exercised under this clause does not
							automatically waive cancellation fees or missed session charges.
						</p>

						<h3 class="legal-subhead">
							<span class="legal-subhead-num">12.7</span>
							Changes to These Terms
						</h3>
						<p>
							Awaken Discovery reserves the right to amend these bulk-buying
							terms and conditions, with notice provided to clients currently
							on bulk payments before implementing changes.
						</p>

						<h3 class="legal-subhead">
							<span class="legal-subhead-num">12.8</span>
							Contact
						</h3>
						<p>
							If you have any questions regarding these Bulk Buying Payment
							Terms, please contact
							<a href="mailto:awakendiscoverytherapy@gmail.com"
								>awakendiscoverytherapy@gmail.com</a
							>.
						</p>
					</section>

					<p class="legal-footnote">
						<em>
							This document should be read alongside the Awaken Discovery
							<a href="/privacy">Privacy Policy</a>.
						</em>
					</p>
				</article>
			</div>
		</section>
	</main>
	<SiteFooter locations={locations} />
</Layout>

<style>
	.legal-page {
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		--ink: var(--color-dark-gray);
		--ink-soft: rgb(29 35 39 / 78%);
	}

	/* ---------- HERO ---------- */
	.legal-hero {
		background: linear-gradient(180deg, var(--color-white) 0%, var(--brand-tint) 100%);
		padding-top: clamp(3rem, 6vw, 5rem);
		padding-bottom: clamp(2rem, 4vw, 3.5rem);
		border-bottom: 1px solid rgb(0 94 71 / 12%);
	}

	.legal-hero-inner {
		max-width: 70ch;
	}

	.section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-size: 0.74rem;
		font-weight: 600;
		color: var(--brand);
	}

	.legal-page h1 {
		margin: 0.7rem 0 0.3rem;
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		font-weight: 500;
		line-height: 1.1;
		color: var(--brand-deep);
		letter-spacing: -0.01em;
	}

	.legal-subtitle {
		margin: 0;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(1.05rem, 1.6vw, 1.25rem);
		color: var(--ink-soft);
	}

	.legal-meta {
		margin: 1.4rem 0 0;
		display: inline-flex;
		align-items: baseline;
		gap: 0.45rem;
		padding: 0.35rem 0.8rem;
		background: var(--color-white);
		border: 1px solid rgb(0 94 71 / 18%);
		border-radius: 999px;
		font-size: 0.78rem;
		color: var(--ink-soft);
	}

	.legal-meta span {
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-weight: 600;
		color: var(--brand);
	}

	/* ---------- LAYOUT ---------- */
	.legal-body {
		padding-top: clamp(2.5rem, 5vw, 4rem);
	}

	.legal-body-inner {
		display: grid;
		grid-template-columns: 260px minmax(0, 1fr);
		gap: clamp(2rem, 4vw, 4rem);
		align-items: start;
	}

	/* ---------- TOC ---------- */
	.legal-toc {
		position: sticky;
		top: 6.5rem;
		max-height: calc(100vh - 8rem);
		overflow-y: auto;
		padding-right: 0.5rem;
	}

	.legal-toc-title {
		margin: 0 0 0.9rem;
		font-family: var(--font-serif);
		font-size: 0.95rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--brand);
	}

	.legal-toc-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.05rem;
		border-left: 1px solid rgb(0 94 71 / 18%);
	}

	.legal-toc-list a {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: 0.3rem;
		padding: 0.45rem 0.9rem;
		font-size: 0.85rem;
		line-height: 1.4;
		color: var(--ink-soft);
		text-decoration: none;
		border-left: 2px solid transparent;
		margin-left: -1px;
		transition: color 0.18s ease, border-color 0.18s ease, background-color 0.18s ease;
	}

	.legal-toc-list a:hover,
	.legal-toc-list a:focus-visible {
		color: var(--brand-deep);
		background: var(--brand-tint);
		border-left-color: var(--brand);
		outline: none;
	}

	.legal-toc-num {
		font-family: var(--font-serif);
		font-style: italic;
		color: var(--brand);
		opacity: 0.7;
	}

	/* ---------- ARTICLE ---------- */
	.legal-article {
		max-width: 70ch;
	}

	.legal-article h2 {
		margin: 2.8rem 0 1.1rem;
		font-family: var(--font-serif);
		font-size: clamp(1.45rem, 2.6vw, 1.85rem);
		font-weight: 500;
		line-height: 1.25;
		color: var(--brand-deep);
		scroll-margin-top: 6.5rem;
		display: flex;
		align-items: baseline;
		gap: 0.7rem;
		text-wrap: balance;
		flex-wrap: wrap;
	}

	.legal-article > section:first-of-type > h2 {
		margin-top: 1.6rem;
	}

	.legal-section-num {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.05rem;
		color: var(--brand);
		opacity: 0.7;
		flex-shrink: 0;
	}

	.legal-subhead {
		font-family: var(--font-serif);
		font-size: clamp(1.15rem, 1.05rem + 0.35vw, 1.35rem);
		font-weight: 500;
		color: var(--brand-deep);
		margin: 2.2rem 0 0.9rem;
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		text-wrap: balance;
