---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { locations, navItems } from "../../data/site";
import { calendlyLinks } from "../../data/calendly";

const reference = Astro.url.searchParams.get("ref")?.trim() || "";
---

<Layout
	title="Thank You · Bulk Sessions · Awaken Discovery"
	description="Your bulk session request has been received."
>
	<SiteHeader navItems={navItems} />
	<main class="bt-page">
		<section class="section">
			<div class="container bt-inner">
				<p class="section-kicker">Bulk sessions</p>
				<h1>Thank you</h1>
				<p class="bt-lede">
					We've received your request
					{reference ? ` (reference ${reference})` : ""}. A confirmation email
					is on its way — please check your inbox (and spam folder just in case).
				</p>
				{
					reference && (
						<p class="bt-ref">
							<strong>Your reference:</strong> {reference}
						</p>
					)
				}
				<p class="bt-copy">
					If you completed payment on Stripe, please keep your Stripe receipt —
					Ally matches it to this reference. If you asked to speak first, she'll
					be in touch within one working day.
				</p>
				<div class="bt-actions">
					<a
						class="cta cta-solid"
						href={calendlyLinks.tasterSession}
						target="_blank"
						rel="noopener noreferrer"
					>
						Book a free 30-min consultation
					</a>
					<a class="cta cta-outline" href="/pricing">Back to pricing</a>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter
		locations={locations}
		tagline="Calm, transparent pricing — book a bundle or a single session."
	/>
</Layout>

<style>
	.bt-page {
		--brand-deep: #004836;
		--muted: #5b656b;
	}

	.bt-inner {
		max-width: 36rem;
		padding-block: 2rem 4rem;
	}

	.bt-lede,
	.bt-copy {
		margin: 0.85rem 0 0;
		font-size: 1.05rem;
		line-height: 1.65;
		color: var(--muted);
	}

	.bt-ref {
		margin: 1.25rem 0 0;
		padding: 0.85rem 1rem;
		background: #f3f6f4;
		border: 1px solid rgba(0, 94, 71, 0.18);
		border-radius: 0.65rem;
		color: var(--brand-deep);
	}

	.bt-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
</style>
