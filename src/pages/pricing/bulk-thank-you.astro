---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { locations, navItems } from "../../data/site";
import { calendlyLinks } from "../../data/calendly";

const reference = Astro.url.searchParams.get("ref")?.trim() || "";
---

<Layout
	title="Thank You · Bulk Sessions · Awaken Discovery"
	description="Your bulk session request has been received — Ally will be in touch with next steps shortly."
	noindex={true}
>
	<SiteHeader navItems={navItems} />
	<main class="bt-page">
		<section class="bt-hero section">
			<div class="container bt-hero-inner">
				<p class="bt-eyebrow">Bulk sessions</p>
				<h1>Thank you</h1>
				<p class="bt-lede">
					We've received your request
					{reference ? ` (reference ${reference})` : ""}. A confirmation email
					is on its way — please check your inbox (and spam folder just in case).
				</p>
				{
					reference && (
						<p class="bt-ref">
							<strong>Your reference:</strong> {reference}
						</p>
					)
				}
				<p class="bt-copy">
					If you completed payment on Stripe, please keep your Stripe receipt —
					Ally matches it to this reference. If you asked to speak first, she'll
					be in touch within one working day.
				</p>
				<div class="bt-actions">
					<a
						class="cta cta-solid"
						href={calendlyLinks.tasterSession}
						target="_blank"
						rel="noopener noreferrer"
					>
						Book a free 30-min consultation
					</a>
					<a class="cta cta-outline" href="/pricing">Back to pricing</a>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter
		locations={locations}
		tagline="Calm, transparent pricing — book a bundle or a single session."
	/>
</Layout>

<style>
	.bt-page {
		--ink: var(--color-dark-gray);
		--ink-soft: rgb(29 35 39 / 78%);
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		color: var(--ink);
	}

	.bt-hero {
		background: linear-gradient(180deg, var(--color-white) 0%, var(--brand-tint) 100%);
		padding-top: 4rem;
	}

	.bt-hero-inner {
		max-width: 760px;
	}

	.bt-eyebrow {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--brand);
	}

	.bt-hero h1 {
		margin: 0.6rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		font-weight: 500;
		line-height: 1.12;
		color: var(--brand-deep);
		text-wrap: balance;
	}

	.bt-lede,
	.bt-copy {
		margin: 0;
		max-width: 60ch;
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		line-height: 1.7;
		color: var(--ink-soft);
	}

	.bt-copy {
		margin-top: 0.85rem;
		font-size: 1.05rem;
	}

	.bt-ref {
		margin: 1.25rem 0 0;
		padding: 0.85rem 1rem;
		max-width: 60ch;
		background: var(--brand-tint);
		border: 1px solid rgba(0, 94, 71, 0.18);
		border-radius: 0.65rem;
		color: var(--brand-deep);
	}

	.bt-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}
</style>
