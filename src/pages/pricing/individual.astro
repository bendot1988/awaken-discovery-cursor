---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { locations, navItems } from "../../data/site";
import { calendlyLinks } from "../../data/calendly";
import {
	sixtyMinuteSessionPayUrl,
	ninetyMinuteSessionPayUrl,
	couplesNinetyMinuteSessionPayUrl,
	couplesSixtyOnlineSessionPayUrl,
	couplesSixtyFaceToFaceSessionPayUrl,
} from "../../data/products";

type SingleCard = {
	type: "ind" | "cou";
	duration: string;
	format: string;
	price: string;
	headlinePrice: string;
	headerVariant: "dark" | "sage";
	popular: boolean;
	bullets: string[];
	bookHref: string;
	/** Optional Stripe pay link — shown as a second CTA when present. */
	payHref?: string;
};

const singleCards: SingleCard[] = [
	{
		type: "ind",
		duration: "60 min",
		format: "Individual — Face to Face",
		price: "£60",
		headlinePrice: "60",
		headerVariant: "dark",
		popular: true,
		bullets: [
			"Ideal for ongoing emotional support",
			"In-person sessions in a calm, private setting",
			"Pay per session, book at your own pace",
		],
		bookHref: calendlyLinks.individual.sixtyFaceToFace,
		payHref: sixtyMinuteSessionPayUrl,
	},
	{
		type: "ind",
		duration: "60 min",
		format: "Individual — Online or Phone",
		price: "£60",
		headlinePrice: "60",
		headerVariant: "sage",
		popular: false,
		bullets: [
			"Same support, wherever feels safest",
			"Secure video or phone, no travel needed",
			"Pay per session, book at your own pace",
		],
		bookHref: calendlyLinks.individual.sixtyOnline,
		payHref: sixtyMinuteSessionPayUrl,
	},
	{
		type: "ind",
		duration: "90 min",
		format: "Individual — Face to Face",
		price: "£90",
		headlinePrice: "90",
		headerVariant: "sage",
		popular: false,
		bullets: [
			"Extended time to go deeper",
			"Ideal for trauma or complex work",
			"Pay per session, book at your own pace",
		],
		bookHref: calendlyLinks.individual.ninetyFaceToFace,
		payHref: ninetyMinuteSessionPayUrl,
	},
	{
		type: "cou",
		duration: "60 min",
		format: "Couples — Face to Face",
		price: "£90",
		headlinePrice: "90",
		headerVariant: "dark",
		popular: true,
		bullets: [
			"A safe, neutral space for both partners",
			"60 minutes of guided conversation",
			"Pay per session, book at your own pace",
		],
		bookHref: calendlyLinks.couples.sixtyFaceToFace,
		payHref: couplesSixtyFaceToFaceSessionPayUrl,
	},
	{
		type: "cou",
		duration: "60 min",
		format: "Couples — Online or Phone",
		price: "£90",
		headlinePrice: "90",
		headerVariant: "sage",
		popular: false,
		bullets: [
			"Connect from home, together or apart",
			"Secure video or phone for both partners",
			"Pay per session, book at your own pace",
		],
		bookHref: calendlyLinks.couples.sixtyOnline,
		payHref: couplesSixtyOnlineSessionPayUrl,
	},
	{
		type: "cou",
		duration: "90 min",
		format: "Couples — Face to Face, Online or Phone",
		price: "£130",
		headlinePrice: "130",
		headerVariant: "sage",
		popular: false,
		bullets: [
			"Extended time for deeper work together",
			"Space to unpack big topics in one sitting",
			"Pay per session, book at your own pace",
		],
		bookHref: calendlyLinks.couples.ninetyFaceToFace,
		payHref: couplesNinetyMinuteSessionPayUrl,
	},
];
---

<Layout
	title="Individual Session Pricing · Awaken Discovery"
	description="Single-session pricing for individual and couples therapy. 60 or 90 minutes, face to face, online or phone — book one session at a time."
>
	<SiteHeader navItems={navItems} />

	<main class="pr-page">
		<!-- ============== HERO ============== -->
		<section class="pr-hero section">
			<div class="container">
				<div class="pr-hero-inner">
					<p class="section-kicker">Pricing</p>
					<h1>Individual Sessions</h1>
					<p class="pr-lede">
						Pay per session, no commitment. Choose the format that suits you —
						60 or 90 minutes, in person, online or over the phone.
					</p>
					<p class="pr-note">
						Sessions can be booked one at a time. If you'd prefer to book a
						block of sessions and save 10%, see our <a href="/pricing">bulk session pricing</a>.
					</p>
					<p class="pr-note pr-note-soft">
						All sessions are with Ally, MBACP-registered therapist. Free
						30-minute consultations available before your first session.
					</p>
				</div>
			</div>
		</section>

		<!-- ============== SESSIONS — TABS ============== -->
		<section class="pr-bulk section section-soft" id="sessions">
			<div class="container">
				<header class="pr-bulk-head">
					<p class="section-kicker">Single sessions</p>
					<h2>Choose Individual or Couples</h2>
					<p class="pr-bulk-lede">
						Both options include the same calm, paced approach. Pick the format
						below — pricing and what's included updates accordingly.
					</p>
				</header>

				<div class="pr-tabs">
					<input
						type="radio"
						name="pr-tab"
						id="pr-tab-ind"
						class="pr-tab-input"
						checked
					/>
					<input
						type="radio"
						name="pr-tab"
						id="pr-tab-cou"
						class="pr-tab-input"
					/>

					<div class="pr-tab-switch" role="tablist" aria-label="Pricing for">
						<label for="pr-tab-ind" class="pr-tab-label">Individuals</label>
						<label for="pr-tab-cou" class="pr-tab-label">Couples</label>
					</div>

					<div class="pr-tab-panels">
						{
							(["ind", "cou"] as const).map((group) => (
								<div class={`pr-tab-panel pr-tab-panel-${group}`}>
									<div class="pr-card-grid pr-card-grid-3">
										{singleCards
											.filter((c) => c.type === group)
											.map((card) => (
												<article
													class={`pr-card pr-card-${card.headerVariant}`}
												>
													{card.popular && (
														<span class="pr-popular" aria-hidden="true">
															Popular
														</span>
													)}
													<header class="pr-card-header">
														<p class="pr-card-eyebrow">{card.duration}</p>
														<h3>{card.format}</h3>
													</header>
													<div class="pr-card-body">
														<p class="pr-card-price">
															<span class="pr-card-currency">£</span>
															<span class="pr-card-amount">
																{card.headlinePrice}
															</span>
														</p>
														<p class="pr-card-save">Available to book now</p>
														<ul class="pr-card-bullets">
															{card.bullets.map((b) => (
																<li>{b}</li>
															))}
														</ul>
														<div class="pr-card-actions">
															<a
																class="cta cta-solid pr-card-cta"
																href={card.bookHref}
																target="_blank"
																rel="noopener noreferrer"
																aria-label={`Book ${card.duration} ${card.format}`}
															>
																Book Now
															</a>
															{card.payHref && (
																<a
																	class="cta cta-outline pr-card-cta"
																	href={card.payHref}
																	target="_blank"
																	rel="noopener noreferrer"
																	aria-label={`Pay for ${card.duration} ${card.format}`}
																>
																	Pay Now
																</a>
															)}
														</div>
														<p class="pr-card-fineprint">
															{card.payHref
																? `Book a time via Calendly, or pay for a ${card.price} session securely via Stripe.`
																: "Single sessions — pay per session. Booking opens in a new tab via my Calendly."}
														</p>
													</div>
												</article>
											))}
									</div>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- ============== BULK CROSS-SELL ============== -->
		<section class="pr-bundle-cross section">
			<div class="container">
				<aside class="pr-bundle-banner">
					<div>
						<p class="section-kicker">Booking more than one?</p>
						<h2 class="pr-bundle-title">Save 10% with bulk session bundles</h2>
						<p class="pr-bundle-body">
							Bulk session bundles of 6 or 10 <strong>60-minute</strong> sessions
							save 10% against the single-session rate. Useful for focused,
							ongoing work — pay once and book at your own pace.
						</p>
					</div>
					<a class="cta cta-solid" href="/pricing">See Bundle Pricing →</a>
				</aside>
			</div>
		</section>

		<!-- ============== SOFT CLOSE ============== -->
		<section class="pr-close section">
			<div class="container">
				<div class="pr-close-inner">
					<p class="section-kicker">Not sure yet?</p>
					<h2>Start with a free consultation</h2>
					<p class="pr-close-body">
						If you'd like to chat before booking, you're warmly welcome to start
						with a free 30-minute consultation. We can talk through what's on
						your mind and find the format that feels right.
					</p>
					<div class="pr-close-actions">
						<a
							class="cta cta-solid"
							href={calendlyLinks.tasterSession}
							target="_blank"
							rel="noopener noreferrer"
						>
							Book a Free Consultation
						</a>
						<a class="cta cta-outline" href="/therapy">Learn About Therapy</a>
					</div>
				</div>
			</div>
		</section>
	</main>

	<SiteFooter
		locations={locations}
		tagline="Pay-per-session therapy — no commitment, just space to begin."
	/>
</Layout>

<style>
	.pr-page {
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		--ink: var(--color-dark-gray);
		--ink-soft: rgb(29 35 39 / 78%);
		color: var(--ink);
	}

	.pr-page .section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--brand);
	}

	.pr-page h1,
	.pr-page h2 {
		font-family: var(--font-serif);
		font-weight: 500;
		text-wrap: balance;
		color: var(--brand-deep);
	}

	.pr-page h1 {
		margin: 0.6rem 0 1rem;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		line-height: 1.12;
	}

	.pr-page h2 {
		margin: 0.6rem 0 0.9rem;
		font-size: clamp(1.7rem, 3.3vw, 2.4rem);
		line-height: 1.2;
	}

	/* ---------- HERO ---------- */
	.pr-hero {
		background: linear-gradient(180deg, var(--color-white) 0%, var(--brand-tint) 100%);
		padding-top: 4rem;
	}

	.pr-hero-inner {
		max-width: 760px;
	}

	.pr-lede {
		margin: 0 0 1.2rem;
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		line-height: 1.7;
		color: var(--ink-soft);
		max-width: 60ch;
	}

	.pr-note {
		margin: 0 0 0.7rem;
		line-height: 1.7;
	}

	.pr-note-soft {
		font-size: 0.92rem;
		color: var(--ink-soft);
	}

	.pr-note a {
		color: var(--brand);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* ---------- BULK / TABS ---------- */
	.pr-bulk-head {
		text-align: center;
		max-width: 62ch;
		margin: 0 auto 2rem;
	}

	.pr-bulk-lede {
		margin: 0;
		color: var(--ink-soft);
		line-height: 1.75;
	}

	.pr-tabs {
		position: relative;
	}

	.pr-tab-input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.pr-tab-switch {
		display: flex;
		justify-content: center;
		max-width: max-content;
		margin: 0 auto 2.5rem;
		padding: 0.3rem;
		gap: 0.3rem;
		border-radius: 999px;
		background: var(--brand-tint);
		border: 1px solid rgb(0 94 71 / 18%);
	}

	.pr-tab-label {
		padding: 0.55rem 1.4rem;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 500;
		cursor: pointer;
		color: var(--ink-soft);
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.pr-tab-label:hover {
		color: var(--brand-deep);
	}

	#pr-tab-ind:checked ~ .pr-tab-switch label[for="pr-tab-ind"],
	#pr-tab-cou:checked ~ .pr-tab-switch label[for="pr-tab-cou"] {
		background: var(--color-white);
		color: var(--brand-deep);
		box-shadow: 0 1px 4px rgb(0 94 71 / 18%);
	}

	#pr-tab-ind:focus-visible ~ .pr-tab-switch label[for="pr-tab-ind"],
	#pr-tab-cou:focus-visible ~ .pr-tab-switch label[for="pr-tab-cou"] {
		outline: 2px solid var(--brand);
		outline-offset: 2px;
	}

	.pr-tab-panel {
		display: none;
	}

	#pr-tab-ind:checked ~ .pr-tab-panels .pr-tab-panel-ind {
		display: block;
	}

	#pr-tab-cou:checked ~ .pr-tab-panels .pr-tab-panel-cou {
		display: block;
	}

	/* ---------- CARDS ---------- */
	.pr-card-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.4rem;
		align-items: stretch;
	}

	.pr-card-grid-3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.pr-card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		background: var(--color-white);
		border: 1px solid rgb(0 94 71 / 16%);
		border-radius: 1rem;
		overflow: hidden;
		box-shadow: 0 18px 36px rgb(0 94 71 / 14%);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.pr-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 22px 44px rgb(0 94 71 / 18%);
	}

	.pr-popular {
		position: absolute;
		top: 0.9rem;
		right: 0.9rem;
		padding: 0.25rem 0.7rem;
		border-radius: 999px;
		background: var(--brand);
		color: var(--color-white);
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		z-index: 1;
	}

	.pr-card-header {
		padding: 1.6rem 1.4rem 0.9rem;
		text-align: center;
	}

	.pr-card-dark .pr-card-header {
		background: var(--brand-deep);
		color: var(--color-white);
	}

	.pr-card-sage .pr-card-header {
		background: var(--brand-tint);
		color: var(--brand-deep);
	}

	.pr-card-eyebrow {
		margin: 0 0 0.35rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.72rem;
		font-weight: 600;
		opacity: 0.8;
	}

	.pr-card-header h3 {
		margin: 0;
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 1.25rem;
		line-height: 1.25;
		text-wrap: balance;
	}

	.pr-card-body {
		padding: 1.4rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		flex: 1 1 auto;
	}

	.pr-card-price {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 2.6rem;
		line-height: 1;
		color: var(--brand);
	}

	.pr-card-currency {
		font-size: 1.4rem;
		vertical-align: top;
		margin-right: 0.15rem;
	}

	.pr-card-amount {
		font-weight: 500;
	}

	.pr-card-save {
		margin: 0.4rem 0 1.1rem;
		font-size: 0.82rem;
		color: var(--ink-soft);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.pr-card-bullets {
		list-style: none;
		margin: 0;
		padding: 0;
		text-align: left;
		display: grid;
		gap: 0.5rem;
		max-width: 32ch;
		margin-inline: auto;
	}

	.pr-card-bullets li {
		position: relative;
		padding-left: 1.4rem;
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--ink-soft);
	}

	.pr-card-bullets li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.45rem;
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: var(--brand);
		opacity: 0.65;
	}

	.pr-card-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.55rem;
		margin-top: auto;
		padding-top: 1.4rem;
		margin-bottom: 0.9rem;
	}

	.pr-card-cta {
		align-self: center;
		min-width: 120px;
		margin-bottom: 0;
	}

	.pr-card-fineprint {
		margin: 0;
		font-size: 0.74rem;
		line-height: 1.55;
		color: var(--ink-soft);
		max-width: 32ch;
		margin-inline: auto;
	}

	/* ---------- BUNDLE CROSS-SELL ---------- */
	.pr-bundle-banner {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 1.4rem;
		padding: 1.6rem clamp(1.4rem, 3vw, 2rem);
		background: var(--color-white);
		border: 1px solid rgb(0 94 71 / 18%);
		border-left: 4px solid var(--brand);
		border-radius: 0.9rem;
		box-shadow: 0 12px 28px rgb(0 94 71 / 10%);
	}

	.pr-bundle-title {
		margin: 0.2rem 0 0.5rem;
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(1.3rem, 2.4vw, 1.6rem);
		color: var(--brand-deep);
	}

	.pr-bundle-body {
		margin: 0;
		color: var(--ink-soft);
		line-height: 1.7;
		max-width: 62ch;
	}

	/* ---------- SOFT CLOSE ---------- */
	.pr-close-inner {
		max-width: 60ch;
		text-align: center;
		margin: 0 auto;
	}

	.pr-close-body {
		margin: 0 0 1.6rem;
		color: var(--ink-soft);
		line-height: 1.75;
	}

	.pr-close-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		justify-content: center;
	}

	/* ---------- RESPONSIVE ---------- */
	@media (max-width: 960px) {
		.pr-card-grid-3 {
			grid-template-columns: 1fr;
			max-width: 480px;
			margin-inline: auto;
		}

		.pr-bundle-banner {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.pr-bundle-banner > a {
			justify-self: center;
		}
	}

	@media (max-width: 520px) {
		.pr-tab-switch {
			width: 100%;
			max-width: none;
			justify-content: stretch;
		}

		.pr-tab-label {
			flex: 1;
			text-align: center;
			padding: 0.6rem 0.6rem;
			font-size: 0.85rem;
		}
	}
</style>
