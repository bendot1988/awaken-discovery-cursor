---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/home/Hero.astro";
import MeetAlly from "../components/home/MeetAlly.astro";
import SupportCardsGrid from "../components/home/SupportCardsGrid.astro";
import AboutPanel from "../components/home/AboutPanel.astro";
import TherapyServices from "../components/home/TherapyServices.astro";
import JourneySteps from "../components/home/JourneySteps.astro";
import Testimonials from "../components/home/Testimonials.astro";
import Pricing from "../components/home/Pricing.astro";
import EmailSignup from "../components/home/EmailSignup.astro";
import Layout from "../layouts/Layout.astro";
import {
	additionalSupport,
	journeySteps,
	locations,
	navItems,
	pricingTiers,
	supportCards,
	therapyServices,
} from "../data/site";
---

<Layout localBusiness>
	<SiteHeader navItems={navItems} />
	<main>
		<Hero />
		<MeetAlly />
		<SupportCardsGrid cards={supportCards} />
		<AboutPanel />
		<TherapyServices therapy={therapyServices} additional={additionalSupport} />
		<JourneySteps steps={journeySteps} />
		<Testimonials />
		<Pricing tiers={pricingTiers} />
		<EmailSignup
			guideImage="/assets/images/holding-too-much-guide-mockup.png"
			useSenderForm
			senderList="holding-too-much"
		/>
	</main>
	<SiteFooter locations={locations} />
</Layout>
