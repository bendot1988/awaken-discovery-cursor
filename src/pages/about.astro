---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { locations, navItems } from "../data/site";

const pillars = [
	{
		title: "Integrative & humanistic",
		body: "Therapy tailored to you as a whole person — not a one-size-fits-all method or diagnosis.",
	},
	{
		title: "Nervous-system aware",
		body: "Holding the connection between emotions, mind, body and the way stress has been carried.",
	},
	{
		title: "Relational & gentle",
		body: "Compassionate, collaborative work paced carefully around what feels safe for you.",
	},
	{
		title: "Human, not clinical",
		body: "A space to pause, exhale and be heard — not judged, fixed or rushed.",
	},
];

const chapters = [
	{
		number: "01",
		title: "Twenty-five years in education",
		teaser:
			"How my path into therapy began alongside young people, families and colleagues.",
		paragraphs: [
			"Before training as a counsellor and psychotherapist, I spent twenty-five years working within education. During that time, I supported young people, families, and colleagues through increasingly demanding emotional, personal, and professional challenges.",
			"What stayed with me most throughout those years was not simply how much people were coping with — but how often they were coping alone.",
		],
	},
	{
		number: "02",
		title: "What I noticed beneath the coping",
		teaser:
			"Functioning outwardly while struggling internally is far more common than most realise.",
		paragraphs: [
			"Again and again, I saw people continuing to function outwardly whilst internally feeling anxious, emotionally overwhelmed, mentally exhausted, disconnected from themselves, or unsure how much longer they could continue carrying the pressure they were under.",
			"Many had become so used to surviving within stress, responsibility, caring roles, or constant expectation that they no longer recognised how deeply it was affecting their wellbeing, relationships, confidence, identity, and nervous system over time.",
			"This deeper understanding of human emotional experience became one of the reasons I felt drawn toward counselling and psychotherapy.",
		],
	},
	{
		number: "03",
		title: "How I work — integrative & humanistic",
		teaser:
			"Therapy that begins with you as a whole person, not a model or diagnosis.",
		paragraphs: [
			"My work today is grounded in an integrative humanistic approach, which means I see every person as entirely unique. Rather than believing people should fit neatly into a particular model or diagnosis, I begin with understanding the individual sitting in front of me — their experiences, emotions, relationships, history, and the ways life has shaped how they move through the world.",
			"I work relationally, compassionately, and collaboratively. Therapy with me is not about judgement, fixing, or being told how you should think or feel. It is about creating a space where you can safely slow down, breathe, reflect, untangle what has been building internally, and begin reconnecting with yourself more gently and honestly.",
		],
	},
	{
		number: "04",
		title: "The nervous system, mind & body",
		teaser:
			"Why anxiety, burnout and overthinking are signs of a system carrying too much.",
		paragraphs: [
			"Alongside my therapeutic training, I hold a strong interest in the connection between emotional wellbeing, the nervous system, mind, and body. Often, anxiety, burnout, emotional exhaustion, overthinking, or feeling constantly \u201con alert\u201d are not signs that something is wrong with you — but signs that your system has been carrying too much for too long.",
			"Many people I work with describe feeling disconnected from themselves beneath years of pressure, responsibility, people-pleasing, caring for others, or constantly trying to hold everything together. Therapy offers an opportunity to begin understanding these patterns with compassion rather than criticism.",
			"Through both professional experience and personal understanding of anxiety and stress, I recognise how difficult life can feel when the nervous system rarely has the opportunity to fully rest.",
		],
	},
	{
		number: "05",
		title: "Who I work with",
		teaser:
			"Adults, couples and young people — including those who quietly support everyone else.",
		paragraphs: [
			"My approach is gentle, grounded, reflective, and emotionally attuned. I believe healing begins not through pressure or perfection, but through feeling emotionally safe enough to be fully heard, understood, and accepted as you are.",
			"Alongside supporting adults, couples, and young people more broadly, my background within education gives me a particular understanding of the emotional pressures experienced by teachers, helping professionals, carers, and those who spend much of their lives supporting everyone else whilst quietly neglecting themselves.",
		],
	},
	{
		number: "06",
		title: "Why Awaken Discovery exists",
		teaser:
			"A space to pause, in a world that asks us to keep performing.",
		paragraphs: [
			"Awaken Discovery was created from a desire to offer something more human within a world that often asks people to keep performing, coping, and pushing through regardless of how disconnected or exhausted they may feel inside.",
			"I wanted to create a space where people could pause. A space where they no longer had to carry everything alone.",
		],
	},
	{
		number: "07",
		title: "What working together may feel like",
		teaser: "Collaborative, paced around you, and above all — human.",
		paragraphs: [
			"Therapy sessions with me are collaborative, supportive, reflective, and paced carefully around you. There is no expectation to explain yourself perfectly, have all the answers, or arrive knowing exactly where to begin.",
			"Sometimes therapy may involve gently exploring emotions, patterns, relationships, anxiety, self-doubt, or experiences that have been difficult to process alone. At other times, it may simply involve having a space where you can finally exhale, speak honestly, and feel heard without pressure or judgement.",
			"Above all, I believe therapy should feel human.",
		],
	},
];
---

<Layout
	title="About Ally · Awaken Discovery"
	description="Meet Ally — founder of Awaken Discovery. Counsellor and psychotherapist supporting anxiety, burnout, emotional overwhelm and reconnection through compassionate, integrative humanistic therapy."
>
	<SiteHeader navItems={navItems} />
	<main class="about-page">
		<!-- ============== BRAND / INTRO ============== -->
		<section class="about-brand section">
			<div class="container about-brand-inner">
				<svg
					class="about-brand-leaf"
					viewBox="0 0 60 60"
					aria-hidden="true"
				>
					<path
						d="M30 5C42 14 50 25 50 36C50 46 42 54 30 55C18 54 10 46 10 36C10 25 18 14 30 5Z"
						fill="currentColor"
						opacity="0.16"
					></path>
					<path
						d="M30 10C30 25 30 40 30 55"
						stroke="currentColor"
						stroke-width="1"
						opacity="0.55"
						fill="none"
					></path>
				</svg>
				<p class="section-kicker">About</p>
				<h1 class="about-wordmark">Awaken Discovery</h1>
				<p class="about-tagline">Counselling &amp; Psychotherapy</p>
				<p class="about-brand-lede">
					Supporting emotional wellbeing, anxiety, burnout, self-understanding,
					healing and reconnection through compassionate therapeutic support.
				</p>
			</div>
		</section>

		<!-- ============== MEET ALLY (short) ============== -->
		<section class="about-meet section section-soft" id="meet">
			<div class="container about-meet-grid">
				<figure class="about-portrait">
					<img
						src="/assets/images/ally-with-client.jpg"
						alt="Ally in session with a client — sitting on a sofa in her warm, plant-filled therapy room"
						width="768"
						height="1024"
						loading="lazy"
						decoding="async"
					/>
				</figure>

				<div class="about-meet-copy">
					<p class="section-kicker">Meet Ally</p>
					<h2>Hello, I'm Ally — founder of Awaken Discovery.</h2>
					<p>
						Before becoming a counsellor and psychotherapist, I spent
						twenty-five years working within education, supporting young
						people, families, and colleagues through the emotional pressures
						and challenges that life can bring. Over time, I found myself
						increasingly drawn toward understanding the deeper emotional
						experiences that often sit quietly beneath anxiety, overwhelm,
						burnout, and the constant pressure many people place upon
						themselves simply to keep going.
					</p>
					<p>
						Today, I work with adults, couples, and young people who may feel
						emotionally exhausted, anxious, disconnected from themselves, or
						lost beneath the weight of trying to hold everything together for
						everyone else.
					</p>
					<p class="about-emphasis">
						Therapy with me is not about being judged, fixed or told what to
						do. It is about creating space — to pause, breathe, reflect, and
						begin reconnecting with who you are beneath the survival mode.
					</p>
					<div class="about-meet-ctas">
						<a class="cta cta-solid" href="/contact">Book a Session</a>
						<a class="cta cta-outline" href="/contact">Book a Consultation</a>
					</div>
				</div>
			</div>
		</section>

		<!-- ============== APPROACH PILLARS ============== -->
		<section class="about-pillars section">
			<div class="container">
				<header class="about-section-head">
					<p class="section-kicker">My approach</p>
					<h2>Four threads that run through every session.</h2>
				</header>
				<ul class="about-pillar-grid">
					{
						pillars.map((p) => (
							<li class="about-pillar">
								<span class="about-pillar-dot" aria-hidden="true" />
								<h3>{p.title}</h3>
								<p>{p.body}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<!-- ============== PULL QUOTE ============== -->
		<section class="about-quote section">
			<div class="container">
				<figure class="about-quote-figure">
					<blockquote>
						<p>
							Healing begins not through pressure or perfection, but through
							feeling emotionally safe enough to be fully heard, understood
							and accepted as you are.
						</p>
					</blockquote>
					<figcaption>— Ally</figcaption>
				</figure>
			</div>
		</section>

		<!-- ============== CHAPTERS (long-form, hidden in accordions) ============== -->
		<section class="about-chapters section section-soft" id="learn-more">
			<div class="container about-chapters-inner">
				<header class="about-section-head">
					<p class="section-kicker">Learn more about Ally</p>
					<h2>A longer story — read at your own pace.</h2>
					<p class="about-chapters-lede">
						If you'd like a fuller sense of who I am and how I work, the
						chapters below open one at a time. Read what feels relevant. Skip
						what doesn't.
					</p>
				</header>

				<div class="about-chapters-layout">
					<aside class="about-chapters-aside">
						<figure class="about-chapters-figure">
							<img
								src="/assets/images/ally-by-bookshelf.jpg"
								alt="Ally standing by a plant-filled bookshelf in her therapy room, holding a sage mug"
								width="768"
								height="1024"
								loading="lazy"
								decoding="async"
							/>
						</figure>
					</aside>

					<ol class="about-chapter-list">
						{
							chapters.map((c) => (
								<li>
									<details class="about-chapter">
										<summary>
											<span class="about-chapter-num">{c.number}</span>
											<span class="about-chapter-titles">
												<span class="about-chapter-title">{c.title}</span>
												<span class="about-chapter-teaser">{c.teaser}</span>
											</span>
											<span class="about-chapter-icon" aria-hidden="true">
												+
											</span>
										</summary>
										<div class="about-chapter-body">
											{c.paragraphs.map((para) => (
												<p>{para}</p>
											))}
										</div>
									</details>
								</li>
							))
						}
					</ol>
				</div>
			</div>
		</section>

		<!-- ============== QUALIFICATIONS ============== -->
		<section class="about-quals section" id="qualifications">
			<div class="container about-quals-inner">
				<header class="about-section-head">
					<p class="section-kicker">Qualifications &amp; professional development</p>
					<h2>Training, memberships and continuing study.</h2>
					<p class="about-quals-lede">
						Therapy is a craft that keeps unfolding. Below are the
						qualifications, memberships and accreditations that underpin my
						practice — alongside ongoing CPD and reading.
					</p>
				</header>
				<ul class="about-quals-list">
					<li>
						<span class="about-quals-tag">Qualification</span>
						<p>{`{{TODO: list primary counselling / psychotherapy qualification(s) from the original webpage — e.g. Diploma in Integrative Counselling, MSc / level, awarding body, year}}`}</p>
					</li>
					<li>
						<span class="about-quals-tag">Membership</span>
						<p>{`{{TODO: professional body membership — e.g. BACP / NCS / UKCP, member number, link to register}}`}</p>
					</li>
					<li>
						<span class="about-quals-tag">Accreditation</span>
						<p>{`{{TODO: any accreditations, registered status, supervision details}}`}</p>
					</li>
					<li>
						<span class="about-quals-tag">CPD &amp; specialisms</span>
						<p>{`{{TODO: pull CPD bullets from existing site — trauma-informed practice, nervous-system work, couples work, working with young people, etc.}}`}</p>
					</li>
				</ul>
			</div>
		</section>

		<!-- ============== BEGIN YOUR JOURNEY ============== -->
		<section class="about-begin section section-soft" id="begin">
			<div class="container about-begin-grid">
				<figure class="about-begin-figure">
					<img
						src="/assets/images/begin-journey-sunrise.png"
						alt="Sunrise over a meadow — light breaking across a field of grass"
						width="531"
						height="1024"
						loading="lazy"
						decoding="async"
					/>
				</figure>

				<div class="about-begin-copy">
					<p class="section-kicker">Begin your journey</p>
					<h2>Reaching out can feel difficult — you don't have to do it alone.</h2>
					<p>
						Especially when you've been carrying things alone for a long time,
						the idea of beginning therapy can feel daunting. If you'd like to
						explore whether working together feels right for you, you are
						warmly welcome to arrange a free initial consultation.
					</p>
					<div class="about-begin-ctas">
						<a class="cta cta-solid" href="/contact">Book a Session</a>
						<a class="cta cta-outline" href="/contact">Book a Consultation</a>
					</div>
					<p class="about-begin-signoff">
						Whatever you're carrying, you are warmly welcome here.
					</p>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter locations={locations} />
</Layout>

<style>
	.about-page {
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		--ink: var(--color-dark-gray);
		--ink-soft: rgb(29 35 39 / 78%);
	}

	.about-page .section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--brand);
	}

	.about-page h2 {
		margin: 0.6rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(1.7rem, 3.2vw, 2.4rem);
		line-height: 1.18;
		font-weight: 500;
		text-wrap: balance;
	}

	.about-page h3 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 500;
		color: var(--brand-deep);
	}

	.about-section-head {
		max-width: 60ch;
		margin-bottom: 2rem;
	}

	.about-todo {
		margin: 0.7rem 0 0;
		font-size: 0.72rem;
		font-style: italic;
		color: var(--ink-soft);
		opacity: 0.7;
		line-height: 1.55;
		max-width: 40ch;
	}

	/* ---------- BRAND HERO ---------- */
	.about-brand {
		background: linear-gradient(180deg, var(--color-white) 0%, var(--brand-tint) 100%);
		padding-top: 5rem;
		padding-bottom: 5rem;
	}

	.about-brand-inner {
		text-align: center;
		max-width: 62ch;
		margin-inline: auto;
	}

	.about-brand-leaf {
		width: 56px;
		height: 56px;
		color: var(--brand);
		margin-inline: auto;
	}

	.about-wordmark {
		margin: 0.6rem 0 0.25rem;
		font-family: var(--font-script);
		font-size: clamp(3rem, 7.5vw, 5rem);
		font-weight: 400;
		line-height: 1.05;
		color: var(--brand-deep);
		letter-spacing: 0;
	}

	.about-tagline {
		margin: 0 0 1.5rem;
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(1rem, 1.8vw, 1.25rem);
		letter-spacing: 0.18em;
		text-transform: uppercase;
		line-height: 1.2;
		color: var(--brand);
	}

	.about-brand-lede {
		margin: 0 auto;
		max-width: 52ch;
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 600;
		font-size: clamp(1.35rem, 2.3vw, 1.7rem);
		line-height: 1.5;
		color: var(--ink-soft);
	}

	/* ---------- MEET ALLY ---------- */
	.about-meet-grid {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: clamp(1.6rem, 4vw, 3.5rem);
		align-items: center;
	}

	.about-portrait {
		margin: 0;
	}

	.about-portrait img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 50% 25%;
		border-radius: 1rem;
		box-shadow: 0 18px 36px rgb(0 94 71 / 18%);
	}

	.about-meet-copy p {
		margin: 0 0 1rem;
		line-height: 1.85;
		max-width: 62ch;
	}

	.about-emphasis {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.1rem;
		color: var(--brand-deep);
	}

	.about-meet-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.3rem;
	}

	/* ---------- PILLARS ---------- */
	.about-pillar-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
	}

	.about-pillar {
		padding: 1.4rem 1.3rem;
		background: var(--color-white);
		border: 1px solid rgb(0 94 71 / 14%);
		border-radius: 0.9rem;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.about-pillar:hover {
		transform: translateY(-2px);
		box-shadow: 0 14px 28px rgb(0 94 71 / 12%);
	}

	.about-pillar-dot {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 999px;
		background: var(--brand);
	}

	.about-pillar p {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--ink-soft);
	}

	/* ---------- PULL QUOTE ---------- */
	.about-quote {
		padding-block: 3rem;
	}

	.about-quote-figure {
		margin: 0 auto;
		max-width: 56ch;
		text-align: center;
		padding: 2rem 1rem;
		border-top: 1px solid rgb(0 94 71 / 16%);
		border-bottom: 1px solid rgb(0 94 71 / 16%);
	}

	.about-quote-figure blockquote {
		margin: 0;
	}

	.about-quote-figure blockquote p {
		margin: 0;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(1.25rem, 2.4vw, 1.7rem);
		line-height: 1.45;
		color: var(--brand-deep);
		text-wrap: balance;
	}

	.about-quote-figure figcaption {
		margin-top: 0.9rem;
		font-family: var(--font-script);
		font-size: 1.4rem;
		color: var(--brand);
	}

	/* ---------- CHAPTERS ---------- */
	.about-chapters-lede {
		max-width: 56ch;
		margin: 1rem 0 0;
		color: var(--ink-soft);
	}

	.about-chapters-layout {
		display: grid;
		grid-template-columns: 0.7fr 1.3fr;
		gap: clamp(1.4rem, 3.5vw, 3rem);
		align-items: start;
	}

	.about-chapters-aside {
		position: sticky;
		top: 6.5rem;
	}

	.about-chapters-figure {
		margin: 0;
	}

	.about-chapters-figure img {
		width: 100%;
		height: auto;
		border-radius: 0.95rem;
		box-shadow: 0 18px 36px rgb(0 94 71 / 18%);
		object-fit: cover;
	}

	.about-chapter-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.about-chapter {
		background: var(--color-white);
		border: 1px solid rgb(0 94 71 / 16%);
		border-radius: 0.95rem;
		overflow: hidden;
		transition: box-shadow 0.2s ease, border-color 0.2s ease;
	}

	.about-chapter[open] {
		box-shadow: 0 14px 30px rgb(29 35 39 / 8%);
		border-color: rgb(0 94 71 / 30%);
	}

	.about-chapter summary {
		list-style: none;
		cursor: pointer;
		padding: 1.05rem 1.3rem;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 1rem;
	}

	.about-chapter summary::-webkit-details-marker {
		display: none;
	}

	.about-chapter-num {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.4rem;
		color: var(--brand);
		min-width: 2ch;
	}

	.about-chapter-titles {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.about-chapter-title {
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 500;
		color: var(--ink);
		line-height: 1.3;
	}

	.about-chapter-teaser {
		font-size: 0.85rem;
		color: var(--ink-soft);
		line-height: 1.45;
	}

	.about-chapter-icon {
		width: 1.9rem;
		height: 1.9rem;
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 999px;
		background: var(--brand-tint);
		color: var(--brand);
		font-size: 1.1rem;
		font-weight: 600;
		transition: transform 0.2s ease;
	}

	.about-chapter[open] .about-chapter-icon {
		transform: rotate(45deg);
	}

	.about-chapter-body {
		padding: 0 1.3rem 1.3rem;
	}

	.about-chapter-body p {
		margin: 0 0 0.9rem;
		line-height: 1.8;
		color: var(--ink-soft);
	}

	.about-chapter-body p:last-child {
		margin-bottom: 0;
	}

	/* ---------- IMAGE PLACEHOLDER ---------- */
	.about-placeholder {
		margin: 0;
	}

	.about-placeholder-frame {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 5;
		border-radius: 0.95rem;
		background: linear-gradient(160deg, rgb(0 94 71 / 8%) 0%, rgb(0 94 71 / 18%) 100%);
		border: 1px dashed rgb(0 94 71 / 35%);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		color: var(--brand);
	}

	.about-placeholder-frame svg {
		width: 48px;
		height: 48px;
	}

	.about-placeholder-frame span {
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		font-weight: 600;
