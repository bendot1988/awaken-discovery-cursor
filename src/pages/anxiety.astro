---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EmailSignup from "../components/home/EmailSignup.astro";
import { anxietyGuidePath, locations, navItems } from "../data/site";
import { calendlyLinks } from "../data/calendly";

const findingCalmWhatsInside = [
	"Grounding techniques for anxious moments",
	"Gentle nervous system calming practices",
	"Emotional reflection prompts",
	"Understanding anxiety within the body",
	"Simple ways to reconnect with yourself",
	"Practical emotional support tools",
];
---

<Layout
	title="Anxiety Support · Counselling with Ally · Awaken Discovery"
	description="Compassionate counselling and calming resources for anxiety, overthinking, emotional overwhelm and nervous-system exhaustion — with Ally Donoghue."
>
	<SiteHeader navItems={navItems} />
	<main>
		<section class="anxiety-hero section">
			<div class="hero-bg" aria-hidden="true"></div>
			<div class="container hero-shell">
				<p class="eyebrow">Anxiety Support</p>
				<h1>
					When Your Mind Never Truly Slows Down, Life Can Start to Feel Emotionally
					Exhausting
				</h1>
				<p class="subheadline">
					Support for anxiety, overthinking, emotional overwhelm and nervous system
					exhaustion through compassionate therapy, calming resources and gentle
					emotional support.
				</p>
				<div class="cta-row">
					<a class="cta cta-solid cta-guide" href={anxietyGuidePath}>
						<span class="cta-guide-lead">Download the Free Guide —</span>
						<span class="cta-guide-name">Finding Calm</span>
					</a>
					<a class="cta cta-outline" href="#support">Explore Anxiety Support</a>
				</div>
				<ul class="trust-strip" aria-label="Credentials">
					<li>✔ Teacher · Counsellor &amp; Psychotherapist</li>
					<li>✔ Nervous-System-Aware Support</li>
					<li>✔ Online &amp; In-Person Sessions</li>
				</ul>
			</div>
		</section>

		<section class="emotional-connection section section-soft">
			<div class="container">
				<div class="ec-inner">
					<p class="section-kicker">Emotional Connection</p>
					<h2>Anxiety Is More Than "Just Worrying"</h2>
					<p>
						Anxiety can feel exhausting in ways that are difficult to explain to
						other people.
					</p>
					<ul class="ec-bullets">
						<li>The racing thoughts.</li>
						<li>The constant overthinking.</li>
						<li>The inability to fully relax.</li>
						<li>
							The feeling that your mind and body are always "on alert," even when
							you desperately want to switch off.
						</li>
					</ul>
					<p>
						You may look like you are coping on the outside while quietly feeling
						overwhelmed underneath it all. If this feels familiar, you are not broken
						— and you are certainly not alone.
					</p>
					<p>
						Sometimes anxiety is not a sign that something is wrong with you.
						Sometimes it is the nervous system carrying too much for too long without
						enough safety, support or rest.
					</p>
				</div>
			</div>
		</section>

		<EmailSignup
			kicker="Free Guide"
			heading="Finding Calm"
			subtitle="A Gentle Guide to Grounding Yourself During Anxiety"
			body="A calming, body-aware guide designed to help you slow racing thoughts, reconnect with yourself and better understand what anxiety may be trying to communicate beneath the overwhelm."
			whatsInside={findingCalmWhatsInside}
			whatsInsideHeading="What's inside"
			filloutId="jXo5e7D8Hwus"
			privacyText="Your information will always be treated with care and never shared with third parties."
		/>

		<section class="meet-ally section">
			<div class="container ma-inner">
				<figure class="ma-figure">
					<img
						src="/assets/images/ally-portrait-sofa.jpg"
						alt="Ally — Counsellor and Psychotherapist at Awaken Discovery"
						loading="lazy"
						decoding="async"
					/>
				</figure>
				<div class="ma-text">
				<p class="section-kicker">Meet Ally</p>
				<h2>A Gentle, Compassionate Approach to Anxiety Support</h2>

				<div class="ma-copy">
					<p>
						I'm Ally — a Teacher, Counsellor, Psychotherapist and wellbeing
						educator supporting people navigating anxiety, emotional overwhelm
						and nervous system exhaustion.
					</p>
					<p>
						Awaken Discovery was created to offer a calmer, more compassionate
						space where people can begin understanding themselves with greater
						gentleness rather than judgment.
					</p>
					<p>
						Using an integrative humanistic and body-aware approach, I support
						individuals in slowing things down, reconnecting with themselves and
						finding steadier ways to navigate anxiety and emotional overwhelm.
					</p>
					<p class="ma-emphasis">You do not need to do everything perfectly.</p>
					<p class="ma-emphasis">And you do not need to carry this alone.</p>
				</div>

				<details class="ma-disclosure">
					<summary>
						<span class="ma-disclosure-label">Why I understand anxiety</span>
						<svg
							class="ma-disclosure-icon"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
						>
							<path
								d="M6 9l6 6 6-6"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</summary>

					<div class="ma-disclosure-body">
						<h3>Why I Understand Anxiety</h3>
						<p>
							Anxiety is something I understand not only through professional
							training and years of supporting others, but also through personal
							experience.
						</p>
						<p>
							Before becoming a counsellor and psychotherapist, I spent
							twenty-five years working as a teacher within education,
							supporting young people, families, and colleagues through the
							emotional pressures, responsibilities, and challenges that life
							can bring. During those years, I witnessed how anxiety, stress,
							overwhelm, and burnout can quietly affect every area of a
							person's life, often hidden behind a brave face and a
							determination to keep going.
						</p>
						<p>
							Alongside my professional experience, there was also a period in my
							own life when anxiety and overwhelm became significant. Like many
							people, I became very good at coping, carrying responsibility, and
							putting one foot in front of the other. From the outside,
							everything may have appeared manageable. Inside, however, the
							experience was very different.
						</p>
						<p>
							That chapter of my life deepened my understanding of how
							exhausting it can be when your mind rarely rests, when your body
							feels constantly alert, and when you begin to lose connection with
							yourself beneath the weight of everything you are carrying.
						</p>
						<p>
							It also taught me something important: anxiety is rarely just about
							worry.
						</p>
						<p>
							Often, anxiety is connected to pressure, responsibility,
							expectations, life experiences, relationships, loss, self-doubt,
							perfectionism, or simply carrying too much for too long without
							enough space to pause, process, and breathe.
						</p>
						<p>This understanding continues to shape the way I work today.</p>
						<p>
							I believe anxiety deserves compassion rather than criticism.
							Curiosity rather than judgement. Understanding rather than simply
							being told to "cope better" or "think differently."
						</p>
						<p>
							My approach combines professional training, therapeutic experience,
							and a deep appreciation for the connection between the mind,
							emotions, body, and nervous system. Together, we can begin
							exploring not only how anxiety shows up in your life, but what it
							may be trying to communicate beneath the surface.
						</p>
						<p>
							For many people, therapy becomes the first place where they no
							longer have to hold everything together, explain everything away,
							or face it all alone.
						</p>
						<p>
							Instead, it becomes a space to slow down, feel heard, reconnect
							with yourself, and begin moving forward with greater understanding,
							self-compassion, and hope.
						</p>
					</div>
				</details>
				</div>
			</div>
		</section>

		<section class="continued-support section section-soft">
			<div class="container cs-inner">
				<h2 class="cs-title">Gentle Support Beyond the Free Guide</h2>

				<div class="cs-cards">
					<article class="cs-card">
						<figure class="cs-card-figure">
							<img
								src="/assets/images/ally-writing-journal.jpg"
								alt="Open journal with pen — gentle reflection practice"
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<div class="cs-card-body">
							<span class="cs-card-badge cs-card-badge-live">PDF available</span>
							<h3>Anxiety Reflection Journal</h3>
							<p>
								A guided PDF journal to help you notice emotional patterns,
								better understand your anxiety and reconnect with yourself with
								greater calm and self-awareness.
							</p>
							<a class="cs-link" href="/products#anxiety-reflection-journal">
								<span>Get the Journal — £18.99</span>
								<span class="cs-link-arrow" aria-hidden="true">→</span>
							</a>
						</div>
					</article>

					<article class="cs-card">
						<figure class="cs-card-figure">
							<img
								src="/assets/images/ally-with-client.jpg"
								alt="A calm therapy session with Ally — gentle, body-aware support"
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<div class="cs-card-body">
							<h3>One-to-One Therapy Support</h3>
							<p>
								Compassionate counselling support for anxiety, emotional overwhelm
								and nervous system exhaustion in a calm and supportive space.
							</p>
							<a
								class="cs-link"
								href={calendlyLinks.tasterSession}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span>Begin Therapy Support</span>
								<span class="cs-link-arrow" aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				</div>

				<p class="cs-future">
					Additional calming resources and wellbeing tools are currently being
					developed through Awaken Discovery.
				</p>
			</div>
		</section>

		<section class="final-cta section">
			<div class="container fc-inner">
				<h2>You Do Not Need to Keep Pushing Through Anxiety Alone</h2>
				<div class="fc-copy">
					<p>
						Whether anxiety feels loud and overwhelming or quietly exhausting
						beneath the surface, support is available.
					</p>
					<p>
						Sometimes healing begins simply by slowing down long enough to feel
						heard, understood and supported.
					</p>
				</div>
				<div class="fc-actions">
					<a class="cta cta-solid" href="#signup">Download the Free Guide</a>
					<a
						class="cta cta-outline"
						href={calendlyLinks.individual.sixtyFaceToFace}
						target="_blank"
						rel="noopener noreferrer"
					>
						Book a Session
					</a>
					<a
						class="cta cta-outline"
						href={calendlyLinks.tasterSession}
						target="_blank"
						rel="noopener noreferrer"
					>
						Book a Free Consultation
					</a>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter
		locations={locations}
		tagline="Helping people feel calmer, more connected and more like themselves again."
	/>
</Layout>

<style>
	main {
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		--ink-soft: rgb(29 35 39 / 78%);
	}

	.anxiety-hero {
		position: relative;
		padding-block: clamp(4rem, 9vh, 7rem);
		overflow: hidden;
		isolation: isolate;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(
				160deg,
				rgb(234 240 234 / 92%) 0%,
				rgb(246 248 246 / 78%) 55%,
				rgb(244 236 234 / 78%) 100%
			),
			radial-gradient(
				ellipse at 70% 30%,
				rgb(0 94 71 / 14%),
				transparent 60%
			),
			url("/assets/images/begin-journey-sunrise.png");
		background-size: cover;
		background-position: center 30%;
		background-repeat: no-repeat;
	}

	.hero-shell {
		max-width: 760px;
	}

	.eyebrow {
		margin: 0;
		color: var(--color-dark-slate-gray);
		font-weight: 600;
		letter-spacing: 0.08em;
		font-size: 0.8rem;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.7rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 4.6vw, 3.3rem);
		font-weight: 500;
		line-height: 1.14;
		text-wrap: balance;
	}

	.subheadline {
		margin: 0;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.7;
		max-width: 60ch;
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.6rem;
	}

	.cta-guide {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem;
		padding-block: 0.85rem;
		line-height: 1.2;
		text-align: left;
	}

	.cta-guide-name {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 500;
	}

	.trust-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.2rem;
		margin: 1.6rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.85rem;
		opacity: 0.85;
	}

	.ec-inner {
		max-width: 70ch;
	}

	.section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--color-dark-slate-gray);
	}

	h2 {
		margin: 0.6rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(1.7rem, 3.3vw, 2.4rem);
		font-weight: 500;
		text-wrap: balance;
	}

	.ec-inner p {
		margin: 0 0 1rem;
		line-height: 1.9;
	}

	.ec-bullets {
		list-style: none;
		padding: 0;
		margin: 0 0 1.4rem;
		display: grid;
		gap: 0.55rem;
	}

	.ec-bullets li {
		position: relative;
		padding-left: 1.6rem;
		line-height: 1.7;
		color: var(--ink-soft);
	}

	.ec-bullets li::before {
		content: "";
		position: absolute;
		left: 0.35rem;
		top: 0.7em;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--brand);
		opacity: 0.7;
	}

	/* ---------- MEET ALLY ---------- */
	.meet-ally {
		background: var(--color-white);
	}

	.ma-inner {
		max-width: 1080px;
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: clamp(1.6rem, 4vw, 3.5rem);
		align-items: start;
	}

	.ma-figure {
		margin: 0;
	}

	.ma-figure img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 50% 25%;
		border-radius: 1rem;
		box-shadow: 0 18px 36px rgb(0 94 71 / 18%);
	}

	.ma-text {
		max-width: 62ch;
	}

	.ma-copy {
		margin-top: 1.4rem;
	}

	.ma-copy p {
		margin: 0 0 1rem;
		line-height: 1.9;
	}

	.ma-emphasis {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(1.1rem, 1.9vw, 1.3rem);
		color: var(--color-dark-slate-gray);
		line-height: 1.5;
	}

	.ma-emphasis + .ma-emphasis {
		margin-top: -0.4rem;
	}

	.ma-disclosure {
		margin-top: 2rem;
		border-top: 1px solid rgb(0 94 71 / 14%);
		padding-top: 1.6rem;
	}

	.ma-disclosure > summary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		cursor: pointer;
		padding: 0.7rem 1.2rem 0.7rem 1.3rem;
		border-radius: 999px;
		background: var(--color-white);
		border: 1.5px solid var(--brand);
		color: var(--brand-deep, var(--color-dark-slate-gray));
		font-family: var(--font-serif);
		font-size: 1rem;
		font-weight: 500;
		list-style: none;
		transition:
			background-color 0.18s ease,
			color 0.18s ease;
	}

	.ma-disclosure > summary::-webkit-details-marker {
		display: none;
	}

	.ma-disclosure > summary:hover,
	.ma-disclosure > summary:focus-visible {
		background: var(--brand);
		color: var(--color-white);
	}

	.ma-disclosure > summary:focus-visible {
		outline: 3px solid rgb(0 94 71 / 30%);
		outline-offset: 2px;
	}

	.ma-disclosure-icon {
		width: 1rem;
		height: 1rem;
		transition: transform 0.2s ease;
	}

	.ma-disclosure[open] > summary .ma-disclosure-icon {
		transform: rotate(180deg);
	}

	.ma-disclosure-body {
		margin-top: 1.6rem;
		padding: 1.6rem clamp(1rem, 2.5vw, 1.8rem) 0.4rem;
		background: var(--color-white-smoke);
		border-radius: 0.85rem;
		border-left: 3px solid var(--brand);
	}

	.ma-disclosure-body h3 {
		margin: 0 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(1.3rem, 2.4vw, 1.6rem);
		font-weight: 500;
		color: var(--color-dark-slate-gray);
	}

	.ma-disclosure-body p {
		margin: 0 0 1rem;
		line-height: 1.9;
		color: var(--ink-soft);
	}

	/* ---------- CONTINUED SUPPORT ---------- */
	.cs-inner {
		max-width: 1080px;
	}

	.cs-title {
		text-align: center;
		max-width: 28ch;
		margin: 0 auto 2rem;
	}

	.cs-cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.4rem;
	}

	.cs-card {
		background: var(--color-white);
		border-radius: 1rem;
		border: 1px solid rgb(0 94 71 / 18%);
		box-shadow: 0 10px 28px rgb(0 94 71 / 8%);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.cs-card-figure {
		margin: 0;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--brand-tint);
	}

	.cs-card-figure img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 40%;
		display: block;
		transition: transform 0.5s ease;
	}

	.cs-card:hover .cs-card-figure img,
	.cs-card:focus-within .cs-card-figure img {
		transform: scale(1.03);
	}

	.cs-card-body {
		padding: 1.6rem;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		flex: 1;
	}

	.cs-card h3 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.3rem;
		font-weight: 500;
		color: var(--color-dark-slate-gray);
		line-height: 1.3;
	}

	.cs-card p {
		margin: 0;
		line-height: 1.7;
		color: var(--ink-soft);
	}

	.cs-link {
		margin-top: auto;
		padding-top: 0.4rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--brand);
		font-weight: 600;
		text-decoration: none;
	}

	.cs-link[aria-disabled="true"] {
		opacity: 0.55;
		cursor: not-allowed;
		pointer-events: none;
	}

	.cs-link:hover .cs-link-arrow,
	.cs-link:focus-visible .cs-link-arrow {
		transform: translateX(4px);
	}

	.cs-link-arrow {
		transition: transform 0.18s ease;
		display: inline-block;
	}

	.cs-card-badge {
		display: inline-block;
		align-self: flex-start;
		margin: 0 0 0.4rem;
		padding: 0.25rem 0.65rem;
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-dark-slate-gray);
		background: rgb(0 94 71 / 10%);
		border-radius: 999px;
	}

	.cs-card-badge-live {
		color: var(--color-white);
		background: var(--color-dark-slate-gray);
	}

	.cs-future {
		margin: 2rem auto 0;
		max-width: 60ch;
		text-align: center;
		font-style: italic;
		color: var(--ink-soft);
		opacity: 0.85;
		line-height: 1.65;
	}

	/* ---------- FINAL CTA ---------- */
	.final-cta {
		background:
			radial-gradient(
				ellipse at 50% 0%,
				rgb(0 94 71 / 10%),
				transparent 65%
			),
			linear-gradient(180deg, var(--color-white) 0%, var(--brand-tint, #eaf0ea) 100%);
		text-align: center;
	}

	.fc-inner {
		max-width: 64ch;
	}

	.fc-inner h2 {
		text-wrap: balance;
	}

	.fc-copy {
		margin-top: 1rem;
	}

	.fc-copy p {
		margin: 0 0 0.9rem;
		line-height: 1.85;
		color: var(--ink-soft);
	}

	.fc-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.7rem;
		margin-top: 1.6rem;
	}

	/* ---------- RESPONSIVE ---------- */
	@media (max-width: 900px) {
		.ma-inner {
			grid-template-columns: 1fr;
		}

		.ma-figure {
			max-width: 420px;
			margin-inline: auto;
		}
	}

	@media (max-width: 760px) {
		.cs-cards {
			grid-template-columns: 1fr;
		}
	}
</style>
