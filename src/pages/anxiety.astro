---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EmailSignup from "../components/home/EmailSignup.astro";
import GuideSignupDialog from "../components/GuideSignupDialog.astro";
import { locations, navItems } from "../data/site";
import { calendlyLinks } from "../data/calendly";

const findingCalmWhatsInside = [
	"Grounding techniques for anxious moments",
	"Gentle nervous system calming practices",
	"Emotional reflection prompts",
	"Understanding anxiety within the body",
	"Simple ways to reconnect with yourself",
	"Practical emotional support tools",
];

const anxietyLooksLike = [
	"Constant overthinking or analysing everything",
	"Finding it difficult to relax or switch off",
	"Feeling responsible for everyone else",
	"Always expecting the worst",
	"Struggling to make decisions",
	"Feeling overwhelmed by everyday tasks",
	"Difficulty sleeping because your mind won't stop",
	"Feeling disconnected from yourself",
	"Avoiding situations because they feel too much",
	"Panic attacks or physical symptoms with no clear medical explanation",
	"Feeling exhausted even after resting",
];

const anxietyApproach = [
	"Exploring patterns of thinking and emotional responses",
	"Understanding how past experiences influence the present",
	"Developing awareness of the relationship between thoughts, emotions and the body",
	"Learning ways to regulate your nervous system when anxiety feels overwhelming",
	"Building self-compassion and reducing self-criticism",
	"Strengthening emotional resilience",
	"Helping you reconnect with your own values, needs and sense of self",
];
---

<Layout
	title="Anxiety Support · Counselling with Ally · Awaken Discovery"
	description="Compassionate counselling and calming resources for anxiety, overthinking, emotional overwhelm and nervous-system exhaustion — with Ally Donoghue."
>
	<SiteHeader navItems={navItems} />
	<main>
		<section class="anxiety-hero section">
			<div class="container hero-grid">
				<div class="hero-shell">
					<p class="eyebrow">Anxiety Support</p>
					<h1>
						Anxiety Support When Your Mind Never Truly Slows Down
					</h1>
					<p class="subheadline">
						Support for anxiety, overthinking, emotional overwhelm and nervous system
						exhaustion through compassionate therapy, calming resources and gentle
						emotional support.
					</p>
					<div class="cta-row">
						<GuideSignupDialog
							list="anxiety-guide"
							dialogId="guide-signup-dialog-anxiety-hero"
							triggerClass="cta cta-solid cta-guide"
							title="Finding Calm — free anxiety guide"
							lede="A simple guide to grounding yourself during anxiety. Enter your email and the PDF will arrive shortly."
							buttonLabel="Send Me the Free Guide"
							pageLocation="Anxiety · Hero · Free Finding Calm guide"
						>
							<span class="cta-guide-lead">Download the Free Guide —</span>
							<span class="cta-guide-name">Finding Calm</span>
						</GuideSignupDialog>
						<a class="cta cta-outline" href="#support">Explore Anxiety Support</a>
					</div>
					<ul class="trust-strip" aria-label="Credentials">
						<li>✔ Teacher · Counsellor &amp; Psychotherapist</li>
						<li>✔ Nervous-System-Aware Support</li>
						<li>✔ Online &amp; In-Person Sessions</li>
					</ul>
				</div>
				<figure class="hero-media">
					<img
						src="/assets/images/finding-calm-hero-ally.png"
						alt="Ally — counsellor and psychotherapist offering gentle anxiety support"
						width="682"
						height="1024"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
				</figure>
			</div>
		</section>

		<section class="anxiety-support section" id="support">
			<div class="container">
				<header class="as-head">
					<p class="section-kicker">Anxiety Support</p>
					<h2>When Your Mind Won't Switch Off</h2>
				</header>

				<div class="as-zigzag">
					<article class="as-row">
						<figure class="as-media">
							<img
								src="/assets/images/therapy-stones.png"
								alt="Smooth stones stacked in still water — a quiet moment of grounding"
								width="1024"
								height="1024"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>A quieter relationship with your nervous system is possible.</figcaption>
						</figure>
						<div class="as-copy">
							<p class="as-lede">Anxiety can affect every part of life.</p>
							<p>
								It can leave you constantly thinking, worrying about what might happen,
								replaying conversations, doubting yourself, or feeling as though you are
								always waiting for something to go wrong. For some people it shows up as
								racing thoughts. For others it feels like tension in the body, difficulty
								sleeping, panic attacks, irritability, or a sense of always being on alert.
							</p>
							<p>
								<strong>Whatever your experience, anxiety can be exhausting.</strong>
							</p>
							<p>
								At Awaken Discovery, I don't believe anxiety is something that needs to be
								fought against or simply "got rid of." Anxiety is often your mind and body
								trying to protect you. Sometimes those protective responses have become so
								familiar that they continue long after the original reason has passed.
							</p>
							<p>
								Together, we begin to understand what your anxiety is trying to tell you
								rather than simply trying to silence it.
							</p>
						</div>
					</article>

					<article class="as-row as-row-reverse">
						<figure class="as-media">
							<img
								src="/assets/images/anxiety-mind-wont-switch-off.png"
								alt="A person sitting on the edge of a bed at night in soft lamplight — restless, overthinking, unable to switch off"
								width="768"
								height="1024"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>When the body wants rest, but the mind keeps watch.</figcaption>
						</figure>
						<div class="as-copy">
							<h3>Anxiety Doesn't Always Look Like Anxiety</h3>
							<p>
								Many people live with anxiety without realising that's what they are
								experiencing.
							</p>
							<p>You may recognise yourself in some of these experiences:</p>
							<ul class="as-list">
								{anxietyLooksLike.map((item) => <li>{item}</li>)}
							</ul>
							<p>
								You don't have to experience all of these for anxiety to be affecting
								your life.
							</p>
						</div>
					</article>

					<article class="as-row">
						<figure class="as-media">
							<img
								src="/assets/images/therapy-forest.png"
								alt="A quiet woodland path through soft green light — space to pause and understand"
								width="1024"
								height="1024"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Curiosity, not criticism, is often where change begins.</figcaption>
						</figure>
						<div class="as-copy">
							<h3>Understanding Rather Than Managing</h3>
							<p>
								There are many strategies that can help reduce anxiety in the moment, and
								these can be incredibly valuable.
							</p>
							<p>
								In therapy, we also become curious about why anxiety has developed and
								what keeps it going.
							</p>
							<p>Sometimes anxiety has grown from past experiences.</p>
							<p>
								Sometimes it has developed through years of carrying responsibility,
								people-pleasing, perfectionism or always needing to be "strong."
							</p>
							<p>
								Sometimes it has become a way of staying safe in a world that once felt
								unpredictable.
							</p>
							<p>
								Rather than judging these responses, we explore them with compassion.
							</p>
							<p class="as-emphasis">As understanding grows, change becomes possible.</p>
						</div>
					</article>

					<article class="as-row as-row-reverse">
						<figure class="as-media">
							<img
								src="/assets/images/ally-with-client.jpg"
								alt="Ally in a calm therapy session — a safe space for anxiety support"
								width="768"
								height="1024"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Therapy shaped around you, not a formula.</figcaption>
						</figure>
						<div class="as-copy">
							<h3>My Approach</h3>
							<p>
								I work integratively, drawing from a range of therapeutic approaches to
								meet you as an individual.
							</p>
							<p>Our work may include:</p>
							<ul class="as-list">
								{anxietyApproach.map((item) => <li>{item}</li>)}
							</ul>
							<p>
								There is no "one size fits all" approach. Therapy is shaped around you,
								your experiences and what feels most helpful for your journey.
							</p>
						</div>
					</article>

					<article class="as-row">
						<figure class="as-media">
							<img
								src="/assets/images/therapy-lake-sunset.png"
								alt="A still lake at sunset — calm returning after a long day"
								width="1024"
								height="1024"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Towards a life that feels calmer and more like your own.</figcaption>
						</figure>
						<div class="as-copy">
							<h3>You Don't Have to Face Anxiety Alone</h3>
							<p>
								Therapy offers a safe, confidential and non-judgemental space where you
								don't have to hold everything together.
							</p>
							<p>
								Whether anxiety has been part of your life for years or has appeared more
								recently, we can work together to understand your experience, reduce its
								impact, and help you move towards a life that feels calmer, more connected
								and more like your own.
							</p>
							<p>
								Taking the first step can often feel like the hardest part, but you don't
								have to know exactly where to begin.
							</p>
							<p class="as-emphasis">We'll work it out together.</p>
						</div>
					</article>
				</div>

				<div class="as-ready">
					<h3>Ready to Begin?</h3>
					<p>
						If you're ready to explore therapy, or simply want to ask a question
						before deciding, I'd be happy to hear from you.
					</p>
					<p>
						Book an initial consultation or session today and take the first step
						towards coming home to yourself.
					</p>
					<div class="as-ready-actions">
						<a
							class="cta cta-solid"
							href={calendlyLinks.tasterSession}
							target="_blank"
							rel="noopener noreferrer"
						>
							Book a Free Consultation
						</a>
						<a
							class="cta cta-outline"
							href={calendlyLinks.individual.sixtyFaceToFace}
							target="_blank"
							rel="noopener noreferrer"
						>
							Book a Session
						</a>
						<a class="cta cta-outline" href="/contact">Ask a Question</a>
					</div>
				</div>
			</div>
		</section>

		<EmailSignup
			kicker="Free Guide"
			heading="Finding Calm"
			subtitle="A Gentle Guide to Grounding Yourself During Anxiety"
			body="A calming, body-aware guide designed to help you slow racing thoughts, reconnect with yourself and better understand what anxiety may be trying to communicate beneath the overwhelm."
			whatsInside={findingCalmWhatsInside}
			whatsInsideHeading="What's inside"
			useSenderForm
			senderList="anxiety-guide"
			submitLabel="Send Me the Free Guide"
			privacyText="Your information will always be treated with care and never shared with third parties."
		/>

		<section class="meet-ally section">
			<div class="container ma-inner">
				<figure class="ma-figure">
					<img
						src="/assets/images/ally-portrait-sofa.jpg"
						alt="Ally — Counsellor and Psychotherapist at Awaken Discovery"
						loading="lazy"
						decoding="async"
					/>
				</figure>
				<div class="ma-text">
				<p class="section-kicker">Meet Ally</p>
				<h2>A Gentle, Compassionate Approach to Anxiety Support</h2>

				<div class="ma-copy">
					<p>
						I'm Ally — a Teacher, Counsellor, Psychotherapist and wellbeing
						educator supporting people navigating anxiety, emotional overwhelm
						and nervous system exhaustion.
					</p>
					<p>
						Awaken Discovery was created to offer a calmer, more compassionate
						space where people can begin understanding themselves with greater
						gentleness rather than judgment.
					</p>
					<p>
						Using an integrative humanistic and body-aware approach, I support
						individuals in slowing things down, reconnecting with themselves and
						finding steadier ways to navigate anxiety and emotional overwhelm.
					</p>
					<p class="ma-emphasis">You do not need to do everything perfectly.</p>
					<p class="ma-emphasis">And you do not need to carry this alone.</p>
				</div>

				<details class="ma-disclosure">
					<summary>
						<span class="ma-disclosure-label">Why I understand anxiety</span>
						<svg
							class="ma-disclosure-icon"
							viewBox="0 0 24 24"
							aria-hidden="true"
							focusable="false"
						>
							<path
								d="M6 9l6 6 6-6"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</summary>

					<div class="ma-disclosure-body">
						<h3>Why I Understand Anxiety</h3>
						<p>
							Anxiety is something I understand not only through professional
							training and years of supporting others, but also through personal
							experience.
						</p>
						<p>
							Before becoming a counsellor and psychotherapist, I spent
							twenty-five years working as a teacher within education,
							supporting young people, families, and colleagues through the
							emotional pressures, responsibilities, and challenges that life
							can bring. During those years, I witnessed how anxiety, stress,
							overwhelm, and burnout can quietly affect every area of a
							person's life, often hidden behind a brave face and a
							determination to keep going.
						</p>
						<p>
							Alongside my professional experience, there was also a period in my
							own life when anxiety and overwhelm became significant. Like many
							people, I became very good at coping, carrying responsibility, and
							putting one foot in front of the other. From the outside,
							everything may have appeared manageable. Inside, however, the
							experience was very different.
						</p>
						<p>
							That chapter of my life deepened my understanding of how
							exhausting it can be when your mind rarely rests, when your body
							feels constantly alert, and when you begin to lose connection with
							yourself beneath the weight of everything you are carrying.
						</p>
						<p>
							It also taught me something important: anxiety is rarely just about
							worry.
						</p>
						<p>
							Often, anxiety is connected to pressure, responsibility,
							expectations, life experiences, relationships, loss, self-doubt,
							perfectionism, or simply carrying too much for too long without
							enough space to pause, process, and breathe.
						</p>
						<p>This understanding continues to shape the way I work today.</p>
						<p>
							I believe anxiety deserves compassion rather than criticism.
							Curiosity rather than judgement. Understanding rather than simply
							being told to "cope better" or "think differently."
						</p>
						<p>
							My approach combines professional training, therapeutic experience,
							and a deep appreciation for the connection between the mind,
							emotions, body, and nervous system. Together, we can begin
							exploring not only how anxiety shows up in your life, but what it
							may be trying to communicate beneath the surface.
						</p>
						<p>
							For many people, therapy becomes the first place where they no
							longer have to hold everything together, explain everything away,
							or face it all alone.
						</p>
						<p>
							Instead, it becomes a space to slow down, feel heard, reconnect
							with yourself, and begin moving forward with greater understanding,
							self-compassion, and hope.
						</p>
					</div>
				</details>
				</div>
			</div>
		</section>

		<section class="continued-support section section-soft">
			<div class="container cs-inner">
				<h2 class="cs-title">Gentle Support Beyond the Free Guide</h2>

				<div class="cs-cards">
					<article class="cs-card">
						<figure class="cs-card-figure">
							<img
								src="/assets/images/ally-writing-journal.jpg"
								alt="Open journal with pen — gentle reflection practice"
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<div class="cs-card-body">
							<span class="cs-card-badge cs-card-badge-live">PDF available</span>
							<h3>Anxiety Reflection Journal</h3>
							<p>
								A guided PDF journal to help you notice emotional patterns,
								better understand your anxiety and reconnect with yourself with
								greater calm and self-awareness.
							</p>
							<a class="cs-link" href="/products#anxiety-reflection-journal">
								<span>Get the Journal — £18.99</span>
								<span class="cs-link-arrow" aria-hidden="true">→</span>
							</a>
						</div>
					</article>

					<article class="cs-card">
						<figure class="cs-card-figure">
							<img
								src="/assets/images/ally-with-client.jpg"
								alt="A calm therapy session with Ally — gentle, body-aware support"
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<div class="cs-card-body">
							<h3>One-to-One Therapy Support</h3>
							<p>
								Compassionate counselling support for anxiety, emotional overwhelm
								and nervous system exhaustion in a calm and supportive space.
							</p>
							<a
								class="cs-link"
								href={calendlyLinks.tasterSession}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span>Begin Therapy Support</span>
								<span class="cs-link-arrow" aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				</div>

				<p class="cs-future">
					Additional calming resources and wellbeing tools are currently being
					developed through Awaken Discovery.
				</p>
			</div>
		</section>

		<section class="final-cta section">
			<div class="container fc-inner">
				<h2>You Do Not Need to Keep Pushing Through Anxiety Alone</h2>
				<div class="fc-copy">
					<p>
						Whether anxiety feels loud and overwhelming or quietly exhausting
						beneath the surface, support is available.
					</p>
					<p>
						Sometimes healing begins simply by slowing down long enough to feel
						heard, understood and supported.
					</p>
				</div>
				<div class="fc-actions">
					<GuideSignupDialog
						list="anxiety-guide"
						dialogId="guide-signup-dialog-anxiety-final"
						triggerClass="cta cta-solid"
						triggerLabel="Download the Free Guide"
						title="Finding Calm — free anxiety guide"
						lede="A simple guide to grounding yourself during anxiety. Enter your email and the PDF will arrive shortly."
						buttonLabel="Send Me the Free Guide"
						pageLocation="Anxiety · Final CTA · Free Finding Calm guide"
					/>
					<a
						class="cta cta-outline"
						href={calendlyLinks.individual.sixtyFaceToFace}
						target="_blank"
						rel="noopener noreferrer"
					>
						Book a Session
					</a>
					<a
						class="cta cta-outline"
						href={calendlyLinks.tasterSession}
						target="_blank"
						rel="noopener noreferrer"
					>
						Book a Free Consultation
					</a>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter
		locations={locations}
		tagline="Helping people feel calmer, more connected and more like themselves again."
	/>
</Layout>

<style>
	main {
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		--ink-soft: rgb(29 35 39 / 78%);
	}

	.anxiety-hero {
		padding-block: clamp(3.5rem, 8vh, 6rem);
		background: linear-gradient(180deg, var(--color-white) 0%, #f6f8f6 100%);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: clamp(2rem, 4vw, 4rem);
		align-items: center;
	}

	.eyebrow {
		margin: 0;
		color: var(--color-dark-slate-gray);
		font-weight: 600;
		letter-spacing: 0.08em;
		font-size: 0.8rem;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.7rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(1.9rem, 4.4vw, 3.1rem);
		font-weight: 500;
		line-height: 1.16;
		text-wrap: balance;
	}

	.subheadline {
		margin: 0;
		font-size: clamp(1rem, 1.9vw, 1.2rem);
		line-height: 1.75;
		max-width: 60ch;
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.6rem;
	}

	/* Button lives in GuideSignupDialog — style via :global */
	.cta-row :global(.cta-guide) {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem;
		padding-block: 0.85rem;
		line-height: 1.2;
		text-align: left;
	}

	.cta-guide-name {
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 500;
	}

	.trust-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.2rem;
		margin: 1.6rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.85rem;
		opacity: 0.85;
	}

	.hero-media {
		margin: 0;
	}

	.hero-media img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 50% 30%;
		border-radius: 1rem;
		box-shadow: 0 14px 35px rgb(29 35 39 / 14%);
	}

	.anxiety-support {
		scroll-margin-top: 5.5rem;
		padding-block: clamp(2.5rem, 6vh, 4.5rem) clamp(3.5rem, 8vh, 5.5rem);
		background: var(--color-white);
	}

	.as-head {
		max-width: 40rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	.section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--color-dark-slate-gray);
	}

	h2 {
		margin: 0.6rem 0 0;
		font-family: var(--font-serif);
		font-size: clamp(1.7rem, 3.3vw, 2.4rem);
		font-weight: 500;
		text-wrap: balance;
	}

	.as-zigzag {
		display: grid;
		gap: clamp(2.5rem, 6vw, 4.5rem);
	}

	.as-row {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(1.6rem, 4vw, 3.5rem);
		align-items: center;
	}

	.as-row-reverse {
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
	}

	.as-row-reverse .as-media {
		order: 2;
	}

	.as-row-reverse .as-copy {
		order: 1;
	}

	.as-media {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.as-media img {
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 1rem;
		box-shadow: 0 18px 36px rgb(0 94 71 / 14%);
	}

	.as-media figcaption {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 0.95rem;
		line-height: 1.45;
		color: var(--color-dark-slate-gray);
		text-align: center;
		text-wrap: balance;
	}

	.as-copy {
		max-width: 60ch;
	}

	.as-copy p {
