---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { locations, navItems } from "../data/site";
import { calendlyLinks } from "../data/calendly";
import allyTreePortrait from "../assets/therapy/ally-tree-portrait.png";
import roomCouplesChairs from "../assets/therapy/room-couples-chairs.jpg";
import roomIndividualChair from "../assets/therapy/room-individual-chair.jpg";
import allyWithDog from "../assets/therapy/ally-with-dog.jpg";

type SessionFormat = {
	id: string;
	duration: string;
	format: string;
	price: string;
	note: string;
	bookHref: string;
	image?: string;
	imageAlt?: string;
	imagePrompt?: string;
};

const individualSessions: SessionFormat[] = [
	{
		id: "ind-60-f2f",
		duration: "60 min",
		format: "Individual — Face to Face",
		price: "£60.00",
		note: "Available to book now",
		bookHref: calendlyLinks.individual.sixtyFaceToFace,
		image: "/assets/images/therapy-stones.png",
		imageAlt: "Stacked white pebbles reflected in calm water",
	},
	{
		id: "ind-60-online",
		duration: "60 min",
		format: "Online or Phone",
		price: "£60.00",
		note: "Available to book now",
		bookHref: calendlyLinks.individual.sixtyOnline,
		image: "/assets/images/therapy-forest.png",
		imageAlt: "Sunlight filtering through a quiet forest glade",
	},
	{
		id: "ind-90-f2f",
		duration: "90 min",
		format: "Individual — Face to Face",
		price: "£90.00",
		note: "Available to book now",
		bookHref: calendlyLinks.individual.ninetyFaceToFace,
		image: "/assets/images/therapy-lake-sunset.png",
		imageAlt: "Calm lake at sunset surrounded by hills and trees",
	},
];

const couplesSessions: SessionFormat[] = [
	{
		id: "cou-60-f2f",
		duration: "60 min",
		format: "Couples — Face to Face",
		price: "£90.00",
		note: "Available to book now",
		bookHref: calendlyLinks.couples.sixtyFaceToFace,
		image: "/assets/images/therapy-stones.png",
		imageAlt: "Stacked white pebbles reflected in calm water",
	},
	{
		id: "cou-60-online",
		duration: "60 min",
		format: "Couples — Online or Phone",
		price: "£90.00",
		note: "Available to book now",
		bookHref: calendlyLinks.couples.sixtyOnline,
		image: "/assets/images/therapy-forest.png",
		imageAlt: "Sunlight filtering through a quiet forest glade",
	},
	{
		id: "cou-90-f2f",
		duration: "90 min",
		format: "Couples — Face to Face, Online or Phone",
		price: "£130.00",
		note: "Available to book now",
		bookHref: calendlyLinks.couples.ninetyFaceToFace,
		image: "/assets/images/therapy-lake-sunset.png",
		imageAlt: "Calm sunset over open fields with warm light",
	},
];

const individualBenefits = [
	"Personal growth and self-exploration in a supportive one-on-one setting.",
	"Over a decade of experience guiding individuals through challenging moments.",
	"Tailored sessions to illuminate and nurture your path to inner peace.",
	"Collaborative space to hear your voice and validate your feelings.",
];

const couplesBenefits = [
	"Connect with your partner in 60 or 90-minute therapy sessions.",
	"Foster open communication and mutual understanding in a nurturing space.",
	"Identify and address underlying patterns causing distress in your relationship.",
	"Build a resilient foundation for a more fulfilling partnership.",
];
---

<Layout
	title="Therapy with Ally — Individual & Couples Counselling | Awaken Discovery"
	description="Compassionate individual and couples therapy with Ally. 60 or 90 minute sessions, face to face, online or by phone. Tailored support for personal wellbeing and stronger relationships."
>
	<SiteHeader navItems={navItems} />

	<main class="th-page">
		<!-- ============== HERO ============== -->
		<section class="th-hero section">
			<div class="container th-hero-grid">
				<div class="th-hero-inner">
					<p class="section-kicker">How I can help</p>
					<h1>Therapy with Ally</h1>
					<p class="th-lede">
						A calm, unhurried space to be heard — whether you're working
						through something on your own or alongside your partner. Choose the
						format that feels right for you below.
					</p>
					<div class="th-hero-actions">
						<a class="cta cta-solid" href="#choose">Choose Therapy</a>
						<a class="cta cta-outline" href="/about">Meet Ally</a>
					</div>
				</div>
				<figure class="th-hero-figure">
					<Image
						src={allyTreePortrait}
						alt="Ally outdoors, leaning gently on a tree branch in soft natural light"
						widths={[420, 640, 860]}
						sizes="(max-width: 960px) 70vw, 420px"
						loading="eager"
						decoding="async"
						format="webp"
						quality={82}
					/>
				</figure>
			</div>
		</section>

		<!-- ============== CHOOSE: TABS ============== -->
		<section class="th-choose section section-soft" id="choose">
			<div class="container">
				<header class="th-choose-head">
					<p class="section-kicker">Choose Individual or Couples</p>
					<h2>Find the format that feels right</h2>
					<p class="th-choose-sub">
						Both options begin with the same intention — a safe, paced and
						compassionate space to slow down and reconnect.
					</p>
					<p class="th-choose-prompt">
						<span aria-hidden="true">↓</span> Tap one of the two options below
						to see what each looks like
					</p>
				</header>

				<div class="th-tabs">
					<input
						type="radio"
						name="th-tab"
						id="th-tab-ind"
						class="th-tab-input"
						checked
					/>
					<input
						type="radio"
						name="th-tab"
						id="th-tab-cou"
						class="th-tab-input"
					/>

					<div class="th-tab-switch" role="tablist" aria-label="Therapy type">
						<label for="th-tab-ind" class="th-tab-card" role="tab">
							<span class="th-tab-icon" aria-hidden="true">
								<svg
									viewBox="0 0 48 48"
									width="40"
									height="40"
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle cx="24" cy="16" r="6" />
									<path d="M12 38c0-6.6 5.4-12 12-12s12 5.4 12 12" />
								</svg>
							</span>
							<span class="th-tab-text">
								<span class="th-tab-title">Individual Therapy</span>
								<span class="th-tab-meta">60 or 90-min sessions · From £60</span>
							</span>
							<span class="th-tab-check" aria-hidden="true">
								<svg
									viewBox="0 0 20 20"
									width="18"
									height="18"
									fill="none"
									stroke="currentColor"
									stroke-width="2.2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M4 10.5l4 4 8-9" />
								</svg>
							</span>
						</label>
						<label for="th-tab-cou" class="th-tab-card" role="tab">
							<span class="th-tab-icon" aria-hidden="true">
								<svg
									viewBox="0 0 48 48"
									width="40"
									height="40"
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<circle cx="17" cy="16" r="5.2" />
									<circle cx="31" cy="16" r="5.2" />
									<path d="M7 38c0-5.5 4.5-10 10-10s10 4.5 10 10" />
									<path d="M21 38c0-5.5 4.5-10 10-10s10 4.5 10 10" />
								</svg>
							</span>
							<span class="th-tab-text">
								<span class="th-tab-title">Couples Therapy</span>
								<span class="th-tab-meta">60 or 90-min sessions · From £90</span>
							</span>
							<span class="th-tab-check" aria-hidden="true">
								<svg
									viewBox="0 0 20 20"
									width="18"
									height="18"
									fill="none"
									stroke="currentColor"
									stroke-width="2.2"
									stroke-linecap="round"
									stroke-linejoin="round"
								>
									<path d="M4 10.5l4 4 8-9" />
								</svg>
							</span>
						</label>
					</div>

					<div class="th-tab-panels">
						<!-- ===== INDIVIDUAL PANEL ===== -->
						<div
							class="th-tab-panel th-tab-panel-ind"
							role="tabpanel"
							aria-labelledby="th-tab-ind"
						>
							<div class="th-panel-card">
								<h3 class="th-script">Individual Therapy</h3>
								<p class="th-banner">
									<span aria-hidden="true">✦</span>
									Embark on your journey to personal wellbeing with Ally's
									individual therapy sessions
									<span aria-hidden="true">✦</span>
								</p>

								<div class="th-narrative-grid">
									<div class="th-narrative">
										<p>
											Hello, I'm Ally, and I'm delighted to welcome you to your
											personal sanctuary for growth and self-exploration. With
											over a decade of experience in guiding individuals through
											their most challenging moments, I've crafted these
											one-on-one sessions to be a safe haven for your mental and
											emotional wellbeing. Whether you're seeking clarity, coping
											strategies, or simply a compassionate ear, our individual
											therapy is tailored to illuminate and nurture your unique
											path to inner peace.
										</p>
										<p>
											In our 60 or 90-minute sessions, we will embark on a journey
											together to uncover the layers of your story and address the
											core of your concerns. It's a collaborative space where your
											voice is heard and your feelings are validated. We'll work
											at a pace that feels comfortable to you, ensuring each step
											we take is one closer to the serenity and understanding you
											deserve. Let's begin this transformative voyage towards a
											brighter, more balanced you.
										</p>
									</div>
									<figure class="th-narrative-figure">
										<Image
											src={roomIndividualChair}
											alt="A soft mustard armchair against a sage-green wall in Ally's therapy room, with framed landscape photographs above and a leafy plant alongside — the individual session space"
											widths={[360, 540, 720]}
											sizes="(max-width: 900px) 80vw, 360px"
											loading="lazy"
											decoding="async"
											format="webp"
											quality={80}
										/>
									</figure>
								</div>

								<ul class="th-benefits" aria-label="What individual therapy offers">
									{
										individualBenefits.map((b) => (
											<li>
												<svg
													class="th-check"
													viewBox="0 0 24 24"
													aria-hidden="true"
													focusable="false"
												>
													<path
														d="M5 12.5l4.5 4.5L19 7.5"
														fill="none"
														stroke="currentColor"
														stroke-width="2.4"
														stroke-linecap="round"
														stroke-linejoin="round"
													/>
												</svg>
												<span>{b}</span>
											</li>
										))
									}
								</ul>
							</div>

							<div class="th-session-grid">
								{
									individualSessions.map((s) => (
										<article class="th-session-card">
											<figure class="th-session-figure">
												{s.image ? (
													<img
														src={s.image}
														alt={s.imageAlt ?? ""}
														width="600"
														height="600"
														loading="lazy"
														decoding="async"
													/>
												) : (
													<div
														class="th-session-placeholder"
														aria-label="Image coming soon"
													>
														<span>{`{{Image: ${s.imagePrompt ?? "TBC"}}}`}</span>
													</div>
												)}
											</figure>
											<div class="th-session-body">
												<p class="th-session-eyebrow">{s.duration}</p>
												<h4 class="th-session-title">{s.format}</h4>
												<p class="th-session-price">{s.price}</p>
												<p class="th-session-note">{s.note}</p>
												<a
													class="cta cta-solid th-session-cta"
													href={s.bookHref}
													target="_blank"
													rel="noopener noreferrer"
													aria-label={`Book ${s.duration} ${s.format}`}
												>
													Book
												</a>
											</div>
										</article>
									))
								}
							</div>

							<aside class="th-bundle">
								<div class="th-bundle-text">
									<p class="section-kicker">Save with a bundle</p>
									<h3 class="th-bundle-title">
										Bulk sessions for individuals — save 10%
									</h3>
									<p class="th-bundle-body">
										Buy 6 or 10 individual sessions together and save against
										the single-session price. Use them at your own pace.
									</p>
								</div>
								<a class="cta cta-solid" href="/pricing">See Bundle Pricing →</a>
							</aside>
						</div>

						<!-- ===== COUPLES PANEL ===== -->
						<div
							class="th-tab-panel th-tab-panel-cou"
							role="tabpanel"
							aria-labelledby="th-tab-cou"
						>
							<div class="th-panel-card">
								<h3 class="th-script">Couples Therapy</h3>
								<p class="th-banner">
									<span aria-hidden="true">✦</span>
									Discover the path to a stronger relationship with Awaken
									Discovery couples counselling
									<span aria-hidden="true">✦</span>
								</p>

								<div class="th-narrative-grid">
									<div class="th-narrative">
										<p>
											Hello, I'm Ally, and I'm here to help you and your
											partner find harmony and connection within your
											relationship. In our 60 or 90-minute couples therapy
											sessions, we'll create a space that nurtures open
											communication and mutual understanding. Relationships can
											be complex, and every couple has their unique rhythm. My
											role is to help you both tune into each other's frequencies,
											discovering new ways to sync harmoniously and reaffirm the
											bond that brought you together.
										</p>
										<p>
											As we journey through your shared experiences, we will
											identify and address the underlying patterns that may be
											causing distress. It's about building a stronger foundation
											together — one that is resilient in the face of life's ebb
											and flow. Whether you are navigating a particular challenge
											or simply wish to deepen your connection, our sessions are a
											stepping stone to a more fulfilling partnership. Let's
											collaborate to reignite the spark and weave intimacy and
											respect back into the fabric of your relationship.
										</p>
									</div>
									<figure class="th-narrative-figure">
										<Image
											src={roomCouplesChairs}
											alt="Two soft green velvet armchairs facing each other in Ally's therapy room, with a small wooden cabinet between them — a calm space for couples sessions"
											widths={[360, 540, 720]}
											sizes="(max-width: 900px) 80vw, 360px"
											loading="lazy"
											decoding="async"
											format="webp"
											quality={80}
										/>
									</figure>
								</div>

								<ul class="th-benefits" aria-label="What couples therapy offers">
									{
										couplesBenefits.map((b) => (
											<li>
												<svg
													class="th-check"
													viewBox="0 0 24 24"
													aria-hidden="true"
													focusable="false"
												>
													<path
														d="M5 12.5l4.5 4.5L19 7.5"
														fill="none"
														stroke="currentColor"
														stroke-width="2.4"
														stroke-linecap="round"
														stroke-linejoin="round"
													/>
												</svg>
												<span>{b}</span>
											</li>
										))
									}
								</ul>
							</div>

							<div class="th-session-grid">
								{
									couplesSessions.map((s) => (
										<article class="th-session-card">
											<figure class="th-session-figure">
												{s.image ? (
													<img
														src={s.image}
														alt={s.imageAlt ?? ""}
														width="600"
														height="600"
														loading="lazy"
														decoding="async"
													/>
												) : (
													<div
														class="th-session-placeholder"
														aria-label="Image coming soon"
													>
														<span>{`{{Image: ${s.imagePrompt ?? "TBC"}}}`}</span>
													</div>
												)}
											</figure>
											<div class="th-session-body">
												<p class="th-session-eyebrow">{s.duration}</p>
												<h4 class="th-session-title">{s.format}</h4>
												<p class="th-session-price">{s.price}</p>
												<p class="th-session-note">{s.note}</p>
												<a
													class="cta cta-solid th-session-cta"
													href={s.bookHref}
													target="_blank"
													rel="noopener noreferrer"
													aria-label={`Book ${s.duration} ${s.format}`}
												>
													Book
												</a>
											</div>
										</article>
									))
								}
							</div>

							<aside class="th-bundle">
								<div class="th-bundle-text">
									<p class="section-kicker">Save with a bundle</p>
									<h3 class="th-bundle-title">
										Bulk sessions for couples — save 10%
									</h3>
									<p class="th-bundle-body">
										Buy 6 or 10 couples sessions together and save against the
										single-session price.
									</p>
								</div>
								<a class="cta cta-solid" href="/pricing">See Bundle Pricing →</a>
							</aside>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============== SOFT CLOSE ============== -->
		<section class="th-close section">
			<div class="container th-close-grid">
				<div class="th-close-inner">
					<p class="section-kicker">Not sure which is right?</p>
					<h2>Let's talk it through first</h2>
					<p class="th-close-body">
						If you'd like to chat before booking, you're warmly welcome to start
						with a free consultation. We can talk through what's on your mind
						and find a format — individual or couples, face-to-face or online —
						that feels comfortable for you.
					</p>
					<div class="th-close-actions">
						<a
							class="cta cta-solid"
							href={calendlyLinks.tasterSession}
							target="_blank"
							rel="noopener noreferrer"
						>
							Book a Free Consultation
						</a>
						<a class="cta cta-outline" href="/pricing">See Pricing & Bundles</a>
					</div>
				</div>
				<figure class="th-close-figure">
					<Image
						src={allyWithDog}
						alt="Ally seated on a wooden stool in her garden with her cairn terrier sitting attentively beside her"
						widths={[380, 560, 760]}
						sizes="(max-width: 900px) 75vw, 380px"
						loading="lazy"
						decoding="async"
						format="webp"
						quality={80}
					/>
				</figure>
			</div>
		</section>
	</main>

	<SiteFooter
		locations={locations}
		tagline="Therapy that meets you exactly where you are."
	/>
</Layout>

<style>
	.th-page {
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		--ink: var(--color-dark-gray);
		--ink-soft: rgb(29 35 39 / 78%);
		color: var(--ink);
	}

	.th-page .section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--brand);
	}

	.th-page h1,
	.th-page h2 {
		font-family: var(--font-serif);
		font-weight: 500;
		text-wrap: balance;
		color: var(--brand-deep);
	}

	.th-page h1 {
		margin: 0.6rem 0 1rem;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		line-height: 1.12;
	}

	.th-page h2 {
		margin: 0.6rem 0 0.9rem;
		font-size: clamp(1.7rem, 3.3vw, 2.4rem);
		line-height: 1.2;
	}

	/* ---------- HERO ---------- */
	.th-hero {
		background: linear-gradient(180deg, var(--color-white) 0%, var(--brand-tint) 100%);
		padding-top: 4rem;
	}

	.th-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		gap: clamp(1.6rem, 4vw, 3rem);
		align-items: center;
	}

	.th-hero-inner {
		max-width: 62ch;
	}

	.th-hero-figure {
		margin: 0;
		border-radius: 1rem;
		overflow: hidden;
		box-shadow: 0 16px 38px rgb(0 94 71 / 16%);
		aspect-ratio: 4 / 5;
		background: var(--color-white-smoke);
	}

	.th-hero-figure img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 30%;
		display: block;
	}

	.th-lede {
		margin: 0 0 1.6rem;
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		line-height: 1.7;
		color: var(--ink-soft);
		max-width: 58ch;
	}

	.th-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
	}

	/* ---------- CHOOSE / TABS ---------- */
	.th-choose-head {
		text-align: center;
		max-width: 62ch;
		margin: 0 auto 2rem;
	}

	.th-choose-sub {
		margin: 0;
		color: var(--ink-soft);
		line-height: 1.75;
	}

	.th-choose-prompt {
		margin: 1.1rem 0 0;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--brand);
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.th-choose-prompt span[aria-hidden] {
		font-size: 1.05rem;
		font-weight: 700;
	}

	.th-tabs {
		position: relative;
	}

	.th-tab-input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.th-tab-switch {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 720px;
		margin: 0 auto 2.5rem;
	}

	.th-tab-card {
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
