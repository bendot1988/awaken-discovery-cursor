---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { navItems, locations } from "../data/site";
import { calendlyLinks } from "../data/calendly";

type Scenario = {
	heading: string;
	body: string;
};

const scenarios: Scenario[] = [
	{
		heading: "When your mind never seems to switch off",
		body: "You replay conversations, imagine worst-case scenarios, worry about the future, and find yourself trapped in cycles of overthinking. Therapy can help you understand the roots of anxiety and develop a different relationship with your thoughts.",
	},
	{
		heading: "When you've become disconnected from yourself",
		body: "You know how to look after everyone else but struggle to know what you need. Therapy can help you reconnect with your own feelings, values, needs, and identity.",
	},
	{
		heading: "When emotions feel overwhelming",
		body: "Whether it is anger, sadness, fear, guilt, shame, or emotional numbness, therapy provides space to understand what your emotions may be trying to communicate rather than fighting against them.",
	},
	{
		heading: "When old patterns keep repeating",
		body: "You may find yourself in the same relationships, facing the same challenges, or reacting in ways you don't fully understand. Therapy can help uncover the origins of these patterns and create new choices.",
	},
	{
		heading: "When confidence feels out of reach",
		body: "Many people live with a constant inner critic that questions their worth, abilities, and decisions. Therapy can help you develop a more compassionate and realistic relationship with yourself.",
	},
	{
		heading: "When life has left its mark",
		body: "Past experiences do not stay in the past simply because time has passed. Therapy can help you process experiences that continue to influence how you feel, think, and respond today.",
	},
	{
		heading: "When you are exhausted from carrying everything alone",
		body: "Sometimes people come to therapy because they are struggling. Sometimes they come because they are tired of struggling in silence.",
	},
];

const pageTitle =
	"Therapy Isn't About Fixing You — Awaken Discovery Counselling";
const pageDescription =
	"Therapy is not about fixing what is broken. It is about understanding yourself more fully, recognising patterns that no longer serve you, and reconnecting with your own inner wisdom and strengths.";
---

<Layout title={pageTitle} description={pageDescription}>
	<SiteHeader navItems={navItems} />
	<main class="at-page">
		<!-- ============== HERO ============== -->
		<section class="at-hero section">
			<div class="container at-hero-inner">
				<p class="at-eyebrow">Learn more about therapy</p>
				<h1 class="at-h1">Therapy Isn't About Fixing You</h1>
				<p class="at-lede">
					Many people arrive at therapy believing something is wrong with
					them.
				</p>
			</div>
		</section>

		<!-- ============== ESSAY ============== -->
		<section class="at-essay section">
			<div class="container at-essay-inner">
				<article class="at-prose">
					<p>
						Perhaps you've spent years trying to hold everything together.
						You've pushed through anxiety, ignored exhaustion, put everyone
						else first, overthought every decision, or criticised yourself
						for not coping better.
					</p>

					<p class="at-aside">From the outside, life may appear fine.</p>
					<p class="at-aside">
						On the inside, however, it can feel very different.
					</p>

					<p>
						You might find yourself constantly busy but never settled.
						Surrounded by people yet feeling alone. Achieving goals but still
						questioning your worth. Knowing what you should do but feeling
						unable to do it.
					</p>

					<p class="at-pullquote">
						Therapy is not about fixing what is broken because I do not
						believe you are broken.
					</p>

					<p>
						Often, the difficulties we experience are understandable
						responses to the lives we have lived, the experiences we have
						had, and the roles we have learned to play.
					</p>

					<p class="at-aside">Sometimes we become disconnected from ourselves.</p>
					<p class="at-aside">Disconnected from our bodies.</p>
					<p class="at-aside">Disconnected from our emotions.</p>
					<p class="at-aside">Disconnected from what we truly need.</p>

					<p>
						Over time, this disconnection can show up as anxiety, low mood,
						burnout, relationship difficulties, people-pleasing, loss of
						confidence, overwhelm, or a persistent feeling that life is
						happening to us rather than being lived by us.
					</p>

					<p class="at-pullquote">
						Therapy creates a space to slow down and begin listening again.
					</p>

					<p>
						Not just to your thoughts, but to the deeper parts of yourself
						that may have been ignored, silenced, or forgotten.
					</p>

					<p>
						At Awaken Discovery, therapy is not about giving advice or
						telling you how to live your life.
					</p>

					<p>
						It is about helping you understand yourself more fully,
						recognise the patterns that no longer serve you, and reconnect
						with your own inner wisdom and strengths.
					</p>

					<p class="at-pullquote">
						Change often begins not when we become someone different, but
						when we finally understand and accept who we are.
					</p>

					<footer class="at-signature">
						<p class="at-signature-name">Allyson Donoghue</p>
						<p class="at-signature-role">Teacher · Counsellor & Psychotherapist</p>
					</footer>
				</article>
			</div>
		</section>

		<!-- ============== HOW THERAPY CAN HELP ============== -->
		<section class="at-help section section-soft">
			<div class="container">
				<header class="at-help-header">
					<p class="at-eyebrow">How therapy can help</p>
					<h2 class="at-h2">Therapy is not simply talking about problems.</h2>
					<p class="at-help-lede">
						It is about creating meaningful change in the way you experience
						yourself, your relationships, and your life. Together, we might
						explore:
					</p>
				</header>

				<div class="at-help-grid">
					{
						scenarios.map((s) => (
							<article class="at-help-card">
								<h3 class="at-help-heading">{s.heading}</h3>
								<p class="at-help-body">{s.body}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<!-- ============== CLOSING CTA ============== -->
		<section class="at-cta section">
			<div class="container at-cta-inner">
				<p class="at-eyebrow">Begin when you're ready</p>
				<h2 class="at-h2">A gentle next step, whenever you'd like to take it.</h2>
				<p class="at-cta-lede">
					You do not need to have everything figured out before you reach out.
					Therapy starts where you are.
				</p>
				<div class="at-cta-row">
					<a
						class="cta cta-solid"
						href={calendlyLinks.individual.sixtyFaceToFace}
						target="_blank"
						rel="noopener noreferrer"
					>
						Book a Session
					</a>
					<a
						class="cta cta-outline"
						href={calendlyLinks.tasterSession}
						target="_blank"
						rel="noopener noreferrer"
					>
						Book a Free Consultation
					</a>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter locations={locations} />
</Layout>

<style>
	.at-page {
		--ink: var(--color-dark-gray);
		--ink-soft: #4d5559;
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #00422f;
		--cream: #fdfaf5;
	}

	/* ---------- Shared type ---------- */
	.at-eyebrow {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--brand);
	}

	.at-h1 {
		margin: 1rem 0 1.2rem;
		font-family: var(--font-serif);
		font-size: clamp(2.2rem, 5vw, 3.4rem);
		font-weight: 500;
		line-height: 1.12;
		color: var(--ink);
		text-wrap: balance;
	}

	.at-h2 {
		margin: 0.8rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(1.7rem, 3.4vw, 2.4rem);
		font-weight: 500;
		line-height: 1.2;
		color: var(--ink);
		text-wrap: balance;
	}

	/* ---------- HERO ---------- */
	.at-hero {
		padding-block: clamp(4rem, 8vh, 6rem) clamp(1.5rem, 3vh, 2.5rem);
		background: linear-gradient(180deg, #f6f8f6 0%, var(--color-white) 100%);
	}

	.at-hero-inner {
		max-width: 760px;
		margin-inline: auto;
		text-align: center;
	}

	.at-lede {
		margin: 0 auto;
		max-width: 52ch;
		font-family: var(--font-serif);
		font-style: italic;
		font-weight: 500;
		font-size: clamp(1.2rem, 2.2vw, 1.55rem);
		line-height: 1.55;
		color: var(--ink-soft);
	}

	/* ---------- ESSAY ---------- */
	.at-essay {
		padding-block: clamp(2rem, 5vh, 3.5rem) clamp(4rem, 8vh, 6rem);
	}

	.at-essay-inner {
		max-width: 720px;
		margin-inline: auto;
	}

	.at-prose {
		font-family: var(--font-serif);
		font-size: clamp(1.05rem, 1.5vw, 1.18rem);
		line-height: 1.85;
		color: var(--ink);
	}

	.at-prose p {
		margin: 0 0 1.4rem;
	}

	.at-prose p.at-aside {
		font-style: italic;
		color: var(--ink-soft);
		margin-bottom: 0.6rem;
	}

	.at-prose p.at-aside + p:not(.at-aside) {
		margin-top: 0.8rem;
	}

	.at-pullquote {
		margin: 2.2rem 0 2.2rem !important;
		padding: 1.4rem 0;
		border-top: 1px solid rgb(0 94 71 / 18%);
		border-bottom: 1px solid rgb(0 94 71 / 18%);
		text-align: center;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: clamp(1.25rem, 2vw, 1.55rem);
		line-height: 1.5;
		color: var(--brand-deep);
		text-wrap: balance;
	}

	.at-signature {
		margin: 3rem 0 0;
		padding-top: 2rem;
		border-top: 1px solid rgb(0 94 71 / 18%);
		text-align: right;
	}

	.at-signature-name {
		margin: 0;
		font-family: var(--font-script);
		font-size: clamp(1.8rem, 3.5vw, 2.4rem);
		line-height: 1;
		color: var(--brand);
	}

	.at-signature-role {
		margin: 0.4rem 0 0;
		font-family: var(--font-body);
		font-size: 0.78rem;
		font-style: normal;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink-soft);
	}

	/* ---------- HOW THERAPY CAN HELP ---------- */
	.at-help {
		padding-block: clamp(4rem, 8vh, 6rem);
	}

	.at-help-header {
		max-width: 720px;
		margin: 0 auto 3rem;
		text-align: center;
	}

	.at-help-lede {
		margin: 0 auto;
		max-width: 56ch;
		font-size: 1.02rem;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.at-help-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}

	.at-help-card {
		background: var(--color-white);
		border-radius: 1rem;
		padding: clamp(1.5rem, 2.5vw, 2rem);
		box-shadow: 0 6px 18px rgb(29 35 39 / 5%);
		border: 1px solid rgb(0 94 71 / 8%);
	}

	.at-help-heading {
		margin: 0 0 0.6rem;
		font-family: var(--font-serif);
		font-size: clamp(1.1rem, 1.8vw, 1.25rem);
		font-weight: 500;
		line-height: 1.3;
		color: var(--brand-deep);
	}

	.at-help-body {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.7;
		color: var(--ink-soft);
	}

	/* ---------- CLOSING CTA ---------- */
	.at-cta {
		padding-block: clamp(4rem, 8vh, 6rem);
	}

	.at-cta-inner {
		max-width: 680px;
		margin-inline: auto;
		text-align: center;
	}

	.at-cta-lede {
		margin: 0 auto 2rem;
		max-width: 50ch;
		font-size: 1.05rem;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.at-cta-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.8rem;
	}

	/* ---------- Mobile ---------- */
	@media (max-width: 720px) {
		.at-help-grid {
			grid-template-columns: 1fr;
		}

		.at-signature {
			text-align: left;
		}

		.at-pullquote {
			margin: 1.8rem 0 !important;
			padding: 1.2rem 0;
		}
	}
</style>
