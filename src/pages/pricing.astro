---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { locations, navItems } from "../data/site";

type BulkCard = {
	type: "ind" | "cou";
	sessions: number;
	price: string;
	headlinePrice: string;
	headerVariant: "dark" | "sage";
	popular: boolean;
	bullets: string[];
};

const bulkCards: BulkCard[] = [
	{
		type: "ind",
		sessions: 10,
		price: "£540",
		headlinePrice: "540",
		headerVariant: "dark",
		popular: true,
		bullets: [
			"Ideal for focused personal development",
			"Extendable sessions to suit your needs",
			"Recommended frequency: Weekly/Fortnightly",
		],
	},
	{
		type: "ind",
		sessions: 6,
		price: "£324",
		headlinePrice: "324",
		headerVariant: "sage",
		popular: false,
		bullets: [
			"Ideal for focused personal development",
			"Extendable sessions to suit your needs",
			"Recommended frequency: Weekly/Fortnightly",
		],
	},
	{
		type: "cou",
		sessions: 10,
		price: "£810",
		headlinePrice: "810",
		headerVariant: "dark",
		popular: true,
		bullets: [
			"Ideal for strengthening your relationship",
			"Sessions tailored to your needs as a couple",
			"Recommended frequency: Weekly/Fortnightly",
		],
	},
	{
		type: "cou",
		sessions: 6,
		price: "£486",
		headlinePrice: "486",
		headerVariant: "sage",
		popular: false,
		bullets: [
			"Ideal for strengthening your relationship",
			"Sessions tailored to your needs as a couple",
			"Recommended frequency: Weekly/Fortnightly",
		],
	},
];

type Package = {
	value: string;
	label: string;
	sublabel: string;
	priceLabel: string;
	priceAmount: number;
	stripePriceId: string;
};

// Stripe price IDs — replace these placeholders with real `price_xxx` values
// from your Stripe dashboard once the products are created.
const packages: Package[] = [
	{
		value: "ind-10",
		label: "Individual — 10 × 60 min sessions",
		sublabel: "For the price of 9",
		priceLabel: "£540.00",
		priceAmount: 540,
		stripePriceId: "{{STRIPE_PRICE_IND_10}}",
	},
	{
		value: "ind-6",
		label: "Individual — 6 × 60 min sessions",
		sublabel: "For the price of 5",
		priceLabel: "£324.00",
		priceAmount: 324,
		stripePriceId: "{{STRIPE_PRICE_IND_6}}",
	},
	{
		value: "cou-10",
		label: "Couples — 10 × 60 min sessions",
		sublabel: "For the price of 9",
		priceLabel: "£810.00",
		priceAmount: 810,
		stripePriceId: "{{STRIPE_PRICE_COU_10}}",
	},
	{
		value: "cou-6",
		label: "Couples — 6 × 60 min sessions",
		sublabel: "For the price of 5",
		priceLabel: "£486.00",
		priceAmount: 486,
		stripePriceId: "{{STRIPE_PRICE_COU_6}}",
	},
];

const referralOptions = [
	"Google search",
	"Recommendation from a friend or family member",
	"Recommendation from a healthcare professional",
	"Instagram",
	"Facebook",
	"LinkedIn",
	"Therapist directory",
	"Other",
];

const countryOptions = [
	"United Kingdom",
	"Ireland",
	"Other",
];

const finePrint =
	"Contact us within 7 days of receipt to book. For gift options, specify at checkout for an extension. Expiry enforced from the date provided for gifts.";
---

<Layout
	title="Pricing · Awaken Discovery"
	description="Single-session and bulk session pricing for individuals and couples. Save 10% with our 6 or 10 session bulk packages."
>
	<SiteHeader navItems={navItems} />
	<main class="pr-page">
		<!-- ============== HERO ============== -->
		<section class="pr-hero section">
			<div class="container">
				<div class="pr-hero-inner">
					<p class="section-kicker">Pricing</p>
					<h1>Bulk Sessions</h1>
					<p class="pr-lede">
						Choose from our 10-session or 6-session packages, offering
						savings tailored to your personal development journey.
					</p>
					<p class="pr-note">
						We recommend scheduling sessions weekly or fortnightly for
						consistency and progress. Please book within seven days of
						receipt to secure your sessions.
					</p>
					<p class="pr-note">
						<strong>Gift options available</strong> — specify at checkout
						for an extended booking period.
					</p>
					<p class="pr-note pr-note-soft">
						Discounted bundles are non-refundable but can be rescheduled
						with 7 days' notice. <a href="/contact">Contact us</a> to find
						out more.
					</p>
				</div>
			</div>
		</section>

		<!-- ============== SINGLE SESSION (context) ============== -->
		<section class="pr-single section section-soft">
			<div class="container pr-single-inner">
				<div class="pr-single-row">
					<div>
						<p class="section-kicker">Prefer single sessions?</p>
						<h2>Start with one session at a time</h2>
						<p class="pr-single-body">
							Not ready for a bundle? Single sessions are available at standard
							rates from £60. Useful for ongoing support without committing in
							advance, or for trying therapy for the first time.
						</p>
						<p class="pr-single-body" style="margin-top: 0.8rem;">
							<a class="cta cta-outline" href="/pricing/individual">
								See Individual Session Pricing →
							</a>
						</p>
					</div>
					<dl class="pr-single-prices">
						<div>
							<dt>Individuals</dt>
							<dd>
								<span class="pr-single-price">£60</span>
								<span class="pr-single-cadence">60 minutes</span>
							</dd>
						</div>
						<div>
							<dt>Couples</dt>
							<dd>
								<span class="pr-single-price">£90</span>
								<span class="pr-single-cadence">60 minutes</span>
							</dd>
						</div>
					</dl>
				</div>
			</div>
		</section>

		<!-- ============== BULK SESSIONS ============== -->
		<section class="pr-bulk section" id="bulk">
			<div class="container">
				<header class="pr-bulk-head">
					<p class="section-kicker">Bulk sessions</p>
					<h2>Choose Individual or Couples</h2>
					<p class="pr-bulk-lede">
						Save 10% when you book in bundles. Pick the format below — pricing
						and what's included updates accordingly.
					</p>
				</header>

				<div class="pr-tabs">
					<input
						type="radio"
						name="pr-tab"
						id="pr-tab-ind"
						class="pr-tab-input"
						checked
					/>
					<input
						type="radio"
						name="pr-tab"
						id="pr-tab-cou"
						class="pr-tab-input"
					/>

					<div class="pr-tab-switch" role="tablist" aria-label="Pricing for">
						<label for="pr-tab-ind" class="pr-tab-label">Individuals</label>
						<label for="pr-tab-cou" class="pr-tab-label">Couples</label>
					</div>

					<div class="pr-tab-panels">
						{
							["ind", "cou"].map((group) => (
								<div class={`pr-tab-panel pr-tab-panel-${group}`}>
									<div class="pr-card-grid">
										{bulkCards
											.filter((c) => c.type === group)
											.map((card) => (
												<article
													class={`pr-card pr-card-${card.headerVariant}`}
												>
													{card.popular && (
														<span class="pr-popular" aria-hidden="true">
															Popular
														</span>
													)}
													<header class="pr-card-header">
														<h3>
															Bulk Sessions For{" "}
															{card.type === "ind" ? "Individuals" : "Couples"}
														</h3>
														<p>
															Save 10% by buying {card.sessions} sessions
														</p>
													</header>
													<div class="pr-card-body">
														<p class="pr-card-price">
															<span class="pr-card-currency">£</span>
															<span class="pr-card-amount">
																{card.headlinePrice}
															</span>
														</p>
														<p class="pr-card-save">Save 10%</p>
														<ul class="pr-card-bullets">
															{card.bullets.map((b) => (
																<li>{b}</li>
															))}
														</ul>
														<a class="cta cta-solid pr-card-cta" href="#book">
															Book Now
														</a>
														<p class="pr-card-fineprint">{finePrint}</p>
													</div>
												</article>
											))}
									</div>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- ============== BOOK FORM ============== -->
		<section class="pr-book section section-soft" id="book">
			<div class="container">
				<div class="pr-book-inner">
					<p class="section-kicker">Next step</p>
					<h2>Book Your Bulk Sessions</h2>
					<p class="pr-book-lede">
						Fill in your details below and choose your package. If you'd like
						to pay now, you'll be taken to a secure Stripe payment page. If
						you'd rather have a chat first, leave the "pay now" option as no
						and I'll be in touch within one working day.
					</p>

					<form
						class="pr-form"
						id="booking-form"
						method="post"
						action="#"
						aria-describedby="pr-form-todo"
						novalidate
					>
					<div class="pr-form-cols">
						<div class="pr-form-main">
						<!-- ===== YOUR DETAILS ===== -->
						<fieldset class="pr-fieldset">
							<legend class="pr-legend">Your details</legend>
							<div class="pr-grid-2">
								<label class="pr-field">
									<span>
										First name <span class="pr-req">*</span>
									</span>
									<input
										type="text"
										name="first_name"
										autocomplete="given-name"
										required
									/>
								</label>
								<label class="pr-field">
									<span>
										Last name <span class="pr-req">*</span>
									</span>
									<input
										type="text"
										name="last_name"
										autocomplete="family-name"
										required
									/>
								</label>
							</div>
							<label class="pr-field">
								<span>
									Email <span class="pr-req">*</span>
								</span>
								<input
									type="email"
									name="email"
									autocomplete="email"
									required
								/>
							</label>
							<label class="pr-field">
								<span>
									Phone / Mobile <span class="pr-req">*</span>
								</span>
								<input
									type="tel"
									name="phone"
									autocomplete="tel"
									required
								/>
							</label>

							<fieldset class="pr-radio-group">
								<legend>
									Preferred method of contact <span class="pr-req">*</span>
								</legend>
								<label class="pr-radio">
									<input
										type="radio"
										name="contact_pref"
										value="email"
										required
										checked
									/>
									<span>Email</span>
								</label>
								<label class="pr-radio">
									<input
										type="radio"
										name="contact_pref"
										value="telephone"
									/>
									<span>Telephone</span>
								</label>
							</fieldset>
						</fieldset>

						<!-- ===== ADDRESS ===== -->
						<fieldset class="pr-fieldset">
							<legend class="pr-legend">Address</legend>
							<div class="pr-grid-2">
								<label class="pr-field">
									<span>
										Address line 1 <span class="pr-req">*</span>
									</span>
									<input
										type="text"
										name="address_1"
										autocomplete="address-line1"
										required
									/>
								</label>
								<label class="pr-field">
									<span>Address line 2</span>
									<input
										type="text"
										name="address_2"
										autocomplete="address-line2"
									/>
								</label>
								<label class="pr-field">
									<span>City</span>
									<input
										type="text"
										name="city"
										autocomplete="address-level2"
									/>
								</label>
								<label class="pr-field">
									<span>County</span>
									<input
										type="text"
										name="county"
										autocomplete="address-level1"
									/>
								</label>
								<label class="pr-field">
									<span>
										Postcode <span class="pr-req">*</span>
									</span>
									<input
										type="text"
										name="postcode"
										autocomplete="postal-code"
										required
									/>
								</label>
								<label class="pr-field">
									<span>Country</span>
									<select name="country" autocomplete="country">
										{
											countryOptions.map((c) => (
												<option value={c}>{c}</option>
											))
										}
									</select>
								</label>
							</div>
						</fieldset>

						<!-- ===== ABOUT YOU ===== -->
						<fieldset class="pr-fieldset">
							<legend class="pr-legend">About you</legend>
							<fieldset class="pr-radio-group">
								<legend>
									Are you a returning customer?
									<span class="pr-req">*</span>
								</legend>
								<label class="pr-radio">
									<input type="radio" name="returning" value="yes" required />
									<span>Yes</span>
								</label>
								<label class="pr-radio">
									<input type="radio" name="returning" value="no" />
									<span>No</span>
								</label>
							</fieldset>

							<label class="pr-checkbox">
								<input type="checkbox" name="newsletter" />
								<span>
									Yes, I'd like to receive updates, newsletters and supportive
									wellbeing emails from Awaken Discovery Counselling &amp;
									Psychotherapy. I can unsubscribe at any time.
								</span>
							</label>

							<label class="pr-checkbox">
								<input
									type="checkbox"
									name="terms"
									required
								/>
								<span>
									<span class="pr-req">*</span> I have read and agree to the
									<a href="/terms">Bulk Pricing Terms &amp; Conditions</a>.
								</span>
							</label>
						</fieldset>
						</div>

						<aside class="pr-form-aside">
						<!-- ===== YOUR BOOKING ===== -->
						<fieldset class="pr-fieldset pr-fieldset-booking">
							<legend class="pr-legend">Your booking</legend>

							<fieldset class="pr-package-group" aria-required="true">
								<legend>
									Choose how many sessions you would like
									<span class="pr-req">*</span>
								</legend>
								<div class="pr-package-list">
									{
										packages.map((p) => (
											<label
												class="pr-package"
												data-price={p.priceAmount}
												data-stripe-price={p.stripePriceId}
											>
												<input
													type="radio"
													name="package"
													value={p.value}
													required
												/>
												<span class="pr-package-body">
													<span class="pr-package-label">{p.label}</span>
													<span class="pr-package-sub">{p.sublabel}</span>
												</span>
												<span class="pr-package-price">{p.priceLabel}</span>
											</label>
										))
									}
								</div>
							</fieldset>

							<label class="pr-field">
								<span>Your comments (optional)</span>
								<textarea
									name="comments"
									rows="4"
									placeholder="Anything you'd like me to know before we begin?"
								></textarea>
							</label>

							<div class="pr-summary" aria-live="polite">
								<div class="pr-summary-row">
									<span>Selected package</span>
									<span class="pr-summary-package" data-empty="true">
										No package selected yet
									</span>
								</div>
								<div class="pr-summary-row pr-summary-total-row">
									<span>Total</span>
									<span class="pr-summary-total">£0.00</span>
								</div>
							</div>

							<label class="pr-field">
								<span>How did you hear about me?</span>
								<select name="referral">
									<option value="">— Select —</option>
									{
										referralOptions.map((opt) => (
											<option value={opt}>{opt}</option>
										))
									}
								</select>
							</label>

							<fieldset class="pr-radio-group">
								<legend>
									I'm happy to pay now for my bulk session block
									<span class="pr-req">*</span>
								</legend>
								<label class="pr-radio">
									<input
										type="radio"
										name="pay_now"
										value="yes"
										required
										checked
									/>
									<span>Yes — take me to secure payment</span>
								</label>
								<label class="pr-radio">
									<input type="radio" name="pay_now" value="no" />
									<span>No, I'd like to speak with you first</span>
								</label>
							</fieldset>

							<button class="cta cta-solid pr-submit" type="submit">
								<span data-submit-pay>Make Payment</span>
								<span data-submit-enquire hidden>Send Booking Enquiry</span>
							</button>

							<label class="pr-checkbox">
								<input
									type="checkbox"
									name="data_consent"
									required
								/>
								<span>
									<span class="pr-req">*</span> I consent to Awaken Discovery
									storing my submitted information so they can respond to my
									booking and process my payment.
								</span>
							</label>

						</fieldset>

						<p id="pr-form-todo" class="pr-book-todo">
							{`{{TODO: STRIPE INTEGRATION
1. Create the four products in Stripe Dashboard (Individual 6/10, Couples 6/10) and replace {{STRIPE_PRICE_*}} placeholders in src/pages/pricing.astro with the real price_xxx IDs.
2. Create a /api/create-checkout-session endpoint (Astro server route or Netlify function) that accepts the form payload, calls stripe.checkout.sessions.create() with the selected price_id + customer email + metadata, and returns { url }.
3. In the script at the bottom of this page, replace the alert() with: fetch('/api/create-checkout-session', { method: 'POST', body: JSON.stringify(payload) }).then(r => r.json()).then(({url}) => window.location = url);
4. If pay_now === 'no', POST the same payload to /api/booking-enquiry (sends email to Ally) and redirect to /pricing/thank-you.
5. Add Stripe webhook handler for checkout.session.completed → write booking record + send confirmation email.
6. Optional: switch to Stripe Elements (in-page card) instead of Checkout if you prefer not to redirect — uses stripe.confirmPayment() with a PaymentIntent created server-side.}}`}
						</p>
						</aside>
					</div>
					</form>
				</div>
			</div>
		</section>

		<script is:inline>
			(function () {
				const form = document.getElementById("booking-form");
				if (!form) return;

				const packageInputs = form.querySelectorAll('input[name="package"]');
				const summaryPackage = form.querySelector(".pr-summary-package");
				const summaryTotal = form.querySelector(".pr-summary-total");
				const payNowInputs = form.querySelectorAll('input[name="pay_now"]');
				const submitPay = form.querySelector("[data-submit-pay]");
				const submitEnquire = form.querySelector("[data-submit-enquire]");

				const updateSummary = () => {
					const selected = form.querySelector(
						'input[name="package"]:checked'
					);
					if (!selected) {
						summaryPackage.textContent = "No package selected yet";
						summaryPackage.setAttribute("data-empty", "true");
						summaryTotal.textContent = "£0.00";
						return;
					}
					const label = selected.closest(".pr-package");
					const price = parseFloat(label.dataset.price);
					const text = label.querySelector(".pr-package-label").textContent;
					summaryPackage.textContent = text;
					summaryPackage.removeAttribute("data-empty");
					summaryTotal.textContent = `£${price.toFixed(2)}`;
				};

				const updateSubmitLabel = () => {
					const payNow =
						form.querySelector('input[name="pay_now"]:checked')?.value ===
						"yes";
					submitPay.hidden = !payNow;
					submitEnquire.hidden = payNow;
				};

				packageInputs.forEach((input) =>
					input.addEventListener("change", updateSummary)
				);
				payNowInputs.forEach((input) =>
					input.addEventListener("change", updateSubmitLabel)
				);

				form.addEventListener("submit", (event) => {
					event.preventDefault();
					if (!form.reportValidity()) return;

					const selected = form.querySelector(
						'input[name="package"]:checked'
					);
					const stripePriceId = selected
						?.closest(".pr-package")
						?.getAttribute("data-stripe-price");
					const payNow =
						form.querySelector('input[name="pay_now"]:checked')?.value;

					// TODO: Wire to Stripe Checkout / booking-enquiry endpoint.
					// See {{TODO: STRIPE INTEGRATION ...}} note above for the
					// exact contract.
					alert(
						"Form is not yet wired up.\n\nNext step: Stripe integration.\n\n" +
							"Selected price ID: " +
							stripePriceId +
							"\nPay now: " +
							payNow
					);
				});

				updateSummary();
				updateSubmitLabel();
			})();
		</script>
	</main>
	<SiteFooter
		locations={locations}
		tagline="Calm, transparent pricing — book a bundle or a single session."
	/>
</Layout>

<style>
	.pr-page {
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		--ink: var(--color-dark-gray);
		--ink-soft: rgb(29 35 39 / 78%);
		color: var(--ink);
	}

	.pr-page .section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--brand);
	}

	.pr-page h1,
	.pr-page h2 {
		font-family: var(--font-serif);
		font-weight: 500;
		text-wrap: balance;
	}

	.pr-page h1 {
		margin: 0.6rem 0 1rem;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		line-height: 1.12;
		color: var(--brand-deep);
	}

	.pr-page h2 {
		margin: 0.6rem 0 0.9rem;
		font-size: clamp(1.7rem, 3.3vw, 2.4rem);
		line-height: 1.2;
	}

	/* ---------- HERO ---------- */
	.pr-hero {
		background: linear-gradient(180deg, var(--color-white) 0%, var(--brand-tint) 100%);
		padding-top: 4rem;
	}

	.pr-hero-inner {
		max-width: 62ch;
	}

	.pr-lede {
		margin: 0 0 1.2rem;
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		line-height: 1.7;
		color: var(--ink-soft);
		max-width: 60ch;
	}

	.pr-note {
