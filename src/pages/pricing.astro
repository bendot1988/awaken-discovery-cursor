---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { locations, navItems } from "../data/site";
import { calendlyLinks } from "../data/calendly";

type BulkCard = {
	type: "ind" | "cou";
	sessions: number;
	price: string;
	headlinePrice: string;
	headerVariant: "dark" | "sage";
	popular: boolean;
	bullets: string[];
};

const bulkCards: BulkCard[] = [
	{
		type: "ind",
		sessions: 10,
		price: "£540",
		headlinePrice: "540",
		headerVariant: "dark",
		popular: true,
		bullets: [
			"Ideal for focused personal development",
			"60-minute sessions only",
			"Dates and times agreed together",
		],
	},
	{
		type: "ind",
		sessions: 6,
		price: "£324",
		headlinePrice: "324",
		headerVariant: "sage",
		popular: false,
		bullets: [
			"Ideal for focused personal development",
			"60-minute sessions only",
			"Dates and times agreed together",
		],
	},
	{
		type: "cou",
		sessions: 10,
		price: "£810",
		headlinePrice: "810",
		headerVariant: "dark",
		popular: true,
		bullets: [
			"Ideal for strengthening your relationship",
			"60-minute sessions only",
			"Dates and times agreed together",
		],
	},
	{
		type: "cou",
		sessions: 6,
		price: "£486",
		headlinePrice: "486",
		headerVariant: "sage",
		popular: false,
		bullets: [
			"Ideal for strengthening your relationship",
			"60-minute sessions only",
			"Dates and times agreed together",
		],
	},
];

const finePrint =
	"Bundles are 60-minute sessions only, arranged after a free 20-minute consultation. Sessions must be booked within 7 days of payment. Non-refundable, but rescheduling with 7 days' notice is fine.";
---

<Layout
	title="Pricing · Awaken Discovery"
	description="Single-session and bulk session pricing for individuals and couples. Save 10% with our 6 or 10 session bulk packages."
>
	<SiteHeader navItems={navItems} />
	<main class="pr-page">
		<!-- ============== HERO ============== -->
		<section class="pr-hero section">
			<div class="container">
				<div class="pr-hero-inner">
					<p class="section-kicker">Pricing</p>
					<h1>Bulk Sessions</h1>
					<p class="pr-lede">
						Choose from our 10-session or 6-session packages, offering
						savings tailored to your personal development journey.
					</p>
					<p class="pr-note">
						We recommend scheduling sessions weekly or fortnightly for
						consistency and progress. Please book within seven days of
						receipt to secure your sessions.
					</p>
					<p class="pr-note">
						<strong>Gift options available</strong> — specify at checkout
						for an extended booking period.
					</p>
					<p class="pr-note pr-note-soft">
						All bundle sessions are <strong>60 minutes</strong>. For 90-minute
						single sessions, see
						<a href="/pricing/individual">single session pricing</a>.
					</p>
				</div>
			</div>
		</section>

		<!-- ============== SINGLE SESSION (context) ============== -->
		<section class="pr-single section section-soft">
			<div class="container pr-single-inner">
				<div class="pr-single-row">
					<div>
						<p class="section-kicker">Prefer single sessions?</p>
						<h2>Start with one session at a time</h2>
						<p class="pr-single-body">
							Not ready for a bundle? Single sessions are available at standard
							rates from £60. Useful for ongoing support without committing in
							advance, or for trying therapy for the first time.
						</p>
						<p class="pr-single-body" style="margin-top: 0.8rem;">
							<a class="cta cta-outline" href="/pricing/individual">
								See Individual Session Pricing →
							</a>
						</p>
					</div>
					<dl class="pr-single-prices">
						<div>
							<dt>Individuals</dt>
							<dd>
								<span class="pr-single-price">£60</span>
								<span class="pr-single-cadence">60 minutes</span>
							</dd>
						</div>
						<div>
							<dt>Couples</dt>
							<dd>
								<span class="pr-single-price">£90</span>
								<span class="pr-single-cadence">60 minutes</span>
							</dd>
						</div>
					</dl>
				</div>
			</div>
		</section>

		<!-- ============== BULK SESSIONS ============== -->
		<section class="pr-bulk section" id="bulk">
			<div class="container">
				<header class="pr-bulk-head">
					<p class="section-kicker">Bulk sessions</p>
					<h2>Choose Individual or Couples</h2>
					<p class="pr-bulk-lede">
						Save 10% when you book in bundles. Pick the format below — pricing
						and what's included updates accordingly.
					</p>
				</header>

				<div class="pr-tabs">
					<input
						type="radio"
						name="pr-tab"
						id="pr-tab-ind"
						class="pr-tab-input"
						checked
					/>
					<input
						type="radio"
						name="pr-tab"
						id="pr-tab-cou"
						class="pr-tab-input"
					/>

					<div class="pr-tab-switch" role="tablist" aria-label="Pricing for">
						<label for="pr-tab-ind" class="pr-tab-label">Individuals</label>
						<label for="pr-tab-cou" class="pr-tab-label">Couples</label>
					</div>

					<div class="pr-tab-panels">
						{
							["ind", "cou"].map((group) => (
								<div class={`pr-tab-panel pr-tab-panel-${group}`}>
									<div class="pr-card-grid">
										{bulkCards
											.filter((c) => c.type === group)
											.map((card) => (
												<article
													class={`pr-card pr-card-${card.headerVariant}`}
												>
													{card.popular && (
														<span class="pr-popular" aria-hidden="true">
															Popular
														</span>
													)}
													<header class="pr-card-header">
														<h3>
															Bulk Sessions For{" "}
															{card.type === "ind" ? "Individuals" : "Couples"}
														</h3>
														<p class="pr-card-sessions">
															<span class="pr-card-sessions-num">
																{card.sessions}
															</span>
															<span class="pr-card-sessions-text">sessions</span>
														</p>
														<p class="pr-card-header-note">Save 10% on the bundle price</p>
													</header>
													<div class="pr-card-body">
														<p class="pr-card-price">
															<span class="pr-card-currency">£</span>
															<span class="pr-card-amount">
																{card.headlinePrice}
															</span>
														</p>
														<p class="pr-card-save">Save 10%</p>
														<ul class="pr-card-bullets">
															{card.bullets.map((b) => (
																<li>{b}</li>
															))}
														</ul>
														<a
															class="cta cta-solid pr-card-cta"
															href={calendlyLinks.tasterSession}
															target="_blank"
															rel="noopener noreferrer"
														>
															Enquire to Book
														</a>
														<p class="pr-card-fineprint">{finePrint}</p>
													</div>
												</article>
											))}
									</div>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- ============== ENQUIRE ABOUT BUNDLES ============== -->
		<section class="pr-book section section-soft" id="book">
			<div class="container">
				<div class="pr-enquire-inner">
					<p class="section-kicker">Next step</p>
					<h2>Enquire About a Bulk Bundle</h2>
					<p class="pr-enquire-lede">
						Bundles are arranged after a short, free conversation — that way we
						can make sure the format, dates and times feel right for you before
						you commit. Book a free 20-minute consultation below and I'll walk
						you through the package, scheduling and payment.
					</p>

					<ol class="pr-enquire-steps">
						<li>
							<span class="pr-enquire-num" aria-hidden="true">1</span>
							<div>
								<h3>Book a free 20-minute chat</h3>
								<p>
									Pick a time that suits you on my Calendly — no payment yet,
									no pressure.
								</p>
							</div>
						</li>
						<li>
							<span class="pr-enquire-num" aria-hidden="true">2</span>
							<div>
								<h3>We chat through what you need</h3>
								<p>
									We'll confirm which bundle fits, agree dates and times, and
									answer any questions about how the work feels.
								</p>
							</div>
						</li>
						<li>
							<span class="pr-enquire-num" aria-hidden="true">3</span>
							<div>
								<h3>Pay &amp; start your sessions</h3>
								<p>
									Once we've agreed your bundle, I'll send a secure
									<strong>Stripe</strong> payment link and we'll get the first
									session in the diary.
								</p>
							</div>
						</li>
					</ol>

					<div class="pr-enquire-actions">
						<a
							class="cta cta-solid"
							href={calendlyLinks.tasterSession}
							target="_blank"
							rel="noopener noreferrer"
						>
							Book Your Free 20-min Consultation
						</a>
						<a class="cta cta-outline" href="/pricing/individual">
							Browse Single Sessions
						</a>
					</div>

					<p class="pr-enquire-fineprint">
						Prefer to ask first by email or phone?
						<a href="/contact">Get in touch</a>
						and I'll come back to you within one working day.
					</p>
				</div>
			</div>
		</section>

	</main>
	<SiteFooter
		locations={locations}
		tagline="Calm, transparent pricing — book a bundle or a single session."
	/>
</Layout>

<style>
	.pr-page {
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		--ink: var(--color-dark-gray);
		--ink-soft: rgb(29 35 39 / 78%);
		color: var(--ink);
	}

	.pr-page .section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--brand);
	}

	.pr-page h1,
	.pr-page h2 {
		font-family: var(--font-serif);
		font-weight: 500;
		text-wrap: balance;
	}

	.pr-page h1 {
		margin: 0.6rem 0 1rem;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		line-height: 1.12;
		color: var(--brand-deep);
	}

	.pr-page h2 {
		margin: 0.6rem 0 0.9rem;
		font-size: clamp(1.7rem, 3.3vw, 2.4rem);
		line-height: 1.2;
	}

	/* ---------- HERO ---------- */
	.pr-hero {
		background: linear-gradient(180deg, var(--color-white) 0%, var(--brand-tint) 100%);
		padding-top: 4rem;
	}

	.pr-hero-inner {
		max-width: 62ch;
	}

	.pr-lede {
		margin: 0 0 1.2rem;
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		line-height: 1.7;
		color: var(--ink-soft);
		max-width: 60ch;
	}

	.pr-note {
		margin: 0 0 0.7rem;
		line-height: 1.7;
	}

	.pr-note-soft {
		font-size: 0.92rem;
		color: var(--ink-soft);
	}

	.pr-note a {
		color: var(--brand);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* ---------- SINGLE SESSION ---------- */
	.pr-single-row {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: center;
	}

	.pr-single-body {
		margin: 0;
		line-height: 1.75;
		color: var(--ink-soft);
		max-width: 56ch;
	}

	.pr-single-prices {
		margin: 0;
		display: grid;
		gap: 0.9rem;
	}

	.pr-single-prices > div {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: baseline;
		gap: 0 1rem;
		padding: 1rem 1.2rem;
		background: var(--color-white);
		border: 1px solid rgb(0 94 71 / 18%);
		border-radius: 0.85rem;
	}

	.pr-single-prices dt {
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--brand-deep);
	}

	.pr-single-prices dd {
		margin: 0;
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		justify-self: end;
	}

	.pr-single-price {
		font-family: var(--font-serif);
		font-size: clamp(1.7rem, 2.6vw, 2.1rem);
		color: var(--brand);
	}

	.pr-single-cadence {
		font-size: 0.85rem;
		color: var(--ink-soft);
	}

	/* ---------- BULK / TABS ---------- */
	.pr-bulk-head {
		max-width: 60ch;
		margin-bottom: 1.8rem;
	}

	.pr-bulk-lede {
		margin: 0;
		color: var(--ink-soft);
		line-height: 1.75;
	}

	.pr-tabs {
		position: relative;
	}

	.pr-tab-input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.pr-tab-switch {
		display: inline-flex;
		padding: 0.3rem;
		border-radius: 999px;
		background: var(--brand-tint);
		border: 1px solid rgb(0 94 71 / 18%);
		margin: 0 auto 2rem;
		gap: 0.3rem;
	}

	.pr-tab-switch {
		display: flex;
		justify-content: center;
		max-width: max-content;
		margin-inline: auto;
	}

	.pr-tab-label {
		padding: 0.55rem 1.4rem;
		border-radius: 999px;
		font-size: 0.9rem;
		font-weight: 500;
		cursor: pointer;
		color: var(--ink-soft);
		transition: background-color 0.2s ease, color 0.2s ease;
	}

	.pr-tab-label:hover {
		color: var(--brand-deep);
	}

	#pr-tab-ind:checked ~ .pr-tab-switch label[for="pr-tab-ind"],
	#pr-tab-cou:checked ~ .pr-tab-switch label[for="pr-tab-cou"] {
		background: var(--color-white);
		color: var(--brand-deep);
		box-shadow: 0 1px 4px rgb(0 94 71 / 18%);
	}

	.pr-tab-input:focus-visible ~ .pr-tab-switch label[for="pr-tab-ind"],
	#pr-tab-ind:focus-visible ~ .pr-tab-switch label[for="pr-tab-ind"] {
		outline: 2px solid var(--brand);
		outline-offset: 2px;
	}

	#pr-tab-cou:focus-visible ~ .pr-tab-switch label[for="pr-tab-cou"] {
		outline: 2px solid var(--brand);
		outline-offset: 2px;
	}

	.pr-tab-panel {
		display: none;
	}

	#pr-tab-ind:checked ~ .pr-tab-panels .pr-tab-panel-ind {
		display: block;
	}

	#pr-tab-cou:checked ~ .pr-tab-panels .pr-tab-panel-cou {
		display: block;
	}

	/* ---------- CARDS ---------- */
	.pr-card-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.4rem;
	}

	.pr-card {
		position: relative;
		display: flex;
		flex-direction: column;
		background: var(--color-white);
		border: 1px solid rgb(0 94 71 / 16%);
		border-radius: 1rem;
		overflow: hidden;
		box-shadow: 0 18px 36px rgb(0 94 71 / 14%);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.pr-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 22px 44px rgb(0 94 71 / 18%);
	}

	.pr-popular {
		position: absolute;
		top: 0;
		right: 0;
		transform: translate(28%, 38%) rotate(45deg);
		transform-origin: center;
		padding: 0.3rem 2.5rem;
		background: var(--brand-deep);
		color: var(--color-white);
		font-family: var(--font-body);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		box-shadow: 0 4px 10px rgb(0 94 71 / 28%);
		z-index: 1;
	}

	.pr-card-header {
		padding: 1.6rem 1.7rem;
		color: var(--color-white);
	}

	.pr-card-dark .pr-card-header {
		background: linear-gradient(160deg, #2a3035 0%, var(--color-dark-gray) 100%);
	}

	.pr-card-sage .pr-card-header {
		background: linear-gradient(160deg, var(--brand) 0%, var(--brand-deep) 100%);
	}

	.pr-card-header h3 {
		margin: 0 0 0.4rem;
		font-family: var(--font-serif);
		font-size: clamp(1.3rem, 2vw, 1.55rem);
		font-weight: 500;
		line-height: 1.2;
		color: var(--color-white);
	}

	.pr-card-sessions {
		margin: 0.85rem 0 0.45rem;
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		line-height: 1;
	}

	.pr-card-sessions-num {
		font-family: var(--font-serif);
		font-size: clamp(3rem, 5.5vw, 3.75rem);
		font-weight: 500;
		font-style: normal;
		letter-spacing: -0.02em;
	}

	.pr-card-sessions-text {
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 2.4vw, 1.65rem);
		font-weight: 500;
		font-style: normal;
		opacity: 0.95;
	}

	.pr-card-header-note {
		margin: 0;
		font-family: var(--font-body);
		font-size: 0.92rem;
		font-style: normal;
		opacity: 0.88;
	}

	.pr-card-body {
		padding: 1.8rem 1.8rem 1.7rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		flex: 1;
	}

	.pr-card-price {
		margin: 0;
		display: flex;
		align-items: flex-start;
		gap: 0.2rem;
		color: var(--brand-deep);
	}

	.pr-card-currency {
		font-family: var(--font-serif);
		font-size: 1.6rem;
		font-weight: 500;
		margin-top: 0.55rem;
	}

	.pr-card-amount {
		font-family: var(--font-serif);
		font-size: clamp(3.6rem, 6.4vw, 4.8rem);
		font-weight: 500;
		line-height: 1;
	}

	.pr-card-save {
		margin: -0.4rem 0 0;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1rem;
		color: var(--brand);
		font-weight: 500;
	}

	.pr-card-bullets {
		list-style: none;
		padding: 0;
		margin: 0.6rem 0;
		display: grid;
		gap: 0;
		border-top: 1px solid rgb(0 94 71 / 14%);
	}

	.pr-card-bullets li {
		padding: 0.9rem 0;
		border-bottom: 1px solid rgb(0 94 71 / 14%);
		font-size: 0.94rem;
		line-height: 1.5;
		color: var(--ink-soft);
	}

	.pr-card-cta {
		margin-top: 0.4rem;
		padding: 0.9rem 1.4rem;
		text-align: center;
		display: block;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.pr-card-cta:hover,
	.pr-card-cta:focus-visible {
		background: var(--brand-deep);
		border-color: var(--brand-deep);
	}

	.pr-card-fineprint {
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.55;
		color: var(--ink-soft);
		text-align: center;
	}

	/* ---------- ENQUIRE SECTION ---------- */
	.pr-book-inner,
	.pr-enquire-inner {
		max-width: 760px;
		margin-inline: auto;
		text-align: center;
	}

	.pr-enquire-lede {
		margin: 0 auto 2rem;
		max-width: 60ch;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.pr-enquire-steps {
		list-style: none;
		padding: 0;
		margin: 0 0 2rem;
		display: grid;
		gap: 1rem;
		text-align: left;
	}

	.pr-enquire-steps li {
		display: grid;
		grid-template-columns: 2.2rem 1fr;
		gap: 1rem;
		align-items: start;
		padding: 1.1rem 1.25rem;
		background: var(--color-white);
		border: 1px solid rgb(0 94 71 / 16%);
		border-radius: 0.8rem;
		box-shadow: 0 6px 16px rgb(0 94 71 / 6%);
	}

	.pr-enquire-num {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.2rem;
		height: 2.2rem;
		border-radius: 50%;
		background: var(--brand-deep);
		color: var(--color-white);
		font-family: var(--font-serif);
		font-size: 1.1rem;
		font-weight: 500;
		line-height: 1;
	}

	.pr-enquire-steps h3 {
		margin: 0 0 0.3rem;
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 1.05rem;
		color: var(--brand-deep);
	}

	.pr-enquire-steps p {
		margin: 0;
		line-height: 1.6;
		color: var(--ink-soft);
		font-size: 0.94rem;
	}

	.pr-enquire-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		justify-content: center;
		margin-bottom: 1.2rem;
	}

	.pr-enquire-fineprint {
		margin: 0;
		font-size: 0.86rem;
		line-height: 1.6;
		color: var(--ink-soft);
	}

	.pr-enquire-fineprint a {
		color: var(--brand);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* ---------- RESPONSIVE ---------- */
	@media (max-width: 900px) {
		.pr-single-row {
			grid-template-columns: 1fr;
