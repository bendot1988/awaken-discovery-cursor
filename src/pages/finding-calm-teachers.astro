---
import Layout from "../layouts/Layout.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { locations, navItems } from "../data/site";

const guideBullets = [
	"How to gently ground yourself in under 60 seconds (even between lessons when you've got 47 exercise books to mark and a parent email that's making your stomach churn)",
	"Simple body-aware techniques you can use in the classroom, the staffroom, or your car without anyone noticing",
	"Why your anxiety gets WORSE during the school holidays (and what to do about it)",
	"A gentle reflection space to notice what's actually happening in your body when the pressure builds (so you can spot the warning signs before you hit complete burnout)",
	'Personal "anchors" you can return to when you\'re in the middle of a challenging lesson, a difficult conversation, or another pointless meeting that could have been an email',
];

const journalBullets = [
	"Weekly reflection prompts that help you spot your anxiety triggers BEFORE you hit burnout (so you can actually do something about them)",
	"Space to track what's happening in your body, thoughts, and emotions across the school week (because Tuesday anxiety hits different than Friday anxiety)",
	'Tools to build your own personalised "survival toolkit" for the situations that drain you most',
	"Guided exercises to help you process the guilt, the frustration, and the constant feeling that you're not doing enough",
	"A structured way to figure out if you can make teaching sustainable... or if it's time to plan your exit strategy",
];

const methodologies = [
	{
		icon: "🌿",
		title: "Nervous-system first",
		body: "Practical regulation you can use between bells — not abstract advice when you're already on empty.",
	},
	{
		icon: "🍎",
		title: "Teacher-lived experience",
		body: "This work is informed by years in the classroom and what actually breaks people down term by term.",
	},
	{
		icon: "🤍",
		title: "Anxiety-informed therapy",
		body: "Clinical grounding in anxiety and burnout so you feel held, not \"fixed\" or judged for struggling.",
	},
];

const stats = [
	{ figure: "1 in 2", label: "UK teachers report symptoms of burnout each year" },
	{ figure: "< 60s", label: "to run the grounding techniques inside the guide" },
	{ figure: "100%", label: "free — no card, no upsell to download the guide" },
];

const symptoms = [
	"Lying awake at 3am running tomorrow's lessons in your head",
	"Crying in the car park before the first bell",
	"Snapping at the people you love because you've got nothing left",
	"Eating lunch over a photocopier (again)",
	"Sunday-night dread that starts on a Saturday afternoon",
	"Quietly googling \"can I afford to leave teaching\"",
];

const testimonialPlaceholders = [
	{
		quote:
			"Placeholder testimonial — a few lines from a teacher client about feeling less alone and more regulated day to day.",
		attrib: "Teacher client (anonymised)",
	},
	{
		quote:
			"Placeholder testimonial — short note on using grounding between lessons without anyone noticing.",
		attrib: "Primary teacher, anonymised",
	},
];

const faqs = [
	{
		q: "I don't have time for another wellbeing thing. Is this different?",
		a: "Yes. The techniques inside are 60 seconds or less and built to be used between lessons, in the car, or hiding in the stationery cupboard. No app, no membership, no homework.",
	},
	{
		q: "I'm not in crisis — is this still for me?",
		a: "Especially for you. The point of the guide is to notice the warning signs before you hit crisis. If you're already coping but white-knuckling it, this is exactly when it helps most.",
	},
	{
		q: "Will I end up on a sales list?",
		a: "You'll get the guide and a small number of follow-up emails from Ally with support for teachers. Unsubscribe in one click, any time.",
	},
];
---

<Layout
	title="Finding Calm in the Chaos | Free guide for teachers | Awaken Discovery"
	description="A free, body-aware guide for teachers who are overwhelmed, anxious, and running on empty — from counsellor and ex-teacher Ally."
>
	<SiteHeader navItems={navItems} />
	<main class="ldg">
		<!-- Hero -->
		<section class="ldg-section ldg-hero">
			<div class="ldg-hero-blob" aria-hidden="true"></div>
			<div class="ldg-hero-blob ldg-hero-blob-2" aria-hidden="true"></div>
			<div class="ldg-breathe" aria-hidden="true">
				<span></span><span></span><span></span>
			</div>
			<div class="container ldg-hero-grid">
				<div class="ldg-hero-copy">
					<p class="ldg-badge"><span class="ldg-badge-dot"></span> Free resource · for teachers</p>
					<h1 class="ldg-h1">
						Finding calm when the job feels <em>impossible</em>.
					</h1>
					<p class="ldg-script-accent">A Gentle Guide For Overwhelmed Teachers</p>
					<p class="ldg-lead">
						If you're lying awake at 3am dreading Monday, crying in your car before you walk into
						school, or fantasising about quitting but terrified you can't afford to — this page is
						for you.
					</p>
					<div class="ldg-hero-cta-row">
						<a class="cta cta-solid ldg-cta" href="#opt-in">Get the free guide</a>
						<a class="cta cta-outline ldg-cta" href="#guide">See what's inside</a>
					</div>
					<ul class="ldg-trust-row">
						<li>✓ Body-aware techniques</li>
						<li>✓ Written by an ex-teacher</li>
						<li>✓ Read in under 20 mins</li>
					</ul>
				</div>
				<div class="ldg-hero-media">
					<div class="ldg-placeholder ldg-placeholder-hero">
						<span class="ldg-ph-label">Image placeholder</span>
						<span class="ldg-ph-desc">
							Warm, natural-light portrait of Ally — sitting calmly in a sunlit therapy room or
							beside a window with a mug of tea. Soft greens, undefocused background. Editorial,
							not corporate.
						</span>
					</div>
					<div class="ldg-hero-stamp">
						<span class="ldg-stamp-script">Hi, I'm Ally</span>
						<span class="ldg-stamp-sub">Counsellor · ex-teacher</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Stat band -->
		<section class="ldg-statband">
			<div class="container ldg-stat-grid">
				{
					stats.map((s) => (
						<div class="ldg-stat">
							<span class="ldg-stat-figure">{s.figure}</span>
							<span class="ldg-stat-label">{s.label}</span>
						</div>
					))
				}
			</div>
			<div class="container ldg-logo-strip">
				<p class="ldg-logo-strip-label">Trusted by teachers from schools across the UK</p>
				<div class="ldg-logo-row">
					<div class="ldg-logo-ph">School / MAT logo</div>
					<div class="ldg-logo-ph">School / MAT logo</div>
					<div class="ldg-logo-ph">School / MAT logo</div>
					<div class="ldg-logo-ph">School / MAT logo</div>
					<div class="ldg-logo-ph">School / MAT logo</div>
				</div>
			</div>
		</section>

		<!-- Symptoms list (does this sound like you?) -->
		<section class="ldg-section ldg-surface">
			<div class="container ldg-symptom-split">
				<div class="ldg-symptom-intro">
					<p class="ldg-eyebrow">Does this sound familiar?</p>
					<h2 class="ldg-h2">The signs you're running on empty</h2>
					<p class="ldg-sub">
						If you're nodding at even half of these, you are not broken. You're carrying too much
						without enough support.
					</p>
					<p class="ldg-open-strong ldg-symptom-tag">
						My free guide will show you how to survive the rest of this term without completely
						falling apart.
					</p>
				</div>
				<ul class="ldg-symptom-grid">
					{symptoms.map((s) => (
						<li class="ldg-symptom">
							<span class="ldg-symptom-check" aria-hidden="true">✓</span>
							<span>{s}</span>
						</li>
					))}
				</ul>
			</div>
		</section>

		<!-- Truth (staff room background + white overlay) -->
		<section class="ldg-section ldg-truth-staffroom">
			<div class="container ldg-narrow">
				<p class="ldg-eyebrow">Here's the truth nobody in the staffroom is saying out loud</p>
				<p>
					You're not "not cut out for this." You're not weak. And you're definitely not the only one
					feeling this way.
				</p>
				<p>
					What you <em>are</em> is carrying an impossible load that gets heavier every single term…
					and your nervous system is screaming for relief.
				</p>
				<p>
					The Sunday night dread. The panic attacks in the stationery cupboard. The constant feeling
					that you're failing everyone — your students, your colleagues, the parents, yourself.
				</p>
				<blockquote class="ldg-pull-quote">
					<span class="ldg-pull-mark" aria-hidden="true">“</span>
					<p>Sound familiar?</p>
				</blockquote>
			</div>
		</section>

		<!-- Differentiator + image -->
		<section class="ldg-section">
			<div class="container ldg-split">
				<div>
					<p class="ldg-eyebrow">A different approach</p>
					<h2 class="ldg-h2">What makes this different</h2>
					<p>
						Most wellbeing programs tell you to "practice self-care." To do yoga. To set boundaries.
						To "just say no."
					</p>
					<p>
						I'm going to show you how to actually <strong>survive the day</strong> when you're
						already running on empty.
					</p>
					<p>
						Because here's what I discovered after leaving teaching myself: the anxiety you're
						feeling isn't because you're doing something wrong. It's because your body is trying to
						protect you from a system that's broken.
					</p>
					<p>
						Until you learn to work <em>with</em> your nervous system instead of pushing through and
						ignoring it, no amount of bubble baths or mindfulness apps will give you lasting relief.
					</p>
				</div>
				<div class="ldg-placeholder ldg-placeholder-tall">
					<span class="ldg-ph-label">Image placeholder</span>
					<span class="ldg-ph-desc">
						Quiet detail shot — hands cradling a mug, an open notebook, a houseplant by a window.
						Suggests pause, breathing space. No people front-on.
					</span>
				</div>
			</div>
		</section>

		<!-- Methodology + testimonials -->
		<section class="ldg-section ldg-soft">
			<div class="container">
				<div class="ldg-section-head ldg-center">
					<p class="ldg-eyebrow">How I work</p>
					<h2 class="ldg-h2">Three pillars behind every session</h2>
					<p class="ldg-sub">So you know what you're getting before you read another word.</p>
				</div>
				<div class="ldg-method-grid">
					{
						methodologies.map((m) => (
							<article class="ldg-method-card">
								<div class="ldg-method-icon" aria-hidden="true">{m.icon}</div>
								<h3>{m.title}</h3>
								<p>{m.body}</p>
							</article>
						))
					}
				</div>
				<div class="ldg-quote-grid">
					{
						testimonialPlaceholders.map((t) => (
							<blockquote class="ldg-quote">
								<div class="ldg-quote-avatar" aria-hidden="true">
									<span class="ldg-ph-mini">Avatar placeholder</span>
								</div>
								<div>
									<p>“{t.quote}”</p>
									<footer>— {t.attrib}</footer>
								</div>
							</blockquote>
						))
					}
				</div>
			</div>
		</section>

		<!-- Meet Ally — merged bio + lived experience -->
		<section class="ldg-section" id="about">
			<div class="container ldg-split ldg-split-reverse ldg-bio-split">
				<div class="ldg-bio-media">
					<div class="ldg-placeholder ldg-placeholder-portrait">
						<span class="ldg-ph-label">Portrait placeholder</span>
						<span class="ldg-ph-desc">
							Vertical portrait of Ally — outdoors or near a window. Soft, approachable, eye
							contact with camera. Same colour palette as the hero shot.
						</span>
					</div>
					<ul class="ldg-credentials">
						<li>BACP-registered <span class="ldg-cred-note">(placeholder)</span></li>
						<li>Anxiety-informed</li>
						<li>10+ yrs in UK classrooms</li>
					</ul>
				</div>
				<div>
					<p class="ldg-eyebrow">Meet Ally</p>
					<h2 class="ldg-h2">I know this because I lived it</h2>
					<p class="ldg-bio-lede">
						I'm a counsellor, psychotherapist, and wellbeing educator — but more importantly,
						<strong>I'm an ex-teacher who gets it.</strong>
					</p>
					<p>
						I was the exhausted teacher who loved the kids but couldn't take one more data
						meeting, one more observation, one more initiative that added to the workload without
						taking anything away. I left the profession because it was literally destroying my
						health.
					</p>
					<p>
						In the years since, I've trained as a counsellor specialising in anxiety and burnout —
						and I've worked with dozens of teachers just like you:
					</p>
					<ul class="ldg-list">
						<li>Teachers desperately trying to hold it together.</li>
						<li>Teachers who feel guilty for struggling when they "should" be grateful to have a job.</li>
						<li>Teachers terrified they're going to have a breakdown in front of their Year 9s.</li>
					</ul>
					<p>
						I now work with individuals online, by telephone, and face-to-face from peaceful
						therapy rooms in Market Weighton, East Yorkshire — with a gentle, body-aware approach
						that works when you're already running on empty.
					</p>
					<p><strong>That's why I created this free guide specifically for teachers.</strong></p>
				</div>
			</div>
		</section>

		<!-- Guide title + bullets -->
		<section class="ldg-section ldg-accent-band" id="guide">
			<div class="ldg-accent-shape" aria-hidden="true"></div>
			<div class="container">
				<div class="ldg-guide-head">
					<p class="ldg-script-accent ldg-center">Grab Your Free Guide</p>
					<h2 class="ldg-h2 ldg-center ldg-guide-title">
						Finding Calm In The Chaos
					</h2>
					<p class="ldg-center ldg-guide-subtitle">
						A Teacher's Guide to Grounding Yourself When You're Already Overwhelmed
					</p>
				</div>
				<div class="ldg-guide-shell">
					<div class="ldg-placeholder ldg-placeholder-cover">
						<span class="ldg-ph-label">Guide cover placeholder</span>
						<span class="ldg-ph-desc">
							Mock-up of the PDF cover — front cover at a slight angle, soft drop shadow, on a
							neutral surface. Title, subtitle, Awaken Discovery wordmark.
						</span>
					</div>
					<div>
						<p class="ldg-eyebrow">Inside, you'll discover:</p>
						<ul class="ldg-bullet-grid">
							{guideBullets.map((line) => <li>{line}</li>)}
						</ul>
						<p class="ldg-muted ldg-guide-foot">
							This isn't about "fixing" you or making you a "better teacher." This is about
							helping you survive the system without sacrificing your mental health.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Steps + opt-in -->
		<section class="ldg-section ldg-soft" id="opt-in">
			<div class="container ldg-narrow">
				<div class="ldg-section-head ldg-center">
					<p class="ldg-eyebrow">Next steps</p>
					<h2 class="ldg-h2">Here's what happens next</h2>
				</div>
				<ol class="ldg-steps">
					<li>
						<span class="ldg-step-num">1</span>
						<div>
							<strong>Enter your email below</strong>
							<p>And grab your free guide — straight to your inbox.</p>
						</div>
					</li>
					<li>
						<span class="ldg-step-num">2</span>
						<div>
							<strong>Try the techniques during your next difficult day</strong>
							<p>They take less than 60 seconds each.</p>
						</div>
					</li>
					<li>
						<span class="ldg-step-num">3</span>
						<div>
							<strong>Notice what feels different</strong>
							<p>When you're not constantly fighting your own nervous system.</p>
						</div>
					</li>
				</ol>
				<div class="ldg-form-card">
					<p class="ldg-form-title">Yes — send me the free guide now</p>
					<form class="ldg-form" id="guide-form" action="#" method="post">
						<label class="ldg-label">
							<span>Email</span>
							<input type="email" name="email" required placeholder="you@school.org.uk" autocomplete="email" />
						</label>
						<button type="submit" class="cta cta-solid ldg-form-btn">Send me the guide</button>
					</form>
					<p class="ldg-form-note">
						We'll never share your email. Unsubscribe any time.
						<br /><em>(Placeholder form — hook up to your ESP later.)</em>
					</p>
				</div>
				<p>
					You don't need to keep white-knuckling your way through every term. You don't need to wait
					until half-term to breathe again. You don't need to choose between your career and your
					sanity.
				</p>
				<p><strong>Download the guide. Give yourself this moment.</strong></p>
				<p>You deserve to feel calm again… even in the middle of the chaos.</p>
				<p class="ldg-signoff"><span class="ldg-signoff-script">— Ally</span></p>
				<p class="ldg-ps">
					<strong>P.S.</strong> You became a teacher because you wanted to make a difference. But you
					can't pour from an empty cup. Let me help you find your way back to yourself… so you can
					keep doing the work you love without it destroying you.
				</p>
			</div>
		</section>

		<!-- FAQ -->
		<section class="ldg-section ldg-soft">
			<div class="container ldg-narrow">
				<div class="ldg-section-head ldg-center">
					<p class="ldg-eyebrow">Questions</p>
					<h2 class="ldg-h2">Before you download…</h2>
				</div>
				<div class="ldg-faqs">
					{
						faqs.map((f) => (
							<details class="ldg-faq">
								<summary>
									<span>{f.q}</span>
									<span class="ldg-faq-icon" aria-hidden="true">+</span>
								</summary>
								<p>{f.a}</p>
							</details>
						))
					}
				</div>
			</div>
		</section>

		<!-- Scroll continuation: thank you + journal -->
		<div class="ldg-divider" aria-hidden="true"></div>

		<section class="ldg-section ldg-surface" id="thank-you">
			<div class="container ldg-narrow">
				<p class="ldg-script-accent ldg-center">Thank You</p>
				<h2 class="ldg-h2 ldg-center">Your guide is on its way…</h2>
				<p>
					Check your email in the next few minutes for "Finding Calm In The Chaos — A Teacher's
					Guide to Grounding Yourself When You're Already Overwhelmed."
				</p>
				<p class="ldg-muted">
					(If you don't see it, check your spam folder. The last thing you need is another thing
					going missing.)
				</p>
				<p class="ldg-eyebrow">But before you go back to marking…</p>
				<p>
					Can I be brutally honest with you for a second? That guide you just downloaded? It's going
					to help you get through the next few weeks. It really is.
				</p>
				<p>
					But here's what I've noticed after working with dozens of teachers struggling with anxiety
					and burnout: the ones who actually <em>change</em> their situation — the ones who aren't
					still drowning six months from now — they do one thing differently.
				</p>
				<p><strong>They start noticing the patterns before they hit crisis point.</strong></p>
				<p>
					You push through September. You survive October. You white-knuckle your way to half-term.
					Then you collapse for a week, feel slightly better, and go back in thinking "this term
					will be different." But it never is — because you never stopped to notice what's actually
					triggering your anxiety.
				</p>
				<p>
					Is it certain classes? Certain times of day? Certain types of meetings or interactions? Is
					it the workload? The behaviour management? The constant feeling that you're being judged?
				</p>
				<blockquote class="ldg-pull-quote">
					<span class="ldg-pull-mark" aria-hidden="true">“</span>
					<p>You can't fix what you can't see.</p>
				</blockquote>
			</div>
		</section>

		<section class="ldg-section">
			<div class="container ldg-split ldg-journal-split">
				<div>
					<p class="ldg-eyebrow">The next step</p>
					<h2 class="ldg-h2">That's where the Teacher's Anxiety Reflection Journal comes in</h2>
					<p>
						This isn't some generic journal with blank pages and vague prompts about gratitude.
						It's specifically designed for teachers who are trying to survive an impossible job
						without losing themselves completely.
					</p>
					<p><strong>Inside the journal, you'll get:</strong></p>
					<ul class="ldg-list">
						{journalBullets.map((line) => <li>{line}</li>)}
					</ul>
					<p>
						Sometimes the answer isn't "better self-care." Sometimes the answer is "this job is
						incompatible with my mental health." And that's okay — but you need to make that
						decision from a place of clarity, not from a place of crisis. The journal helps you get
						that clarity.
					</p>
				</div>
				<div class="ldg-journal-media">
					<div class="ldg-placeholder ldg-placeholder-tall">
						<span class="ldg-ph-label">Image placeholder</span>
						<span class="ldg-ph-desc">
							Flat-lay of the journal — open page, pen resting across, mug nearby, soft natural
							light. Or a mocked-up cover beside fresh stationery.
						</span>
					</div>
					<div class="ldg-price-card">
						<p class="ldg-price-name"><strong>Teacher's Anxiety Reflection Journal</strong></p>
						<p class="ldg-price-row">
							<span class="ldg-strike">Normally [PRICE]</span>
							<span class="ldg-highlight">Today [DISCOUNTED PRICE]</span>
						</p>
						<p class="ldg-price-deadline">[X]% off until [DEADLINE]</p>
						<div class="ldg-btn-row">
							<a class="cta cta-solid" href="#opt-in">Yes — I want the journal</a>
							<a class="cta cta-outline" href="/#contact">Questions? Contact Ally</a>
						</div>
					</div>
					<p class="ldg-muted ldg-journal-note">
						Replace [PRICE], [DISCOUNTED PRICE], [X]%, and [DEADLINE] when you're ready to sell.
					</p>
				</div>
			</div>
		</section>

		<section class="ldg-section ldg-surface ldg-final">
			<div class="container ldg-narrow ldg-center-narrow">
				<figure class="ldg-ally-circle">
					<img
						src="/assets/images/hero-ally.jpeg"
						alt="Ally — counsellor, psychotherapist, and ex-teacher"
						width="180"
						height="180"
						loading="lazy"
					/>
				</figure>
				<p class="ldg-script-accent ldg-center">A Final Note From Me</p>
				<p>
					What would it be worth to actually understand what's draining you — instead of just
					surviving term to term? To have a system that helps you spot the warning signs before
					you're crying in your car again? To finally figure out if you can make this work — or if
					it's time to start planning your escape route?
				</p>
				<p>The journal gives you that. You can work through it at your own pace.</p>
				<div class="ldg-btn-row ldg-center-btns">
					<a class="cta cta-solid" href="#opt-in">Claim your journal — [X]% off for teachers</a>
				</div>
				<p>
					Or, if you're not ready yet, that's okay too. You've got the free guide. Start there. I'll
					be in your inbox soon with more support specifically for teachers.
				</p>
				<p><strong>Take care of yourself. (I mean it.)</strong></p>
				<p class="ldg-signoff"><span class="ldg-signoff-script">— Ally</span></p>
				<p class="ldg-ps">
					<strong>P.S.</strong> This discount expires [DEADLINE]. After that, the journal goes back
					to full price. If you think you might want it, grab it now while it's [X]% off.
				</p>
				<div class="ldg-btn-row ldg-center-btns">
