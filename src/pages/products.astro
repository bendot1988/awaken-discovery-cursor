---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import JournalCheckout from "../components/JournalCheckout.astro";
import GuideSignupDialog from "../components/GuideSignupDialog.astro";
import { locations, navItems } from "../data/site";
import {
	amazonTherapyJournalForCouplesUrl,
	anxietyReflectionJournal,
	groundedWellnessAffiliateUrl,
	teacherRealignmentSystem,
} from "../data/products";
import { sundayResetBookingUrl } from "../data/site";

---

<Layout
	title="Wellbeing Products · Awaken Discovery"
	description="Therapy journals and wellbeing tools from Awaken Discovery — couples journal on Amazon UK, anxiety journal PDF and teacher resources."
>
	<SiteHeader navItems={navItems} />
	<main class="products-page">
		<section class="products-hero section">
			<div class="container products-hero-inner">
				<p class="section-kicker">Wellbeing Products</p>
				<h1>Journals and resources for emotional wellbeing between sessions.</h1>
				<p>
					Awaken Discovery resources are designed to support reflection,
					connection and gentle emotional awareness — whether used independently
					or alongside therapy.
				</p>
			</div>
		</section>

		<section class="featured-product section section-soft">
			<div class="container featured-grid">
				<div class="product-media">
					<video
						src="/assets/videos/therapy-journal-for-couples.mp4"
						controls
						preload="metadata"
						playsinline
						aria-label="Preview of the Therapy Journal for Couples"
					></video>
				</div>

				<div class="product-copy">
					<p class="section-kicker">Available now</p>
					<h2>Therapy Journal for Couples</h2>
					<p class="product-lede">
						A 52-week journal designed for couples to collaboratively track
						their individual and shared emotional wellbeing.
					</p>
					<p>
						This journal can be used daily or weekly as a gentle way to notice
						the progress of your relationship over time. Throughout the journal,
						thoughtful prompts and questions support self-reflection, shared
						discussion and deeper connection.
					</p>
					<p>
						Whether used on its own or alongside therapy, it offers a supportive
						companion for couples who want to nurture their relationship with
						more care, awareness and emotional honesty.
					</p>
					<div class="product-actions">
						<a
							class="cta cta-solid"
							href={amazonTherapyJournalForCouplesUrl}
							target="_blank"
							rel="noopener noreferrer"
						>
							Available on Amazon
						</a>
						<a class="cta cta-outline" href="/therapy#choose-couples">Explore Couples Therapy</a>
					</div>
					<p class="product-note">
						This product is sold via Amazon and opens in a new tab.
					</p>
				</div>
			</div>
		</section>

		<section class="featured-product section" id="anxiety-reflection-journal">
			<div class="container featured-grid featured-grid-reverse">
				<div class="product-media product-media-static">
					<img
						src="/assets/images/finding-calm-journal.png"
						alt="Closed 'Finding Calm' reflection journal standing on a wooden table"
						loading="lazy"
						decoding="async"
					/>
				</div>

				<div class="product-copy">
					<p class="section-kicker">Available now</p>
					<h2>Anxiety Reflection Journal</h2>
					<p class="product-lede">
						A guided PDF journal to help you notice patterns, track emotional
						wellbeing and build a personal calming toolkit.
					</p>
					<p>
						Think of it as the natural next step after the free <em>Finding Calm</em> guide — a structured space to understand <em>your</em> anxiety in <em>your</em> body, not generic advice.
					</p>
					<p class="product-price">
						<strong>{anxietyReflectionJournal.priceGbp}</strong>
						{" "}
						<span class="product-price-alt">(available internationally)</span>
					</p>
					<div class="product-actions">
						<JournalCheckout
							product={anxietyReflectionJournal}
							buttonLabel="Buy the PDF Journal"
							dialogId="journal-checkout-dialog-anxiety"
							fallbackLabel="Request the PDF Journal"
						/>
						<GuideSignupDialog
							list="anxiety-guide"
							dialogId="guide-signup-dialog-anxiety"
							title="Finding Calm — free anxiety guide"
							lede="A simple guide to grounding yourself during anxiety. Enter your email and the PDF will arrive shortly."
							buttonLabel="Send Me the Free Guide"
							pageLocation="Products · Anxiety Reflection Journal · Free Finding Calm guide"
						/>
					</div>
					<p class="product-note">
						Digital PDF download · secure checkout via Stripe. A printed edition
						is planned — you'll be able to choose either format when it's ready.
					</p>
				</div>
			</div>
		</section>

		<section class="featured-product section" id="teacher-realignment-system">
			<div class="container featured-grid">
				<div class="product-media product-media-static">
					<img
						src="/assets/images/teacher-realignment-system-mockup.png"
						alt="The Teacher Realignment System — guided PDF workbook for teachers on a neutral surface"
						loading="lazy"
						decoding="async"
					/>
				</div>

				<div class="product-copy">
					<p class="section-kicker">Available now</p>
					<h2>The Teacher Realignment System</h2>
					<p class="product-lede">
						A guided PDF workbook for teachers who struggle to switch off, carry
						school home, or feel overwhelmed by the emotional demands of teaching.
					</p>
					<p>
						Designed to help you clear mental overload, calm a busy mind,
						reconnect with your body, and create practical moments of wellbeing
						throughout your day.
					</p>
					<p>
						Created by a qualified counsellor and former teacher with 23 years of
						experience in education.
					</p>
					<p class="product-price">
						<strong>{teacherRealignmentSystem.priceGbp}</strong>
						{" "}
						<span class="product-price-alt">(available internationally)</span>
					</p>
					<div class="product-actions">
						<JournalCheckout
							product={teacherRealignmentSystem}
							buttonLabel="Download The Teacher Realignment System"
							dialogId="journal-checkout-dialog-teacher"
							fallbackLabel="Download The Teacher Realignment System"
						/>
						<GuideSignupDialog
							list="teachers-guide"
							dialogId="guide-signup-dialog-teachers"
							title="Why You Can't Switch Off — free teacher guide"
							lede="Gentle grounding tools for teachers. Enter your email and the free PDF will arrive shortly."
							buttonLabel="Send Me the Free Guide"
							pageLocation="Products · Teacher Realignment System · Free teacher guide"
						/>
					</div>
					<p class="product-note">
						Digital PDF download · secure checkout via Stripe.
					</p>
				</div>
			</div>
		</section>

		<section class="affiliate-band section section-soft">
			<div class="container affiliate-inner">
				<div class="affiliate-copy">
					<p class="section-kicker">Partner recommendation</p>
					<h2>My Grounded Wellness Link</h2>
					<p>
						Alongside my own resources, I sometimes recommend products from
						Grounded Wellness — gentle wellbeing tools I trust and use myself.
					</p>
					<a
						class="cta cta-outline"
						href={groundedWellnessAffiliateUrl}
						target="_blank"
						rel="noopener noreferrer sponsored"
					>
						Visit Grounded Wellness
					</a>
				</div>

				<a
					class="affiliate-preview"
					href={groundedWellnessAffiliateUrl}
					target="_blank"
					rel="noopener noreferrer sponsored"
					aria-label="Visit Grounded Wellness (opens in a new tab)"
				>
					<span class="affiliate-preview-frame" aria-hidden="true">
						<span class="affiliate-preview-chrome">
							<span class="affiliate-dot"></span>
							<span class="affiliate-dot"></span>
							<span class="affiliate-dot"></span>
							<span class="affiliate-preview-url">groundedwellness.co.uk</span>
						</span>
						<img
							src="/assets/images/grounded-wellness-preview.jpg"
							alt="Grounded Wellness website — Summer Wellness Sale with grounding and wellbeing products"
							width="960"
							height="501"
							loading="lazy"
							decoding="async"
						/>
					</span>
				</a>
			</div>
		</section>

		<section class="featured-product section section-soft" id="sunday-reset">
			<div class="container sunday-reset-block">
				<p class="section-kicker">Group wellbeing · Available now</p>
				<h2>Sunday Reset for Teachers</h2>
				<p class="product-lede">
					A gentle online workshop on the last Sunday of every month — practical
					tools to decompress, settle Sunday anxiety and begin the week feeling
					calmer.
				</p>
				<p>
					Listen, reflect and take away what feels helpful. No expectation to
					speak or share. Includes a downloadable Sunday Reset Guide.
				</p>
				<p class="product-price">
					<strong>£25</strong>
					{" "}
					<span class="product-price-alt">per person · Online via Zoom</span>
				</p>
				<div class="product-actions">
					<a class="cta cta-solid" href="/sunday-reset">Learn more</a>
					<a
						class="cta cta-outline"
						href={sundayResetBookingUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						Book your place
					</a>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter
		locations={locations}
		tagline="Journals, guides and emotional wellbeing tools to support reflection, connection and calm."
	/>
</Layout>

<style>
	.products-page {
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		--ink-soft: rgb(29 35 39 / 78%);
		color: var(--color-dark-gray);
	}

	.products-hero {
		background: linear-gradient(180deg, var(--color-white) 0%, var(--brand-tint) 100%);
		padding-top: 4rem;
	}

	.products-hero-inner {
		max-width: 760px;
	}

	.section-kicker {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--brand);
	}

	h1,
	h2,
	h3 {
		font-family: var(--font-serif);
		font-weight: 500;
		color: var(--brand-deep);
		text-wrap: balance;
	}

	h1 {
		margin: 0.6rem 0 1rem;
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		line-height: 1.12;
	}

	h2 {
		margin: 0.55rem 0 1rem;
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
		line-height: 1.18;
	}

	h3 {
		margin: 0.3rem 0 0.55rem;
		font-size: 1.35rem;
		line-height: 1.25;
	}

	.product-copy p,
	.products-section-head p,
	.sunday-reset-block p,
	.affiliate-inner p {
		line-height: 1.75;
	}

	.products-hero p {
		margin: 0;
		max-width: 60ch;
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		line-height: 1.7;
		color: var(--ink-soft);
	}

	.product-copy p,
	.products-section-head p,
	.affiliate-inner p {
		max-width: 62ch;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		gap: clamp(2rem, 4vw, 4rem);
		align-items: center;
	}

	.featured-grid-reverse {
		direction: rtl;
	}

	.featured-grid-reverse > * {
		direction: ltr;
	}

	.product-media {
		background: var(--color-white);
		border: 1px solid rgb(0 94 71 / 14%);
		border-radius: 1.1rem;
		box-shadow: 0 18px 42px rgb(0 94 71 / 12%);
		overflow: hidden;
	}

	.product-media video,
	.product-media img {
		width: 100%;
		display: block;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		background: #e8efea;
	}

	.product-copy {
		max-width: 62ch;
	}

	.product-lede {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.15rem;
		color: var(--brand);
	}

	.product-price {
		margin: 0.2rem 0 0.4rem;
		font-size: 1.15rem;
		color: var(--brand-deep);
	}

	.product-price-alt {
		margin-left: 0.15em;
		font-size: 0.92rem;
		font-weight: 400;
		color: var(--ink-soft);
	}

	.product-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.4rem;
	}

	.product-note {
		margin: 1rem 0 0;
		font-size: 0.82rem;
		color: var(--ink-soft);
	}

	.affiliate-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		gap: clamp(1.5rem, 4vw, 2.75rem);
		align-items: center;
		padding: clamp(1.4rem, 3vw, 2rem);
		background:
			radial-gradient(ellipse 70% 80% at 100% 0%, rgb(0 94 71 / 7%), transparent 55%),
			var(--color-white);
		border: 1px solid rgb(0 94 71 / 16%);
		border-left: 4px solid var(--brand);
		border-radius: 1.1rem;
		box-shadow: 0 12px 28px rgb(0 94 71 / 8%);
		overflow: hidden;
	}

	.affiliate-copy {
		display: grid;
		gap: 0.85rem;
		justify-items: start;
	}

	.affiliate-copy h2,
	.affiliate-copy p {
		margin: 0;
	}

	.affiliate-copy p {
		color: var(--ink-soft);
		line-height: 1.7;
		max-width: 38ch;
	}

	.affiliate-preview {
		display: block;
		justify-self: end;
		width: min(100%, 28rem);
		text-decoration: none;
	}

	.affiliate-preview-frame {
		display: block;
		border-radius: 0.85rem;
		overflow: hidden;
		background: #1d2327;
		border: 1px solid rgb(0 94 71 / 18%);
		box-shadow:
			0 18px 40px rgb(29 35 39 / 16%),
			0 4px 12px rgb(0 94 71 / 10%);
		transform: rotate(1.5deg);
		transition: transform 0.35s ease, box-shadow 0.35s ease;
	}

	.affiliate-preview:hover .affiliate-preview-frame,
	.affiliate-preview:focus-visible .affiliate-preview-frame {
		transform: rotate(0deg) translateY(-4px);
		box-shadow:
			0 24px 48px rgb(29 35 39 / 18%),
			0 8px 18px rgb(0 94 71 / 12%);
	}

	.affiliate-preview:focus-visible {
		outline: none;
	}

	.affiliate-preview-chrome {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.55rem 0.75rem;
		background: linear-gradient(180deg, #2a3136 0%, #1d2327 100%);
	}

	.affiliate-dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 999px;
		background: #5c656b;
	}

	.affiliate-dot:nth-child(1) {
		background: #e27c6a;
	}

	.affiliate-dot:nth-child(2) {
		background: #e0b45a;
	}

	.affiliate-dot:nth-child(3) {
		background: #6ea87a;
	}

	.affiliate-preview-url {
		margin-left: 0.55rem;
		flex: 1;
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		background: rgb(255 255 255 / 8%);
		color: rgb(255 255 255 / 62%);
		font-size: 0.68rem;
		letter-spacing: 0.02em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.affiliate-preview img {
		width: 100%;
		height: auto;
		display: block;
		aspect-ratio: 960 / 501;
		object-fit: cover;
		object-position: top center;
	}

	.products-section-head {
		max-width: 680px;
		margin-bottom: 2rem;
	}

	.sunday-reset-block {
		max-width: 760px;
	}

	.sunday-reset-block .product-lede,
	.sunday-reset-block > p {
		max-width: 60ch;
	}

	@media (max-width: 1024px) {
		.featured-grid {
			grid-template-columns: 1fr;
		}

		.featured-grid-reverse {
			direction: ltr;
		}

		.affiliate-inner {
			grid-template-columns: 1fr;
		}

		.affiliate-preview {
			justify-self: stretch;
			width: 100%;
			max-width: 26rem;
			margin-inline: auto;
		}

		.affiliate-preview-frame {
			transform: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.affiliate-preview-frame,
		.affiliate-preview:hover .affiliate-preview-frame,
		.affiliate-preview:focus-visible .affiliate-preview-frame {
			transition: none;
			transform: none;
		}
	}
</style>
