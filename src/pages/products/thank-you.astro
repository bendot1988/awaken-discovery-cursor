---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { locations, navItems } from "../../data/site";
import {
	anxietyReflectionJournal,
	teacherRealignmentSystem,
} from "../../data/products";

/**
 * Static build can't read ?product= at request time, so all variants are
 * rendered and a tiny inline script reveals the matching one.
 */
const variants = [
	{
		key: "teacher",
		heading: "Your Teacher Realignment System is on its way",
		productName: teacherRealignmentSystem.title,
		lede: "Payment received. We’re emailing your PDF to the address you used at checkout — usually within a minute or two.",
	},
	{
		key: "anxiety",
		heading: "Your Anxiety Reflection Journal is on its way",
		productName: anxietyReflectionJournal.title,
		lede: "Payment received. We’re emailing your PDF to the address you used at checkout — usually within a minute or two.",
	},
	{
		key: "default",
		heading: "Thank you — your download is on its way",
		productName: "your PDF",
		lede: "Payment received. We’re emailing your file to the address you used at checkout — usually within a minute or two.",
	},
];
---

<Layout
	title="Thank You · Awaken Discovery"
	description="Your purchase is confirmed — check your email for your PDF download."
	noindex={true}
>
	<SiteHeader navItems={navItems} />
	<main class="pt-page">
		<section class="pt-hero">
			<div class="container pt-hero-inner" data-product-thanks>
				{
					variants.map((copy) => (
						<div
							class="pt-variant"
							data-product={copy.key}
							hidden={copy.key !== "default"}
						>
							<p class="pt-eyebrow">Purchase confirmed</p>
							<h1>{copy.heading}</h1>
							<p class="pt-lede">{copy.lede}</p>
							<p class="pt-copy">
								Look for an email from Awaken Discovery with{" "}
								<strong>{copy.productName}</strong> attached. If it isn’t
								there within a few minutes, check spam/junk — and mark it as
								not spam so future messages get through.
							</p>
							<p class="pt-aside">
								Keep your Stripe receipt for your records. If anything looks
								wrong, <a href="/contact">email Ally</a> and she’ll sort it
								quickly.
							</p>
						</div>
					))
				}
				<div class="pt-actions">
					<a class="cta cta-solid" href="/products">Back to products</a>
					<a class="cta cta-outline" href="/contact">Contact Ally</a>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter
		locations={locations}
		tagline="Gentle tools for teachers, anxiety, and everyday overwhelm."
	/>
</Layout>

<script is:inline>
	(function () {
		var root = document.querySelector("[data-product-thanks]");
		if (!root) return;
		var param = new URLSearchParams(window.location.search)
			.get("product")
			?.trim()
			.toLowerCase();
		var variants = root.querySelectorAll("[data-product]");
		var matched = false;
		variants.forEach(function (el) {
			var isMatch = el.getAttribute("data-product") === param;
			el.hidden = !isMatch;
			if (isMatch) matched = true;
		});
		if (!matched) {
			var fallback = root.querySelector('[data-product="default"]');
			if (fallback) fallback.hidden = false;
		}
	})();
</script>

<style>
	.pt-page {
		--ink: var(--color-dark-gray);
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--cream: #fbf9f5;
		--cream-deep: #f3eee5;
		color: var(--ink);
		background: var(--cream);
	}

	.pt-hero {
		padding-block: clamp(3.5rem, 10vh, 7rem) clamp(4rem, 12vh, 8rem);
		background: linear-gradient(180deg, var(--cream) 0%, var(--cream-deep) 100%);
	}

	.pt-hero-inner {
		max-width: 40rem;
	}

	.pt-eyebrow {
		margin: 0;
		font-family: var(--font-body);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--brand);
	}

	.pt-hero h1 {
		margin: 0.7rem 0 0;
		font-family: var(--font-serif);
		font-size: clamp(2.1rem, 4.6vw, 3.15rem);
		font-weight: 500;
		line-height: 1.16;
		color: var(--ink);
	}

	.pt-lede {
		margin: 1.15rem 0 0;
		font-family: var(--font-body);
		font-size: 1.12rem;
		line-height: 1.7;
		color: var(--ink);
	}

	.pt-copy {
		margin: 1rem 0 0;
		font-family: var(--font-body);
		font-size: 1.05rem;
		line-height: 1.7;
		color: #3d474c;
	}

	.pt-copy strong {
		color: var(--brand-deep);
		font-weight: 600;
	}

	.pt-aside {
		margin: 1.15rem 0 0;
		font-family: var(--font-body);
		font-size: 0.98rem;
		font-style: italic;
		line-height: 1.65;
		color: #5b656b;
	}

	.pt-aside a {
		color: var(--brand-deep);
		font-style: normal;
		font-weight: 500;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.pt-aside a:hover {
		color: var(--brand);
	}

	.pt-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}

	.pt-page :global(.cta) {
		font-size: 1rem;
		padding: 0.9rem 1.4rem;
	}
</style>
