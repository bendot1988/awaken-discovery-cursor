---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { locations, navItems, sundayResetBookingUrl } from "../data/site";
import stoolInClearing from "../assets/teachers/stool-in-clearing.jpg";
import handPickingBook from "../assets/teachers/hand-picking-book.jpg";

const explore = [
	"Why overwhelm happens and how it affects both mind and body.",
	"How the nervous system responds to stress and why switching off can feel so difficult.",
	"Practical grounding, breathing and calming techniques to help regulate your nervous system.",
	"Simple wellbeing strategies that you can continue using throughout the school week.",
];

const whoFor = [
	"Find it difficult to switch off after work.",
	"Experience Sunday evening anxiety or dread.",
	"Feel mentally or emotionally overwhelmed.",
	"Want practical wellbeing tools they can use in everyday life.",
	"Would like to begin the week feeling calmer and more grounded.",
];

const youReceive = [
	"A live online workshop held on the last Sunday of every month",
	"A downloadable Sunday Reset Guide",
	"Practical tools and techniques to support your wellbeing",
	"A calm, supportive space to pause before the week begins",
];
---

<Layout
	title="Sunday Reset for Teachers · Awaken Discovery"
	description="A gentle £25 online wellbeing workshop for teachers — practical tools to decompress, settle Sunday anxiety and begin the week feeling calmer."
>
	<SiteHeader navItems={navItems} />
	<main>
		<!-- ============== HERO ============== -->
		<section class="sr-hero section">
			<div class="container hero-grid">
				<div class="hero-shell">
					<p class="eyebrow">Group wellbeing · For teachers</p>
					<h1>The Sunday Reset for Teachers</h1>
					<p class="subheadline">
						A gentle online workshop to help you reconnect before the week begins.
					</p>
					<p class="subheadline">
						Not about becoming more productive or trying harder — about giving
						yourself permission to slow down, reconnect with yourself and begin
						the week feeling calmer, steadier and more prepared.
					</p>
					<div class="price-pill" aria-label="Workshop details">
						<span class="price-pill-amount">£25</span>
						<span class="price-pill-meta">
							per person · Online via Zoom · Last Sunday of every month
						</span>
					</div>
					<div class="cta-row">
						<a
							class="cta cta-solid"
							href={sundayResetBookingUrl}
							target="_blank"
							rel="noopener noreferrer"
						>
							Book your place
						</a>
						<a class="cta cta-outline" href="#about">Explore the workshop</a>
					</div>
					<ul class="trust-strip" aria-label="Workshop details">
						<li>✔ Live online each month</li>
						<li>✔ Downloadable Reset Guide</li>
						<li>✔ No pressure to speak or share</li>
					</ul>
				</div>
				<figure class="hero-media">
					<img
						src="/assets/images/ally-writing-journal.jpg"
						alt="Ally — counsellor and ex-teacher — writing reflectively at her desk"
						width="682"
						height="1024"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
				</figure>
			</div>
		</section>

		<!-- ============== STORY / ZIGZAG ============== -->
		<section class="sr-story section" id="about">
			<div class="container">
				<header class="sr-head">
					<p class="section-kicker">Why it exists</p>
					<h2>When Sunday already feels like Monday</h2>
				</header>

				<div class="sr-zigzag">
					<article class="sr-row">
						<figure class="sr-media">
							<img
								src="/assets/images/anxiety-mind-wont-switch-off.png"
								alt="A person sitting on the edge of a bed at night — restless, overthinking, unable to switch off"
								width="768"
								height="1024"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Even when your body feels tired, your mind may still be racing.</figcaption>
						</figure>
						<div class="sr-copy">
							<p class="sr-lede">Teaching asks so much of you.</p>
							<p>
								By Sunday evening, many teachers find themselves thinking ahead to
								Monday. Lesson plans, emails, classroom challenges and unfinished
								tasks can make it difficult to truly rest.
							</p>
							<p>
								The Sunday Reset for Teachers is a gentle online wellbeing workshop,
								held on the last Sunday of every month, offering you the opportunity
								to pause, understand what is happening within your mind and body, and
								learn practical ways to support your wellbeing before the week begins.
							</p>
							<p class="sr-pull">
								This is not about becoming more productive or trying harder.
							</p>
							<p>
								It is about giving yourself permission to slow down, reconnect with
								yourself and begin the week feeling calmer, steadier and more prepared.
							</p>
						</div>
					</article>

					<article class="sr-row sr-row-reverse">
						<figure class="sr-media">
							<img
								src="/assets/images/therapy-stones.png"
								alt="Smooth stones stacked in still water — a quiet moment of grounding"
								width="1024"
								height="1024"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>Practical tools for a quieter nervous system.</figcaption>
						</figure>
						<div class="sr-copy">
							<p class="section-kicker">During the workshop</p>
							<h3>We will explore</h3>
							<ul class="sr-list">
								{explore.map((item) => <li>{item}</li>)}
							</ul>
							<p>
								Throughout the session, you'll be invited to try some of the
								practical techniques for yourself, helping you discover what feels
								most supportive.
							</p>
							<p class="sr-emphasis">
								There is no expectation to speak, share personal experiences or
								participate interactively. You are welcome to simply listen, reflect
								and take away what feels helpful for you.
							</p>
						</div>
					</article>

					<article class="sr-row">
						<figure class="sr-media">
							<Image
								src={handPickingBook}
								alt="A hand gently lifting a book from a stack in a quiet woodland — choosing what to carry"
								widths={[420, 640, 860]}
								sizes="(max-width: 900px) 80vw, 420px"
								loading="lazy"
								decoding="async"
								format="webp"
								quality={80}
							/>
							<figcaption>For teachers who are tired of surviving the week.</figcaption>
						</figure>
						<div class="sr-copy">
							<p class="section-kicker">Who is this for?</p>
							<h3>This workshop is for teachers who:</h3>
							<ul class="sr-list">
								{whoFor.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					</article>

					<article class="sr-row sr-row-reverse">
						<figure class="sr-media">
							<img
								src="/assets/images/therapy-forest.png"
								alt="A quiet woodland path through soft green light — space to pause"
								width="1024"
								height="1024"
								loading="lazy"
								decoding="async"
							/>
							<figcaption>A calm, supportive space before the week begins.</figcaption>
						</figure>
						<div class="sr-copy">
							<p class="section-kicker">What you'll receive</p>
							<h3>Included every month</h3>
							<ul class="sr-list">
								{youReceive.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					</article>
				</div>
			</div>
		</section>

		<!-- ============== INVESTMENT ============== -->
		<section class="sr-invest section section-soft">
			<div class="container sr-invest-grid">
				<figure class="sr-invest-media">
					<Image
						src={stoolInClearing}
						alt="A wooden stool with books in a quiet woodland clearing — a place to set things down"
						widths={[420, 640, 860]}
						sizes="(max-width: 900px) 80vw, 400px"
						loading="lazy"
						decoding="async"
						format="webp"
						quality={80}
					/>
				</figure>
				<div class="sr-invest-copy">
					<p class="section-kicker">Investment</p>
					<h2>£25 per person</h2>
					<p>
						Held online via Zoom on the last Sunday of every month — a calm,
						supportive space to reset before the week begins.
					</p>
					<div class="cta-row">
						<a
							class="cta cta-solid"
							href={sundayResetBookingUrl}
							target="_blank"
							rel="noopener noreferrer"
						>
							Book your place
						</a>
						<a class="cta cta-outline" href="/contact">Get in touch</a>
					</div>
					<p class="sr-note" role="note">
						<strong>Please note.</strong> This is a psychoeducational wellbeing
						workshop designed to promote understanding and support emotional
						wellbeing. It is not therapy and is not a replacement for medical,
						mental health or crisis support. If you are struggling significantly,
						please seek appropriate professional support.
					</p>
				</div>
			</div>
		</section>

		<!-- ============== FINAL CTA ============== -->
		<section class="sr-final section">
			<div class="container sr-final-inner">
				<p class="section-kicker">Begin when you're ready</p>
				<h2>Give yourself a gentler start to the week</h2>
				<p>
					A small monthly pause — for the teachers who carry so much, and rarely
					put it down.
				</p>
				<div class="cta-row sr-final-actions">
					<a
						class="cta cta-solid"
						href={sundayResetBookingUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						Book your place — £25
					</a>
					<a class="cta cta-outline" href="/teachers">Back to Teacher Support</a>
				</div>
			</div>
		</section>
	</main>
	<SiteFooter
		locations={locations}
		tagline="Helping overwhelmed teachers reconnect with themselves beyond survival mode."
	/>
</Layout>

<style>
	main {
		--brand: var(--color-dark-slate-gray);
		--brand-deep: #004836;
		--brand-tint: rgb(0 94 71 / 8%);
		--ink-soft: rgb(29 35 39 / 78%);
	}

	/* ---------- HERO (mirrors Anxiety / Teachers) ---------- */
	.sr-hero {
		padding-block: clamp(3.5rem, 8vh, 6rem);
		background: linear-gradient(180deg, var(--color-white) 0%, #f6f8f6 100%);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: clamp(2rem, 4vw, 4rem);
		align-items: center;
	}

	.eyebrow,
	.section-kicker {
		margin: 0;
		color: var(--color-dark-slate-gray);
		font-weight: 600;
		letter-spacing: 0.08em;
		font-size: 0.8rem;
		text-transform: uppercase;
	}

	h1 {
		margin: 0.7rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(1.9rem, 4.4vw, 3.1rem);
		font-weight: 500;
		line-height: 1.16;
		text-wrap: balance;
		color: var(--brand-deep);
	}

	.subheadline {
		margin: 0;
		font-size: clamp(1rem, 1.9vw, 1.2rem);
		line-height: 1.75;
		max-width: 60ch;
		color: var(--ink-soft);
	}

	.subheadline + .subheadline {
		margin-top: 0.85rem;
	}

	.price-pill {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.55rem 0.85rem;
		margin-top: 1.35rem;
		padding: 0.85rem 1.1rem;
		max-width: 36rem;
		border-radius: 0.85rem;
		background: var(--brand-tint);
		border: 1px solid rgb(0 94 71 / 14%);
	}

	.price-pill-amount {
		font-family: var(--font-serif);
		font-size: 1.75rem;
		font-weight: 500;
		color: var(--brand-deep);
		line-height: 1;
	}

	.price-pill-meta {
		font-size: 0.95rem;
		line-height: 1.45;
		color: var(--ink-soft);
	}

	.cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.6rem;
	}

	.trust-strip {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.2rem;
		margin: 1.6rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.85rem;
		opacity: 0.85;
	}

	.hero-media {
		margin: 0;
	}

	.hero-media img {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: 50% 30%;
		border-radius: 1rem;
		box-shadow: 0 14px 35px rgb(29 35 39 / 14%);
	}

	/* ---------- STORY ZIGZAG ---------- */
	.sr-story {
		scroll-margin-top: 5.5rem;
		padding-block: clamp(2.5rem, 6vh, 4.5rem) clamp(3.5rem, 8vh, 5.5rem);
	}

	.sr-head {
		max-width: 40rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}

	h2 {
		margin: 0.6rem 0 0;
		font-family: var(--font-serif);
		font-size: clamp(1.7rem, 3.3vw, 2.4rem);
		font-weight: 500;
		text-wrap: balance;
		color: var(--brand-deep);
	}

	h3 {
		margin: 0.45rem 0 1rem;
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 2.4vw, 1.75rem);
		font-weight: 500;
		line-height: 1.25;
		color: var(--brand-deep);
		text-wrap: balance;
	}

	.sr-zigzag {
		display: grid;
		gap: clamp(2.5rem, 6vw, 4.5rem);
	}

	.sr-row {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(1.6rem, 4vw, 3.5rem);
		align-items: center;
	}

	.sr-row-reverse {
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
	}

	.sr-row-reverse .sr-media {
		order: 2;
	}

	.sr-row-reverse .sr-copy {
		order: 1;
	}

	.sr-media {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.sr-media img,
	.sr-media :global(img) {
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 1rem;
		box-shadow: 0 18px 36px rgb(0 94 71 / 14%);
	}

	.sr-media figcaption {
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 0.95rem;
		line-height: 1.45;
		color: var(--color-dark-slate-gray);
		text-align: center;
		text-wrap: balance;
	}

	.sr-copy {
		max-width: 60ch;
	}

	.sr-copy p {
		margin: 0 0 1rem;
		font-size: 1rem;
		line-height: 1.8;
		color: var(--ink-soft);
	}

	.sr-lede {
		font-family: var(--font-serif);
		font-size: clamp(1.15rem, 2vw, 1.35rem);
		font-weight: 500;
		color: var(--brand-deep) !important;
	}

	.sr-pull {
		margin: 1.2rem 0 !important;
		padding: 1.1rem 1.3rem;
		border-left: 3px solid var(--brand);
		background: rgb(0 94 71 / 6%);
		border-radius: 0 0.6rem 0.6rem 0;
		font-family: var(--font-serif);
		font-style: italic;
		font-size: 1.15rem !important;
		color: var(--brand-deep) !important;
	}

	.sr-emphasis {
		font-weight: 500;
		color: var(--color-dark-gray) !important;
	}

	.sr-list {
		margin: 0 0 1.15rem;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.85rem;
	}

	.sr-list li {
		position: relative;
		padding-left: 2.2rem;
		line-height: 1.65;
		color: var(--ink-soft);
	}

	.sr-list li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.12rem;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 0.38rem;
		background: var(--color-white);
		border: 1.5px solid var(--brand);
		box-shadow: 0 1px 2px rgb(0 94 71 / 10%);
	}

	.sr-list li::after {
		content: "✓";
		position: absolute;
		left: 0.28rem;
		top: 0.12rem;
		color: var(--brand);
		font-weight: 700;
		font-size: 0.95rem;
		line-height: 1.4rem;
	}

	/* ---------- INVESTMENT ---------- */
	.sr-invest {
		padding-block: clamp(3rem, 7vh, 5rem);
	}

	.sr-invest-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(1.8rem, 4vw, 3.5rem);
		align-items: center;
	}

	.sr-invest-media {
		margin: 0;
	}

	.sr-invest-media :global(img) {
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 1rem;
		box-shadow: 0 18px 36px rgb(0 94 71 / 14%);
	}

	.sr-invest-copy p {
		margin: 0.85rem 0 0;
		max-width: 52ch;
		line-height: 1.8;
		color: var(--ink-soft);
	}

	.sr-note {
		margin-top: 1.6rem !important;
		padding: 1.1rem 1.2rem;
		border-radius: 0.75rem;
		border: 1px solid rgb(0 94 71 / 16%);
		background: var(--color-white);
		font-size: 0.92rem !important;
		line-height: 1.65 !important;
	}

	.sr-note strong {
		color: var(--brand-deep);
	}

	/* ---------- FINAL CTA ---------- */
	.sr-final {
		background:
			radial-gradient(ellipse at 50% 0%, rgb(0 94 71 / 10%), transparent 65%),
			linear-gradient(180deg, var(--color-white) 0%, var(--brand-tint) 100%);
		text-align: center;
	}

	.sr-final-inner {
		max-width: 64ch;
	}

	.sr-final-inner h2 {
		text-wrap: balance;
	}

	.sr-final-inner > p {
		margin: 1rem auto 0;
		line-height: 1.85;
		color: var(--ink-soft);
	}

	.sr-final-actions {
		justify-content: center;
	}

	/* ---------- RESPONSIVE ---------- */
	@media (max-width: 900px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}

		.hero-media {
			max-width: 420px;
			margin-inline: auto;
			order: -1;
		}

		.sr-row,
		.sr-row-reverse,
		.sr-invest-grid {
			grid-template-columns: 1fr;
		}

		.sr-row-reverse .sr-media,
		.sr-row-reverse .sr-copy {
			order: unset;
		}

		.sr-media {
			max-width: 420px;
			margin-inline: auto;
			width: 100%;
		}

		.sr-invest-media {
			max-width: 360px;
			margin-inline: auto;
		}
	}
</style>
